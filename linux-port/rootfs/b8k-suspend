#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# One system sleep (s2idle). b8k-sleep.py runs this when the screen has
# been off for a while. The power key wakes the tablet: its PMIC IRQ is a
# wake source (wakeup-source in mt6320.dtsi). wlan_mt6628 does not survive
# a sleep, so the Wi-Fi drivers leave before it and come back after.
set -u
exec 9>/run/b8k-suspend.lock
flock -n 9 || exit 0

# The Wi-Fi drivers go under the same lock as 00-b8k-modules.start: a
# reload by b8k-netwatch running at the same time hung modprobe. If the
# lock stays held (a reload hangs), no sleep this time.
exec 8>/run/b8k-wlan.lock
if ! timeout 30 flock 8; then
	logger -t b8k-suspend "Wi-Fi busy, not sleeping"
	exit 0
fi
logger -t b8k-suspend "sleep"
timeout 30 rmmod wlan_mt6628 2>/dev/null
timeout 30 rmmod wmt 2>/dev/null
exec 8>&-	# the reload after the wake takes the lock itself
sync
echo freeze > /sys/power/state
logger -t b8k-suspend "awake ($?)"
# The panel shows the Wi-Fi gone at once; NetworkManager's dispatcher
# signals it again when the network is back.
/usr/bin/haltia-panel-signal 10 &
sh /etc/local.d/00-b8k-modules.start >/dev/null 2>&1 &
