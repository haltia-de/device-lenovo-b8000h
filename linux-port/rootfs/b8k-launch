#!/bin/sh
# A tap focuses that program's window, or starts one copy.
# A program that is not open yet shows a blank loading screen until its window appears.
# status only reads the file the window watcher already wrote.
# It always prints the same label, so a button cannot disappear.
set -u
# Per-user runtime files. /tmp is shared, so another user could plant
# the web-app request or point a log at one of our files.
run=${XDG_RUNTIME_DIR:-$HOME/.cache}
dir="$run/b8k-launch"
mkdir -p "$dir"

# Every program and its fields live in apps.conf: the copy b8k-apps writes
# for this session (one's own programs and the panel included), else the
# built-in one.
APPS=/usr/local/share/b8k/apps.conf
[ -f "$run/b8k/apps.conf" ] && APPS="$run/b8k/apps.conf"

# field ID KEY prints that key of the program, or fails when it has none.
field() {
	awk -v id="$1" -v key="$2" '
		/^[ \t]*[#;]/ { next }
		/^[ \t]*\[/ { sec = $0; gsub(/[][ \t]/, "", sec); next }
		sec == id {
			k = $0
			sub(/[ \t]*=.*/, "", k)
			gsub(/^[ \t]+/, "", k)
			if (k == key) {
				v = $0
				sub(/^[^=]*=[ \t]*/, "", v)
				sub(/[ \t]+$/, "", v)
				if (v != "") { print v; found = 1 }
				exit
			}
		}
		END { exit !found }' "$APPS"
}

# alive NAME: a live process of that name. pidof also lists zombies, and
# programs the panel started become zombies when they exit, because waybar
# does not reap them; a zombie Firefox kept web apps from starting it again.
alive() {
	for pid in $(pidof "$1" 2>/dev/null); do
		state=$(awk '/^State:/ { print $2; exit }' /proc/"$pid"/status 2>/dev/null || true)
		[ -n "$state" ] && [ "$state" != Z ] && return 0
	done
	return 1
}

# slot_id N: the Nth open program without a pinned button (signal 0): the
# one in front first, so it always has a slot, then the rest in apps.conf
# order. The panel shows these in its slots under the pinned ones.
slot_id() {
	[ -f "$dir/state" ] || return 1
	awk -v n="$1" '
		FNR == NR {
			if ($0 ~ /^[ \t]*\[/) { sec = $0; gsub(/[][ \t]/, "", sec); ids[++k] = sec; sig[sec] = 0; next }
			if ($0 ~ /^[ \t]*signal[ \t]*=/) { v = $0; sub(/^[^=]*=[ \t]*/, "", v); sig[sec] = v + 0 }
			next
		}
		$2 == "running" || $2 == "active" { open[$1] = 1 }
		$2 == "active" { front = $1 }
		END {
			if (front != "" && sig[front] == 0 && ++m == n) { print front; exit 0 }
			for (i = 1; i <= k; i++)
				if (open[ids[i]] && ids[i] != front && sig[ids[i]] == 0 && ++m == n) {
					print ids[i]; exit 0
				}
			exit 1
		}' "$APPS" "$dir/state"
}

label_of() { field "$1" label; }
# A web app opens the site in its own Firefox window, without tabs or an address bar.
url_of() { field "$1" url; }
bin_of() { field "$1" exec; }
aliases_of() { field "$1" app_ids; }

# Firefox reads these from the profile, so they must be there before the
# first start: otherwise the large buttons only came with the second one.
install_firefox_chrome() {
	home=${HOME:-/home/user}
	# The profiles: b8k-firefox's large toolbar and prefs, with room for
	# the close button in the corner (--shell).
	if command -v b8k-firefox-profile >/dev/null; then
		b8k-firefox-profile --shell || true
	fi
	root=$home/.config/mozilla/firefox
	# Firefox passes over a profile it did not make itself and makes its own
	# default-release, unless it keeps to the profiles.ini default. Only for
	# the profile made here: an older one stays as Firefox chose it.
	if [ -f "$root/profiles.ini" ] && ! grep -q '^\[Install' "$root/profiles.ini"; then
		export MOZ_LEGACY_PROFILES=1
	fi
}

# An old shell id a program with a .desktop file took over (b8k-apps writes
# "old new" lines: X-B8K-Replaces), so the clock, the home screen and
# anyone's own settings still reach it by the old id.
if [ -n "${2:-}" ] && [ -f "$run/b8k/aliases" ]; then
	new=$(awk -v id="$2" '$1 == id { print $2; exit }' "$run/b8k/aliases")
	if [ -n "$new" ]; then
		cmd=$1
		shift 2
		set -- "$cmd" "$new" "$@"
	fi
fi

case ${1:-} in
status)
	id=${2:-}
	label=$(label_of "$id" || true)
	[ -n "$label" ] || label="$id"
	[ -n "$label" ] || label="*"
	class=idle
	if [ -f "$dir/state" ]; then
		found=$(awk -v id="$id" '$1 == id { print $2; exit }' "$dir/state" 2>/dev/null || true)
		case $found in
			active|running) class=$found ;;
		esac
	fi
	# b8k-press marks a tap for 300 ms; waybar ignores :active on touch.
	[ -e "$run/b8k-press/$id" ] && class=pressed
	# An unread count from the program itself (b8k-max writes one).
	badge=
	[ -f "$run/b8k-badge/$id" ] && read -r badge <"$run/b8k-badge/$id" 2>/dev/null
	case $badge in
		''|0|*[!0-9]*) ;;
		*) label="$label <span background='#e01b24' foreground='#ffffff' weight='bold'> $badge </span>" ;;
	esac
	printf '{"text":"%s","class":["app","%s"]}\n' "$label" "$class"
	exit 0
	;;
slot)
	# A slot shows the open program it holds, or nothing (waybar hides an
	# empty module).
	n=${2:-0}
	id=$(slot_id "$n" || true)
	if [ -z "$id" ]; then
		printf '{"text":""}\n'
		exit 0
	fi
	label=$(label_of "$id" || true)
	[ -n "$label" ] || label="$id"
	class=$(awk -v id="$id" '$1 == id { print $2; exit }' "$dir/state" 2>/dev/null || true)
	[ -e "$run/b8k-press/slot$n" ] && class=pressed
	cls=id-$(printf '%s' "$id" | tr -c 'A-Za-z0-9_-' '-')
	printf '{"text":"%s","class":["app","slot","%s","%s"]}\n' "$label" "${class:-running}" "$cls"
	exit 0
	;;
sep)
	# The line between the pinned buttons and the slots: there while slot 1
	# holds a program.
	if slot_id 1 >/dev/null; then
		printf '{"text":" ","class":"sep"}\n'
	else
		printf '{"text":""}\n'
	fi
	exit 0
	;;
tap-slot)
	id=$(slot_id "${2:-0}" || true)
	[ -n "$id" ] || exit 0
	exec "$0" tap "$id"
	;;
start)
	id=${2:-}
	if ! url_of "$id" >/dev/null 2>&1; then
		aliases_of "$id" >/dev/null || exit 1
	fi
	setsid "$0" open "$id" </dev/null >"$run"/b8k-launch-"$id".log 2>&1 &
	exit 0
	;;
tap)
	# The front program asks before it closes. Any other tap still switches or starts.
	id=${2:-}
	# Over the home screen a tap means "go to it": lower the home screen,
	# never ask to close.
	if [ -e "$run/b8k-home.raised" ]; then
		/usr/local/bin/b8k-home hide
		exec "$0" start "$id"
	fi
	if url_of "$id" >/dev/null 2>&1; then
		if /usr/local/bin/b8k-focus front-webapp "$id" >/dev/null 2>&1; then
			setsid /usr/local/bin/b8k-ask close-webapp "$id" </dev/null >"$run"/b8k-ask.log 2>&1 &
			exit 0
		fi
		setsid "$0" open "$id" </dev/null >"$run"/b8k-launch-"$id".log 2>&1 &
		exit 0
	fi
	aliases_of "$id" >/dev/null || exit 1
	class=idle
	if [ -f "$dir/state" ]; then
		found=$(awk -v id="$id" '$1 == id { print $2; exit }' "$dir/state" 2>/dev/null || true)
		case $found in
			active|running) class=$found ;;
		esac
	fi
	# The program in front stays: closing is the "✕" in the corner
	# (b8k-close) for every program alike.
	[ "$class" = active ] && exit 0
	exec "$0" start "$id"
	;;
url)
	# A link from a program (news: "open in the browser"). Firefox can take
	# 20 s to start cold, so the splash shows meanwhile, taps while it
	# starts are ignored, and the same link again within 15 s only raises
	# Firefox: repeated taps used to open the same page in several tabs.
	url=${2:-}
	case $url in
		https://* | http://*) ;;
		*) exit 2 ;;
	esac
	exec 9>"$dir/url.lock"
	if ! flock -n 9; then
		exit 0
	fi
	names=$(aliases_of firefox)
	last="$dir/last-url"
	if [ -f "$last" ] && [ "$(cat "$last")" = "$url" ] &&
		[ $(($(date +%s) - $(stat -c %Y "$last"))) -lt 15 ]; then
		/usr/local/bin/b8k-focus activate $names >/dev/null 2>&1
		exit 0
	fi
	printf '%s\n' "$url" >"$last"
	if alive firefox; then
		firefox "$url" >"$run"/b8k-app-firefox.log 2>&1 9>&- &
		i=0
		while [ "$i" -lt 10 ]; do
			sleep 0.5
			/usr/local/bin/b8k-focus activate $names >/dev/null 2>&1 && exit 0
			i=$((i + 1))
		done
		exit 0
	fi
	install_firefox_chrome
	splash_pid=
	if [ -x /usr/local/bin/b8k-splash ]; then
		/usr/local/bin/b8k-splash firefox >"$run"/b8k-splash.log 2>&1 9>&- &
		splash_pid=$!
	fi
	trap '[ -n "$splash_pid" ] && kill "$splash_pid" 2>/dev/null' EXIT
	firefox "$url" >"$run"/b8k-app-firefox.log 2>&1 9>&- &
	i=0
	while [ "$i" -lt 80 ]; do
		if /usr/local/bin/b8k-focus has $names >/dev/null 2>&1; then
			exit 0
		fi
		i=$((i + 1))
		sleep 0.5
	done
	exit 0
	;;
open)
	id=${2:-}
	exec 9>"$dir/$id.lock"
	if ! flock -n 9; then
		exit 0
	fi
	url=$(url_of "$id" 2>/dev/null || true)
	if [ -n "$url" ]; then
		names=$(aliases_of firefox)
		splash_pid=
		stop_splash() {
			if [ -n "$splash_pid" ]; then
				kill "$splash_pid" 2>/dev/null || true
				splash_pid=
			fi
		}
		trap stop_splash EXIT
		if /usr/local/bin/b8k-focus raise-webapp "$id" >/dev/null 2>&1; then
			exit 0
		fi
		mkdir -p "$run"/b8k-webapp.d
		printf '%s\n' "$url" > "$run"/b8k-webapp.d/"$id"
		if ! /usr/local/bin/b8k-focus has $names >/dev/null 2>&1; then
			if [ -x /usr/local/bin/b8k-splash ]; then
				/usr/local/bin/b8k-splash "$id" >"$run"/b8k-splash.log 2>&1 9>&- &
				splash_pid=$!
			fi
		fi
		if ! alive firefox; then
			firefox >"$run"/b8k-app-"$id".log 2>&1 9>&- &
		fi
		i=0
		while [ "$i" -lt 40 ]; do
			if /usr/local/bin/b8k-focus raise-webapp "$id" >/dev/null 2>&1; then
				exit 0
			fi
			i=$((i + 1))
			sleep 0.5
		done
		exit 0
	fi
	names=$(aliases_of "$id") || exit 0
	if /usr/local/bin/b8k-focus activate $names >/dev/null 2>&1; then
		exit 0
	fi
	bin=$(bin_of "$id") || exit 0
	if [ "$id" = firefox ]; then
		install_firefox_chrome
	fi
	# The app must not inherit the lock fd. While it holds that fd,
	# every later tap fails the lock and the window never switches.
	splash_pid=
	stop_splash() {
		if [ -n "$splash_pid" ]; then
			kill "$splash_pid" 2>/dev/null || true
			splash_pid=
		fi
		# No longer starting: the close button (b8k-close) looks again.
		rm -f "$dir/starting"
		/usr/local/bin/b8k-close update 2>/dev/null || true
	}
	trap stop_splash EXIT
	if [ -x /usr/local/bin/b8k-splash ]; then
		/usr/local/bin/b8k-splash "$id" >"$run"/b8k-splash.log 2>&1 9>&- &
		splash_pid=$!
	fi
	env=$(field "$id" env || true)
	if [ -n "$env" ]; then
		export "$env"
	fi
	# exec may carry arguments; apps.conf has no quoting, so plain splitting.
	# shellcheck disable=SC2086
	$bin >"$run"/b8k-app-"$id".log 2>&1 9>&- &
	# While it starts, the close button stops it (b8k-ask close-front kills
	# the pid and the curtain, and removes this file) and the home button
	# takes the curtain away (b8k-home).
	echo "$id $! ${splash_pid:-0}" >"$dir/starting"
	/usr/local/bin/b8k-close update 2>/dev/null || true
	i=0
	while [ "$i" -lt 40 ] && [ -e "$dir/starting" ]; do
		if /usr/local/bin/b8k-focus has $names >/dev/null 2>&1; then
			exit 0
		fi
		i=$((i + 1))
		sleep 0.5
	done
	;;
*)
	ids=$(awk '/^[ \t]*\[/ { s = $0; gsub(/[][ \t]/, "", s); printf "%s%s", sep, s; sep = "|" }' "$APPS")
	echo "usage: b8k-launch status|start|tap <$ids> | b8k-launch url <link>" >&2
	exit 2
	;;
esac
