    def load_large(self, item):
        try:
            url, licence = image_info([item["file"]], LARGE)[item["file"]]
            data = fetch_image(url)
            pb = pixbuf_of(data, 640, 520)
        except Exception as exc:
            sys.stderr.write("b8k-paint: %s: %s\n" % (item["file"], exc))
            data = pb = licence = None
        GLib.idle_add(self.preview_loaded, item, data, pb, licence)

    def preview_loaded(self, item, data, pb, licence):
        if data is None:
            item["failed"] = True
        else:
            item.update(data=data, large=pb, licence=licence)
        if item is self.preview_item:
            if data is not None:
                self.convert_grades(item)
            self.choose_grade(self.grade)
        return False

    def convert_grades(self, item):
        """Make the pictures of every cell size, the chosen one first, in
        the background; each shows as it is ready."""
        todo = [g for g in [self.grade] + list(GRADES) if g[0] not in item["pics"]]
        if not todo or item.get("converting"):
            return
        item["converting"] = True

        def work():
            for level, _name, cols, colours in dict.fromkeys(todo):
                try:
                    pic = painting_to_picture(item["data"], cols, colours)
                except Exception as exc:
                    sys.stderr.write("b8k-paint: %s: %s\n" % (item["file"], exc))
                    pic = None
                GLib.idle_add(self.grade_ready, item, level, pic)
            item["converting"] = False

        threading.Thread(target=work, daemon=True).start()

    def grade_ready(self, item, level, pic):
        if pic:
            pal = [pixel(hex_rgb(c)) for c in pic["palette"]]
            cells = cells_of(pic)
            pic["image"] = surface(pic, lambda x, y: pal[cells[y][x]])[0]
        item["pics"][level] = pic
        if item is self.preview_item and level == self.grade[0]:
            self.choose_grade(self.grade)
        return False

    def draw_preview(self, widget, cr):
        item = self.preview_item
        w, h = widget.get_allocated_width(), widget.get_allocated_height()
        pic = item["pics"].get(self.grade[0]) if item else None
        if pic and not self.show_original:
            cell = min(w / pic["w"], h / pic["h"])
            cr.translate((w - cell * pic["w"]) / 2, (h - cell * pic["h"]) / 2)
            paint_scaled(cr, pic["image"], cell)
            return False
        pb = item.get("large") or item.get("small") if item else None
        if pb:
            scale = min(w / pb.get_width(), h / pb.get_height())
            cr.translate((w - pb.get_width() * scale) / 2, (h - pb.get_height() * scale) / 2)
            cr.scale(scale, scale)
            Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
            cr.paint()
        return False

    def flip_preview(self):
        if self.preview_item and self.grade[0] in self.preview_item["pics"]:
            self.buzz()
            self.show_original = not self.show_original
            self.choose_grade(self.grade)
        return False

    def choose_grade(self, grade):
        self.grade = grade
        item = self.preview_item
        for b, g in self.grade_buttons:
            (b.get_style_context().add_class if g == grade
             else b.get_style_context().remove_class)("on")
        if grade[0] not in item["pics"]:
            self.show_original = False
        pic = item["pics"].get(grade[0])
        have = os.path.exists(downloaded_path(item["qid"], grade[0]))
        if item.get("licence"):
            free = item["licence"].lower() in ("public domain", "cc0", "pd")
            self.licence_label.set_text("Общественное достояние" if free
                                        else "Лицензия: " + item["licence"])
        if item.get("failed"):
            self.view_note.set_text("Не удалось загрузить картину")
        elif "data" not in item:
            self.view_note.set_text("Загружаю картину…")
        elif grade[0] not in item["pics"]:
            self.view_note.set_text("Готовлю раскраску…")
        elif pic is None:
            self.view_note.set_text("Не получилось сделать раскраску")
        elif self.show_original:
            self.view_note.set_text("Картина. Нажмите, чтобы увидеть раскраску")
        else:
            self.view_note.set_text("Так будет в раскраске. Нажмите, чтобы увидеть картину")
        if have:
            self.preview_note.set_text("Уже в раскрасках")
        elif pic:
            self.preview_note.set_text("%d × %d клеток, %d цветов"
                                       % (pic["w"], pic["h"], len(pic["palette"])))
        else:
            self.preview_note.set_text("")
        self.get_button.set_label("Раскрашивать" if have else "Загрузить")
        self.get_button.set_sensitive(bool(have or pic))
        self.view.queue_draw()

    def get_picture(self):
        item, level = self.preview_item, self.grade[0]
        pic_id = "wd-%s-%d" % (item["qid"], level)
        path = downloaded_path(item["qid"], level)
        if not os.path.exists(path):
            pic = {k: v for k, v in item["pics"][level].items() if k in ("w", "h", "palette", "rows")}
            pic.update(name=item["title"], theme=item["author"], level=8, grade=level,
                       source=item["file"], wikidata=item["qid"])
            try:
                os.makedirs(DOWNLOADED, exist_ok=True)
                with open(path + ".new", "w") as fh:
                    json.dump(pic, fh, ensure_ascii=False)
                os.replace(path + ".new", path)
            except OSError as exc:
                sys.stderr.write("b8k-paint: %s: %s\n" % (path, exc))
                self.preview_note.set_text("Не удалось сохранить")
                return
            self.choose_grade(self.grade)
            self.preview_note.set_text("Готово, картина в раскрасках")
            item["info"].set_text("✓ уже в раскрасках")
            return
        pic = next((p for p in load_pictures() if p["id"] == pic_id), None)
        if pic:
            self.open(pic)

