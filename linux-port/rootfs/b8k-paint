    def find(self):
        """Centre the view on the nearest unpainted cell of the chosen colour,
        zoomed in far enough to read the numbers."""
        h, v = self.scroll.get_hadjustment(), self.scroll.get_vadjustment()
        s = self.board.cell
        cx = (h.get_value() + h.get_page_size() / 2) / s
        cy = (v.get_value() + v.get_page_size() / 2) / s
        where = self.board.nearest(cx, cy)
        if not where or not self.view_size:
            return
        x, y = where
        self.forget_whole()
        steps = self.steps()
        index = max(self.zoom or 0,
                    next((i for i, z in enumerate(steps) if z >= OPEN_CELL), len(steps) - 1))
        self.set_zoom(index, ((x + 0.5) / self.board.pic["w"], (y + 0.5) / self.board.pic["h"]))

    def on_view_size(self, _widget, alloc):
        size = (alloc.width, alloc.height)
        if size == self.view_size or alloc.width < 50:
            return
        self.view_size = size
        GLib.idle_add(self.set_zoom, self.zoom)

    def steps(self):
        """Cell sizes: the whole picture in view, then the fixed ones above."""
        w, h = self.view_size
        whole = max(2.0, min((w - 4) / self.board.pic["w"], (h - 4) / self.board.pic["h"]))
        return [whole] + [z for z in ZOOMS if z > whole * 1.15]

    def set_zoom(self, index, focus=None):
        if not self.board or not self.view_size:
            return False
        steps = self.steps()
        if index is None:
            index = next((i for i, z in enumerate(steps) if z >= OPEN_CELL), len(steps) - 1)
        index = max(0, min(index, len(steps) - 1))
        # Keep the middle of the view on the same spot of the picture.
        h, v = self.scroll.get_hadjustment(), self.scroll.get_vadjustment()
        if focus:
            fx, fy = focus
        else:
            fx = (h.get_value() + h.get_page_size() / 2) / max(1, h.get_upper())
            fy = (v.get_value() + v.get_page_size() / 2) / max(1, v.get_upper())
        self.zoom = index
        self.board.set_cell(steps[index])

        def recentre():
            for adj, f in ((h, fx), (v, fy)):
                adj.set_value(f * adj.get_upper() - adj.get_page_size() / 2)
            return False

        GLib.timeout_add(60, recentre)
        return False

    def zoom_in(self):
        if self.zoom is not None:
            self.forget_whole()
            self.set_zoom(self.zoom + 1)

    def zoom_out(self):
        if self.zoom is not None and self.zoom > 0:
            self.forget_whole()
            self.set_zoom(self.zoom - 1)

    def whole(self):
        """Fit the picture to the screen; a second tap goes back."""
        if self.zoom is None:
            return
        if self.whole_back:
            index, focus = self.whole_back
            self.forget_whole()
            self.set_zoom(index, focus)
            return
        if self.zoom == 0:
            return
        h, v = self.scroll.get_hadjustment(), self.scroll.get_vadjustment()
        focus = ((h.get_value() + h.get_page_size() / 2) / max(1, h.get_upper()),
                 (v.get_value() + v.get_page_size() / 2) / max(1, v.get_upper()))
        self.whole_back = (self.zoom, focus)
        self.whole_button.get_style_context().add_class("on")
        self.set_zoom(0)

    def forget_whole(self):
        self.whole_back = None
        self.whole_button.get_style_context().remove_class("on")

    def choose(self, number):
        self.board.set_chosen(number)
        self.refresh_swatches()

    def refresh_swatches(self):
        for n, (b, left, fg) in enumerate(self.swatches):
            count = self.board.left(n)
            left.set_markup('<span foreground="%s">%s</span>' % (fg, "✓" if count == 0 else str(count)))
            ctx = b.get_style_context()
            (ctx.add_class if n == self.board.chosen else ctx.remove_class)("chosen")
            (ctx.add_class if count == 0 else ctx.remove_class)("done")

    def cell_painted(self, number):
        if self.board.left(number) == 0:
            nxt = next((n for n in range(len(self.board.pic["palette"]))
                        if self.board.left(n)), None)
            if nxt is None:
                self.refresh_swatches()
                self.finished()
                return
            if number == self.board.chosen:
                self.choose(nxt)
                return
        self.refresh_swatches()

    def preview(self, on):
        # While "look" is held, the board shows the finished picture.
        if self.board:
            self.board.set_preview(on)

    def finished(self):
        self.save()
        dialog = Gtk.MessageDialog(transient_for=self.win, modal=True,
                                   message_type=Gtk.MessageType.INFO,
                                   buttons=Gtk.ButtonsType.OK, text="Готово!")
        dialog.format_secondary_text("Картинка раскрашена.")
        dialog.run()
        dialog.destroy()
        self.back()

    def back(self):
        if self.stack.get_visible_child_name() == "preview":
            self.show_search()
            return
        self.save()
        self.board = None
        self.show_gallery()

    def save(self):
        if self.board:
            self.board.save_now()

    def quit(self, *_args):
        self.save()
        Gtk.main_quit()
        return False


def main():
    run = os.environ.get("XDG_RUNTIME_DIR") or os.path.expanduser("~/.cache")
    lock = open(os.path.join(run, "b8k-paint.lock"), "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    os.makedirs(PHOTOS, exist_ok=True)
    # --open ID goes straight to one picture (for testing).
    open_id = sys.argv[2] if sys.argv[1:2] == ["--open"] and len(sys.argv) > 2 else None
    Paint(open_id)
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
