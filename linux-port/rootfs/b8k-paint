# --- haptics ----------------------------------------------------------------
class Buzz:
    """A short pulse on the regulator-haptic motor, set up once."""

    EVIOCSFF = 0x40000000 | (0x2C << 16) | (ord("E") << 8) | 0x80

    def __init__(self, ms=70):
        self.fd = -1
        self.effect = -1
        try:
            for node in sorted(os.listdir("/sys/class/input")):
                if not node.startswith("event"):
                    continue
                with open("/sys/class/input/%s/device/name" % node) as fh:
                    if fh.read().strip() != "regulator-haptic":
                        continue
                self.fd = os.open("/dev/input/" + node, os.O_RDWR | os.O_CLOEXEC)
                # struct ff_effect, 32-bit: type, id, direction, trigger,
                # replay, then the rumble magnitudes and padding.
                buf = bytearray(struct.pack("<HhHHHHHHH", 0x50, -1, 0, 0, 0, ms, 0,
                                            0xFFFF, 0xFFFF) + bytes(32))
                fcntl.ioctl(self.fd, self.EVIOCSFF, buf)
                self.effect = struct.unpack_from("<h", buf, 2)[0]
                break
        except OSError:
            self.fd = -1

    def __call__(self):
        if self.fd >= 0:
            try:
                os.write(self.fd, struct.pack("<llHHi", 0, 0, 0x15, self.effect, 1))
            except OSError:
                pass


# --- pictures -----------------------------------------------------------------
def photo_to_picture(path):
    """Turn a photo into a grid picture; None when Pillow cannot read it."""
    try:
        from PIL import Image, ImageFilter, ImageOps
    except ImportError:
        return None
    try:
        img = ImageOps.exif_transpose(Image.open(path)).convert("RGB")
    except OSError:
        return None
    w, h = img.size
    if w >= h:
        cols, rows = 64, max(8, round(64 * h / w))
    else:
        rows, cols = 64, max(8, round(64 * w / h))
    small = img.filter(ImageFilter.MedianFilter(3)).resize((cols, rows), Image.LANCZOS)
    pal_img = small.quantize(colors=16, method=Image.Quantize.MEDIANCUT,
                             dither=Image.Dither.NONE)
    raw = pal_img.getpalette()[:48]
    used = sorted(set(pal_img.getdata()))
    colours = [tuple(raw[i * 3:i * 3 + 3]) for i in used]
    # Light to dark, so number 1 is the lightest colour.
    order = sorted(range(len(used)),
                   key=lambda i: -(0.299 * colours[i][0] + 0.587 * colours[i][1]
                                   + 0.114 * colours[i][2]))
    remap = {used[i]: n for n, i in enumerate(order)}
    palette = ["#%02x%02x%02x" % colours[i] for i in order]
    data = list(pal_img.getdata())
    grid = ["".join(DIGITS[remap[data[y * cols + x]]] for x in range(cols))
            for y in range(rows)]
    name = os.path.splitext(os.path.basename(path))[0]
    return {"name": name, "level": 9, "w": cols, "h": rows, "palette": palette, "rows": grid}


def merge_close(rgb, limit):
    """Indices to keep so that no two kept colours are closer than limit."""
    keep = []
    for i, c in enumerate(rgb):
        if all(sum((c[k] - rgb[j][k]) ** 2 for k in range(3)) >= limit ** 2 for j in keep):
            keep.append(i)
    return keep


def painting_to_picture(data, cols_long, colours):
    """A painting (image bytes) as a grid picture, the way
    paint/make-paintings.py makes the built-in ones; the nearest-colour
    pass runs in Pillow, as Python took many seconds here."""
    from PIL import Image, ImageEnhance, ImageFilter, ImageOps
    img = ImageOps.exif_transpose(Image.open(io.BytesIO(data))).convert("RGB")
    # Old varnish makes paintings brown and dull; brighter, more saturated
    # colours are easier to tell apart on the palette.
    img = ImageOps.autocontrast(img, cutoff=1)
    img = ImageEnhance.Color(img).enhance(1.6)
    img = ImageEnhance.Contrast(img).enhance(1.15)
    w, h = img.size
    if w >= h:
        cols, rows = cols_long, max(8, round(cols_long * h / w))
    else:
        rows, cols = cols_long, max(8, round(cols_long * w / h))
    small = img.filter(ImageFilter.MedianFilter(3)).resize((cols, rows), Image.LANCZOS)
    q = small.quantize(colors=colours + 4, method=Image.Quantize.MEDIANCUT,
                       dither=Image.Dither.NONE)
    raw = q.getpalette()
    counts = {}
    for v in q.getdata():
        counts[v] = counts.get(v, 0) + 1
    # Most used first, then drop colours too close to one already kept.
    used = sorted(counts, key=lambda v: -counts[v])
    rgb = [tuple(raw[i * 3:i * 3 + 3]) for i in used]
    keep = [rgb[i] for i in merge_close(rgb, 36)][:colours]
    # Each cell to the nearest kept colour; the palette is filled up to 256
    # entries with repeats, which map back with % len(keep).
    pal = Image.new("P", (1, 1))
    pal.putpalette([v for i in range(256) for v in keep[i % len(keep)]])
    flat = [v % len(keep) for v in small.quantize(palette=pal, dither=Image.Dither.NONE).getdata()]
    grid = [flat[y * cols:(y + 1) * cols] for y in range(rows)]
    # A lone cell surrounded by one other colour is noise; join it.
    for y in range(rows):
        for x in range(cols):
            near = [grid[ny][nx] for nx, ny in ((x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1))
                    if 0 <= nx < cols and 0 <= ny < rows]
            if grid[y][x] not in near and len(set(near)) == 1:
                grid[y][x] = near[0]
    present = sorted({v for row in grid for v in row})
    order = sorted(present, key=lambda i: -(0.299 * keep[i][0] + 0.587 * keep[i][1]
                                            + 0.114 * keep[i][2]))
    remap = {old: n for n, old in enumerate(order)}
    return {"w": cols, "h": rows,
            "palette": ["#%02x%02x%02x" % keep[i] for i in order],
            "rows": ["".join(DIGITS[remap[v]] for v in row) for row in grid]}


def api(url, params):
    params = dict(params, format="json", formatversion="2")
    req = urllib.request.Request(url + "?" + urllib.parse.urlencode(params),
                                 headers={"User-Agent": AGENT})
    with urllib.request.urlopen(req, timeout=20) as fh:
        return json.loads(fh.read(4_000_000))


def fetch_image(url):
    """Image bytes, only over https from the Wikimedia image hosts."""
    def allowed(u):
        parts = urllib.parse.urlsplit(u)
        return parts.scheme == "https" and parts.hostname in IMAGE_HOSTS
    if not allowed(url):
        raise ValueError("not a Wikimedia image: %r" % url)
    req = urllib.request.Request(url, headers={"User-Agent": AGENT})
    with urllib.request.urlopen(req, timeout=30) as fh:
        if not allowed(fh.geturl()):
            raise ValueError("redirected away: %r" % fh.geturl())
        return fh.read(8_000_000)


def label_of(entity):
    labels = entity.get("labels", {})
    for lang in ("ru", "en"):
        if lang in labels:
            return labels[lang]["value"]
    return ""


def claim(entity, prop):
    """The first value of a statement, or None."""
    for st in entity.get("claims", {}).get(prop, []):
        snak = st.get("mainsnak", {})
        if snak.get("snaktype") == "value":
            return snak.get("datavalue", {}).get("value")
    return None


def image_info(files, width):
    """{Commons file name: (thumbnail url, licence)} at that width."""
    if not files:
        return {}
    data = api(COMMONS, {"action": "query", "prop": "imageinfo", "iiprop": "url|extmetadata",
                         "iiurlwidth": width, "iiextmetadatafilter": "LicenseShortName",
                         "titles": "|".join("File:" + f for f in files)})["query"]
    # The API answers with titles normalized (underscores, first letter).
    back = {n["to"]: n["from"] for n in data.get("normalized", [])}
    found = {}
    for page in data.get("pages", []):
        info = (page.get("imageinfo") or [{}])[0]
        url = info.get("thumburl") or info.get("url")
        if not url:
            continue
        title = back.get(page["title"], page["title"])
        licence = info.get("extmetadata", {}).get("LicenseShortName", {}).get("value", "")
        found[title[len("File:"):]] = (url, licence)
    return found


def painting_query(text):
    """The Wikidata search for what one typed: the works of an artist
    when it names one (their label or an alias, "Хокусай" included), as a
    painting's own label rarely names its artist; otherwise paintings
    whose title or description has those words."""
    kinds = "haswbstatement:P31=%s haswbstatement:P18" % "|P31=".join(KINDS)
    found = api(WIKIDATA, {"action": "wbsearchentities", "search": text, "language": "ru",
                           "uselang": "ru", "type": "item", "limit": 5})["search"]
    ids = [f["id"] for f in found if re.fullmatch(r"Q\d+", f.get("id", ""))]
    if ids:
        people = api(WIKIDATA, {"action": "wbgetentities", "ids": "|".join(ids),
                                "props": "claims"})["entities"]
        for qid in ids:
            jobs = people.get(qid, {}).get("claims", {}).get("P106", [])
            if any(j.get("mainsnak", {}).get("datavalue", {}).get("value", {}).get("id")
                   in ARTISTS for j in jobs):
                return "haswbstatement:P170=%s %s" % (qid, kinds)
    return "%s %s" % (text, kinds)


def search_paintings(query, offset=0):
    """Paintings for a painting_query(): a list of dicts, and the offset
    of the next page (None at the end)."""
    data = api(WIKIDATA, {"action": "query", "list": "search", "srnamespace": 0,
                          "srsearch": query, "srlimit": PAGE, "sroffset": offset, "srprop": "",
                          # Russian words are matched by their stems only so.
                          "uselang": "ru"})
    ids = [s["title"] for s in data["query"]["search"] if re.fullmatch(r"Q\d+", s["title"])]
    more = data.get("continue", {}).get("sroffset")
    if not ids:
        return [], None
    items = api(WIKIDATA, {"action": "wbgetentities", "ids": "|".join(ids),
                           "props": "labels|claims", "languages": "ru|en"})["entities"]
    found = []
    for qid in ids:
        ent = items.get(qid, {})
        image = claim(ent, "P18")
        if not isinstance(image, str):
            continue
        creator = claim(ent, "P170")
        made = claim(ent, "P571")
        year = re.match(r"[+-](\d+)-", made.get("time", "")) if isinstance(made, dict) else None
        found.append({"qid": qid, "file": image, "year": int(year.group(1)) if year else None,
                      "title": label_of(ent) or os.path.splitext(image)[0],
                      "creator": creator.get("id") if isinstance(creator, dict) else None})
    who = sorted({f["creator"] for f in found if f["creator"]})
    names = {}
    if who:
        people = api(WIKIDATA, {"action": "wbgetentities", "ids": "|".join(who),
                                "props": "labels", "languages": "ru|en"})["entities"]
        names = {k: label_of(v) for k, v in people.items()}
    thumbs = image_info([f["file"] for f in found], THUMB)
    for f in found:
        f["author"] = names.get(f["creator"], "")
        f["thumb"] = thumbs.get(f["file"], ("", ""))[0]
    return [f for f in found if f["thumb"]], more


def pixbuf_of(data, width, height):
    """Image bytes as a pixbuf that fits width x height."""
    loader = GdkPixbuf.PixbufLoader()
    loader.write(data)
    loader.close()
    pb = loader.get_pixbuf()
    scale = min(width / pb.get_width(), height / pb.get_height())
    return pb.scale_simple(max(1, int(pb.get_width() * scale)),
                           max(1, int(pb.get_height() * scale)), GdkPixbuf.InterpType.BILINEAR)


def downloaded_path(qid, level):
    return os.path.join(DOWNLOADED, "%s-%d.json" % (qid, level))


def load_pictures():
    found = []
    if os.path.isdir(BUILTIN):
        for f in sorted(os.listdir(BUILTIN)):
            if f.endswith(".json"):
                try:
                    with open(os.path.join(BUILTIN, f)) as fh:
                        pic = json.load(fh)
                except (OSError, ValueError):
                    continue
                pic["id"] = "builtin-" + f[:-5]
                pic["mtime"] = os.path.getmtime(os.path.join(BUILTIN, f))
                found.append(pic)
    if os.path.isdir(PHOTOS):
        cache = os.path.join(DATA, "photos")
        os.makedirs(cache, exist_ok=True)
        for f in sorted(os.listdir(PHOTOS)):
            if not f.lower().endswith((".jpg", ".jpeg", ".png")):
                continue
            path = os.path.join(PHOTOS, f)
            try:
                st = os.stat(path)
            except OSError:
                continue
            key = hashlib.sha1(("64|%s|%d|%d" % (path, st.st_size, st.st_mtime)).encode()).hexdigest()[:16]
            cached = os.path.join(cache, key + ".json")
            pic = None
            if os.path.exists(cached):
                try:
                    with open(cached) as fh:
                        pic = json.load(fh)
                except (OSError, ValueError):
                    pic = None
            if pic is None:
                pic = photo_to_picture(path)
                if pic is None:
                    continue
                with open(cached, "w") as fh:
                    json.dump(pic, fh, ensure_ascii=False)
            pic["id"] = "photo-" + key
            pic["level"] = 9
            pic["mtime"] = os.path.getmtime(cached)
            found.append(pic)
    if os.path.isdir(DOWNLOADED):
        for f in os.listdir(DOWNLOADED):
            if not f.endswith(".json"):
                continue
            path = os.path.join(DOWNLOADED, f)
            try:
                with open(path) as fh:
                    pic = json.load(fh)
                pic["mtime"] = os.path.getmtime(path)
            except (OSError, ValueError):
                continue
            pic["id"] = "wd-" + f[:-5]
            pic["level"] = 8
            found.append(pic)
    return found


def cells_of(pic):
    """The grid as numbers, parsed only when a picture is drawn."""
    if "cells" not in pic:
        pic["cells"] = [[int(ch, 36) for ch in row] for row in pic["rows"]]
    return pic["cells"]


def progress_path(pic):
    return os.path.join(DATA, "progress", pic["id"] + ".json")


def load_progress(pic):
    try:
        with open(progress_path(pic)) as fh:
            rows = json.load(fh)["filled"]
        # A picture redrawn at another size starts again.
        if len(rows) == pic["h"] and all(len(row) == pic["w"] for row in rows):
            return [[ch == "1" for ch in row] for row in rows]
    except (OSError, ValueError, KeyError, TypeError):
        pass
    return [[False] * pic["w"] for _ in range(pic["h"])]


def save_progress(pic, filled):
    path = progress_path(pic)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".new"
    with open(tmp, "w") as fh:
        json.dump({"filled": ["".join("1" if f else "0" for f in row) for row in filled]}, fh)
    os.replace(tmp, path)


def read_last():
    try:
        with open(os.path.join(DATA, "last")) as fh:
            return fh.read().strip()
    except OSError:
        return None


def write_last(pic_id):
    try:
        os.makedirs(DATA, exist_ok=True)
        with open(os.path.join(DATA, "last"), "w") as fh:
            fh.write(pic_id)
    except OSError:
        pass


def share_done(pic, filled):
    total = pic["w"] * pic["h"]
    done = sum(row.count(True) for row in filled)
    return done, total


def hex_rgb(colour):
    return tuple(int(colour[i:i + 2], 16) / 255.0 for i in (1, 3, 5))


def pixel(rgb):
    """(r, g, b) in 0..1 as the 4 bytes of a cairo RGB24 pixel."""
    r, g, b = rgb
    return bytes((int(b * 255), int(g * 255), int(r * 255), 0))


def surface(pic, colour_of):
    """A one-pixel-per-cell image; colour_of(x, y) gives the 4-byte pixel.

    Returns the surface and its buffer, which stays writable: change
    pixels in it, then call mark_dirty() on the surface."""
    w, h = pic["w"], pic["h"]
    stride = cairo.ImageSurface.format_stride_for_width(cairo.FORMAT_RGB24, w)
    buf = bytearray(stride * h)
    for y in range(h):
        i = y * stride
        for x in range(w):
            buf[i:i + 4] = colour_of(x, y)
            i += 4
    return cairo.ImageSurface.create_for_data(buf, cairo.FORMAT_RGB24, w, h, stride), buf


def thumbnail(pic, filled, finished):
    """The gallery picture, kept as a PNG until the progress changes."""
    path = os.path.join(DATA, "thumbs", pic["id"] + ".png")
    try:
        newest = max(pic.get("mtime", 0), os.path.getmtime(progress_path(pic)))
    except OSError:
        newest = pic.get("mtime", 0)
    try:
        if os.path.getmtime(path) >= newest:
            return cairo.ImageSurface.create_from_png(path)
    except (OSError, cairo.Error):
        pass
    cells = cells_of(pic)
    pal = [hex_rgb(c) for c in pic["palette"]]
    full = [pixel(c) for c in pal]
    # Still to paint: a pale version, so the picture shows.
    pale = [pixel((0.72 + 0.28 * r, 0.72 + 0.28 * g, 0.72 + 0.28 * b)) for r, g, b in pal]
    image, _buf = surface(pic, lambda x, y: (full if filled[y][x] or finished else pale)
                          [cells[y][x]])
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        image.write_to_png(path + ".new")
        os.replace(path + ".new", path)
    except (OSError, cairo.Error):
        pass
    return image


def paint_scaled(cr, image, cell):
    cr.save()
    cr.scale(cell, cell)
    cr.set_source_surface(image, 0, 0)
    cr.get_source().set_filter(cairo.FILTER_NEAREST)
    cr.paint()
    cr.restore()


def draw_icon(cr, name, size, rgb):
    """Icons drawn on a 48x48 grid with round 4-unit strokes."""
    cr.save()
    cr.scale(size / 48.0, size / 48.0)
    cr.set_source_rgb(*rgb)
    cr.set_line_width(4)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.set_line_join(cairo.LINE_JOIN_ROUND)
    if name == "back":
        cr.move_to(40, 24)
        cr.line_to(9, 24)
        cr.move_to(21, 11)
        cr.line_to(8, 24)
        cr.line_to(21, 37)
        cr.stroke()
    elif name in ("zoom-in", "zoom-out"):
        cr.arc(20, 20, 13, 0, 2 * math.pi)
        cr.move_to(30, 30)
        cr.line_to(42, 42)
        cr.move_to(13, 20)
        cr.line_to(27, 20)
        if name == "zoom-in":
            cr.move_to(20, 13)
            cr.line_to(20, 27)
        cr.stroke()
    elif name == "whole":
        # A framed landscape: "the whole picture".
        cr.rectangle(5, 9, 38, 30)
        cr.stroke()
        cr.move_to(9, 35)
        cr.line_to(19, 22)
        cr.line_to(26, 30)
        cr.line_to(31, 25)
        cr.line_to(39, 35)
        cr.close_path()
        cr.fill()
        cr.arc(33, 17, 3.5, 0, 2 * math.pi)
        cr.fill()
    elif name == "find":
        cr.arc(24, 24, 14, 0, 2 * math.pi)
        for x0, y0, x1, y1 in ((24, 3, 24, 12), (24, 36, 24, 45), (3, 24, 12, 24),
                               (36, 24, 45, 24)):
            cr.move_to(x0, y0)
            cr.line_to(x1, y1)
        cr.stroke()
        cr.arc(24, 24, 4.5, 0, 2 * math.pi)
        cr.fill()
    elif name == "undo":
        # Most of a circle from the top round to the lower left, with the
        # arrow head at the top pointing left: "turn back".
        cr.arc(25, 27, 15, -0.5 * math.pi, 0.85 * math.pi)
        cr.stroke()
        cr.move_to(9, 12)
        cr.line_to(22, 3)
        cr.line_to(22, 21)
        cr.close_path()
        cr.fill()
    elif name == "look":
        cr.move_to(4, 24)
        cr.curve_to(14, 9, 34, 9, 44, 24)
        cr.curve_to(34, 39, 14, 39, 4, 24)
        cr.close_path()
        cr.stroke()
        cr.arc(24, 24, 7, 0, 2 * math.pi)
        cr.fill()
    cr.restore()


def text_colour(colour):
    r, g, b = hex_rgb(colour)
    return (0.0, 0.0, 0.0) if 0.299 * r + 0.587 * g + 0.114 * b > 0.55 else (1.0, 1.0, 1.0)


# --- the picture being painted ----------------------------------------------
class Board(Gtk.DrawingArea):
    def __init__(self, app, pic):
        super().__init__()
        self.app = app
        self.pic = pic
        cells = cells_of(pic)
        self.filled = load_progress(pic)
        pal = [hex_rgb(c) for c in pic["palette"]]
        self.full_px = [pixel(c) for c in pal]
        # Unpainted cells show a very pale picture, so a zoomed-out view
        # still shows where things are.
        self.pale_px = [pixel((0.82 + 0.18 * r, 0.82 + 0.18 * g, 0.82 + 0.18 * b))
                        for r, g, b in pal]
        self.mark_px = pixel(MARK)
        self.counts = [0] * len(pal)
        self.where = [[] for _ in pal]  # every cell of each number
        for y in range(pic["h"]):
            for x in range(pic["w"]):
                n = cells[y][x]
                self.where[n].append((x, y))
                if not self.filled[y][x]:
                    self.counts[n] += 1
        self.chosen = 0
        self.cell = OPEN_CELL
        self.image = None
        self.full_image = None  # the finished picture, for "look"
        self.previewing = False
        self.labels = {}  # (cell size, bold, text) -> where the text starts
        self.save_timer = None
        self.undo = []  # each entry: the cells one tap painted
        self.wrong = None
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                        | Gdk.EventMask.TOUCH_MASK)
        self.connect("draw", self.on_draw)
        self.tap = Gtk.GestureMultiPress.new(self)
        self.tap.set_propagation_phase(Gtk.PropagationPhase.BUBBLE)
        self.tap.connect("released", self.on_tap)

    def set_cell(self, cell):
        self.cell = cell
        self.set_size_request(int(cell * self.pic["w"] + 0.999), int(cell * self.pic["h"] + 0.999))
        self.queue_draw()

    def left(self, number):
        return self.counts[number]

    def colour_of(self, x, y):
        n = self.pic["cells"][y][x]
        if self.filled[y][x]:
            return self.full_px[n]
        return self.mark_px if n == self.chosen else self.pale_px[n]

    def update(self, cells):
        """Redraw just these cells in the image."""
        if self.image is None:
            return
        buf, stride = self.buf, self.image.get_stride()
        for x, y in cells:
            i = y * stride + x * 4
            buf[i:i + 4] = self.colour_of(x, y)
        self.image.mark_dirty()
        self.queue_draw()

    def set_chosen(self, number):
        old, self.chosen = self.chosen, number
        if old != number:
            self.update([c for n in (old, number) for c in self.where[n]
                         if not self.filled[c[1]][c[0]]])

    def set_preview(self, on):
        if on and self.full_image is None:
            self.full_image, _buf = surface(
                self.pic, lambda x, y: self.full_px[self.pic["cells"][y][x]])
        self.previewing = on
        self.queue_draw()

    def save_soon(self):
        # A tap must not wait for the disk; write a moment after the last.
        if self.save_timer:
            GLib.source_remove(self.save_timer)
        self.save_timer = GLib.timeout_add(800, self.save_now)

    def save_now(self):
        if self.save_timer:
            GLib.source_remove(self.save_timer)
            self.save_timer = None
            save_progress(self.pic, self.filled)
        return False

    def on_draw(self, _widget, cr):
        pic, s = self.pic, self.cell
        if self.previewing:
            paint_scaled(cr, self.full_image, s)
            return False
        if self.image is None:
            self.image, self.buf = surface(pic, self.colour_of)
        paint_scaled(cr, self.image, s)
        if s >= GRID:
            # Only the visible cells: a 96x70 picture is too many to draw.
            x0, y0, x1, y1 = cr.clip_extents()
            cx0, cy0 = max(0, int(x0 // s)), max(0, int(y0 // s))
            cx1, cy1 = min(pic["w"], int(x1 // s) + 1), min(pic["h"], int(y1 // s) + 1)
            cr.set_source_rgb(0.75, 0.75, 0.74)
            cr.set_line_width(1)
            for y in range(cy0, cy1):
                frow = self.filled[y]
                for x in range(cx0, cx1):
                    if not frow[x]:
                        cr.rectangle(int(x * s) + 0.5, int(y * s) + 0.5, s - 1, s - 1)
            cr.stroke()
            if s >= NUMBERS:
                cr.select_font_face("Sans", 0, 1)
                for bold in (False, True):
                    cr.set_font_size(s * (0.5 if bold else 0.4))
                    if bold:
                        cr.set_source_rgb(0.18, 0.2, 0.21)
                    else:
                        cr.set_source_rgb(0.6, 0.6, 0.6)
                    for y in range(cy0, cy1):
                        row, frow = pic["cells"][y], self.filled[y]
                        for x in range(cx0, cx1):
                            n = row[x]
                            if frow[x] or (n == self.chosen) != bold:
                                continue
                            label = str(n + 1)
                            key = (s, bold, label)
                            at = self.labels.get(key)
                            if at is None:
                                ext = cr.text_extents(label)
                                at = self.labels[key] = ((s - ext.width) / 2 - ext.x_bearing,
                                                         (s - ext.height) / 2 - ext.y_bearing)
                            cr.move_to(x * s + at[0], y * s + at[1])
                            cr.show_text(label)
        if self.wrong:
            wx, wy = self.wrong
            cr.set_source_rgb(0.88, 0.11, 0.14)
            cr.set_line_width(max(2, s / 8))
            cr.rectangle(wx * s + 1, wy * s + 1, s - 2, s - 2)
            cr.stroke()
        return False

    def on_tap(self, _gesture, _n, px, py):
        x, y = int(px // self.cell), int(py // self.cell)
        if not (0 <= x < self.pic["w"] and 0 <= y < self.pic["h"]) or self.filled[y][x]:
            return
        if self.pic["cells"][y][x] != self.chosen:
            # No buzz here: the red frame alone says "not this one".
            self.wrong = (x, y)
            self.queue_draw()
            GLib.timeout_add(400, self.clear_wrong)
            return
        cells = self.area(x, y)
        for cx, cy in cells:
            self.filled[cy][cx] = True
        self.counts[self.chosen] -= len(cells)
        self.undo.append(cells)
        self.app.buzz()
        self.update(cells)
        self.save_soon()
        self.app.cell_painted(self.chosen)

    def area(self, x, y):
        """Unpainted cells of the same number connected to (x, y)."""
        n = self.pic["cells"][y][x]
        seen = {(x, y)}
        todo = [(x, y)]
        while todo:
            cx, cy = todo.pop()
            for nx, ny in ((cx + 1, cy), (cx - 1, cy), (cx, cy + 1), (cx, cy - 1)):
                if (0 <= nx < self.pic["w"] and 0 <= ny < self.pic["h"]
                        and (nx, ny) not in seen and not self.filled[ny][nx]
                        and self.pic["cells"][ny][nx] == n):
                    seen.add((nx, ny))
                    todo.append((nx, ny))
        return sorted(seen)

    def nearest(self, fx, fy):
        """The unpainted cell of the chosen number closest to (fx, fy)."""
        best, where = None, None
        for x, y in self.where[self.chosen]:
            if not self.filled[y][x]:
                d = (x - fx) ** 2 + (y - fy) ** 2
                if best is None or d < best:
                    best, where = d, (x, y)
        return where

    def clear_wrong(self):
        self.wrong = None
        self.queue_draw()
        return False

    def undo_last(self):
        if not self.undo:
            return
        cells = self.undo.pop()
        for x, y in cells:
            self.filled[y][x] = False
        x, y = cells[0]
        number = self.pic["cells"][y][x]
        self.counts[number] += len(cells)
        self.update(cells)
        self.save_soon()
        self.app.cell_painted(number)


# --- the program ------------------------------------------------------------
class Paint:
    def __init__(self, open_id=None):
        self.buzz = Buzz()
        # Every button buzzes as it goes down, the way the panel does. The
        # signal exists only once the class is set up, hence the throwaway
        # button.
        Gtk.Button()
        GObject.add_emission_hook(Gtk.Button, "pressed", self.on_button)
        self.win = Gtk.Window(title="Раскраска")
        self.win.set_default_size(1160, 800)
        # The same header as Погода, Новости and MAX: the title in the
        # middle, "←" on the left while a picture is open.
        header = Gtk.HeaderBar()
        self.title = Gtk.Label(label="Раскраски")
        self.title.get_style_context().add_class("title")
        header.set_custom_title(self.title)
        self.back_button = Gtk.Button(label="←")
        self.back_button.get_style_context().add_class("back")
        self.back_button.connect("clicked", lambda _b: self.back())
        self.back_button.set_no_show_all(True)
        header.pack_start(self.back_button)
        self.find_button = Gtk.Button(label="+ Найти")
        self.find_button.get_style_context().add_class("back")
        self.find_button.connect("clicked", lambda _b: self.show_search())
        self.find_button.set_no_show_all(True)
        header.pack_end(self.find_button)
        self.win.set_titlebar(header)
        self.win.connect("destroy", self.quit)
        # Progress is written a moment after a tap; write it on the way out.
        GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, self.quit)
        self.stack = Gtk.Stack()
        self.win.add(self.stack)
        self.board = None
        self.swatches = []
        self.search_page = None
        self.search_gen = 0
        self.preview_item = None
        self.pool = concurrent.futures.ThreadPoolExecutor(max_workers=3)
        # An unfinished picture opens straight away; the gallery is built
        # only when it is needed (back() builds it afresh anyway). Building
        # both cost a second before the window first showed.
        open_id = open_id or read_last()
        pic = next((p for p in load_pictures() if p["id"] == open_id), None)
        if pic:
            done, total = share_done(pic, load_progress(pic))
            if done >= total:
                pic = None
        if pic:
            self.open(pic)
        else:
            self.show_gallery()
        self.win.show_all()

    def on_button(self, *_args):
        self.buzz()
        return True  # keep the hook

    # gallery
    def show_gallery(self):
        self.cards = {}
        old = self.stack.get_child_by_name("gallery")
        if old:
            self.stack.remove(old)
        self.title.set_text("Раскраски")
        self.back_button.hide()
        self.find_button.show()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)

        # One section per level, easier at the top.
        sections = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        pictures = load_pictures()
        for level, heading in LEVELS:
            # By theme; downloaded ones newest first.
            pics = sorted((p for p in pictures if p.get("level") == level),
                          key=lambda p: (THEMES.index(p["theme"]) if p.get("theme") in THEMES
                                         else len(THEMES),
                                         -p.get("mtime", 0) if level == 8 else 0))
            if not pics:
                continue
            label = Gtk.Label(label=heading, xalign=0)
            label.get_style_context().add_class("section")
            sections.pack_start(label, False, False, 0)
            flow = Gtk.FlowBox()
            flow.set_selection_mode(Gtk.SelectionMode.NONE)
            flow.set_homogeneous(True)
            flow.set_max_children_per_line(3)
            flow.set_min_children_per_line(3)
            flow.set_row_spacing(16)
            flow.set_column_spacing(16)
            flow.set_margin_start(16)
            flow.set_margin_end(16)
            flow.set_margin_bottom(8)
            for pic in pics:
                flow.add(self.card(pic))
            sections.pack_start(flow, False, False, 0)
        if not pictures:
            sections.pack_start(Gtk.Label(label="Нет картинок"), True, True, 0)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_kinetic_scrolling(True)
        scroll.add(sections)
        box.pack_start(scroll, True, True, 0)
        box.show_all()
        self.stack.add_named(box, "gallery")
        self.stack.set_visible_child_name("gallery")
        # GTK scrolls to whichever card takes the focus; show the last
        # picture's card instead, or the top.
        self.win.set_focus(None)
        GLib.timeout_add(150, self.scroll_to_last, scroll, sections)

    def scroll_to_last(self, scroll, sections):
        y = 0
        card = self.cards.get(read_last())
        if card:
            pos = card.translate_coordinates(sections, 0, 0)
            if pos:
                y = max(0, pos[1] - 70)
        scroll.get_vadjustment().set_value(y)
        return False

    def card(self, pic):
        filled = load_progress(pic)
        done, total = share_done(pic, filled)
        thumb = Gtk.DrawingArea()
        tw, th = 320, 220
        cell = min(tw / pic["w"], th / pic["h"])
        thumb.set_size_request(tw, th)

        image = thumbnail(pic, filled, done == total)

        def draw(_w, cr):
            cr.translate((tw - cell * pic["w"]) / 2, (th - cell * pic["h"]) / 2)
            paint_scaled(cr, image, cell)
            return False

        thumb.connect("draw", draw)
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        inner.pack_start(thumb, False, False, 0)
        name = Gtk.Label(label=pic["name"])
        name.set_line_wrap(True)
        name.set_justify(Gtk.Justification.CENTER)
        name.set_max_width_chars(18)
        inner.pack_start(name, False, False, 0)
        if pic.get("theme"):
            theme = Gtk.Label(label=pic["theme"])
            theme.get_style_context().add_class("progress")
            inner.pack_start(theme, False, False, 0)
        state = "Готово" if done == total else ("%d%%" % (100 * done // total) if done else "Новая")
        prog = Gtk.Label(label=state)
        prog.get_style_context().add_class("progress")
        inner.pack_start(prog, False, False, 0)
        button = Gtk.Button()
        button.get_style_context().add_class("card")
        button.add(inner)
        button.connect("clicked", lambda _b: self.open(pic))
        self.cards[pic["id"]] = button
        downloaded = pic["id"].startswith("wd-")
        if not done and not downloaded:
            return button
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.pack_start(button, True, True, 0)
        if done:
            # A started or finished picture can be wiped and begun again.
            reset = Gtk.Button(label="↺  Начать заново")
            reset.get_style_context().add_class("reset")
            reset.connect("clicked", lambda _b: self.reset(pic))
            box.pack_start(reset, False, False, 0)
        if downloaded:
            remove = Gtk.Button(label="✕  Убрать")
            remove.get_style_context().add_class("reset")
            remove.connect("clicked", lambda _b: self.remove(pic))
            box.pack_start(remove, False, False, 0)
        return box

    def remove(self, pic):
        """Take a downloaded picture out of the gallery, with its progress."""
        if not self.confirm("Убрать «%s»\nиз раскрасок?" % pic["name"], "Убрать"):
            return
        for path in (os.path.join(DOWNLOADED, pic["id"][3:] + ".json"), progress_path(pic),
                     os.path.join(DATA, "thumbs", pic["id"] + ".png")):
            try:
                os.remove(path)
            except OSError:
                pass
        self.show_gallery()

    def reset(self, pic):
        if not self.confirm("Стереть раскраску «%s»\nи начать заново?" % pic["name"], "Стереть"):
            return
        for path in (progress_path(pic), os.path.join(DATA, "thumbs", pic["id"] + ".png")):
            try:
                os.remove(path)
            except OSError:
                pass
        # The gallery comes back at this picture's card.
        write_last(pic["id"])
        self.show_gallery()

    def confirm(self, question, yes):
        """A yes/no question in the shell's own style (b8k-ask's fuzzel);
        True when the first answer is chosen."""
        try:
            res = subprocess.run(
                ["fuzzel", "--config", "/usr/local/share/b8k/fuzzel-ask.ini", "--dmenu",
                 "--index", "--mesg", question, "--cache", "/dev/null", "--select-index", "1"],
                input="%s\nОтмена\n" % yes, capture_output=True, text=True, timeout=600)
        except (OSError, subprocess.SubprocessError):
            return False
        return res.stdout.strip() == "0"

