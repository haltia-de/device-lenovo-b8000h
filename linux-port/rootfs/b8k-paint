    def on_search(self, entry):
        text = entry.get_text().strip()
        self.search_gen += 1
        gen = self.search_gen
        if len(text) < 2:
            for child in self.results.get_children():
                child.destroy()
            self.more_button.hide()
            self.topics.show()
            self.search_note.set_text("Напишите художника, название или что нарисовано, "
                                      "или нажмите тему:")
            return
        self.search_note.set_text("Ищу «%s»…" % text)
        # Wait for a pause in typing before asking.
        GLib.timeout_add(700, lambda: gen == self.search_gen
                         and self.run_search(gen, text, 0) and False)

    def search_more(self):
        if self.search_next is not None:
            self.more_button.hide()
            self.search_note.set_text("Ищу ещё…")
            self.run_search(self.search_gen, self.search_query, self.search_next)

    def run_search(self, gen, text, offset):
        """Page 0 of what one typed, or a later page of the query found then."""
        def work():
            try:
                query = painting_query(text) if offset == 0 else text
                found, more, err = *search_paintings(query, offset), None
            except Exception as exc:  # no network, a changed answer: say so
                found, more, err = [], None, exc
                query = None
            GLib.idle_add(self.show_results, gen, query, offset, found, more, err)

        threading.Thread(target=work, daemon=True).start()
        return False

    def show_results(self, gen, query, offset, found, more, err):
        if gen != self.search_gen:
            return False
        if offset == 0:
            for child in self.results.get_children():
                child.destroy()
            self.result_scroll.get_vadjustment().set_value(0)
        self.topics.hide()
        self.search_query, self.search_next = query, more
        if err:
            sys.stderr.write("b8k-paint: search: %s\n" % err)
            self.search_note.set_text("Нет связи с Википедией, попробуйте позже")
        elif not found and offset == 0:
            self.search_note.set_text("Ничего не нашлось. Попробуйте другое слово, "
                                      "например фамилию художника.")
        else:
            self.search_note.set_text("Нажмите на картину, чтобы рассмотреть её")
        for item in found:
            self.results.add(self.result_card(gen, item))
        self.results.show_all()
        self.more_button.set_visible(more is not None and not err)
        return False

