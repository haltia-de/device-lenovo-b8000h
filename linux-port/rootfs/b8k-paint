# --- haptics ----------------------------------------------------------------
class Buzz:
    """A short pulse on the regulator-haptic motor, set up once."""

    EVIOCSFF = 0x40000000 | (0x2C << 16) | (ord("E") << 8) | 0x80

    def __init__(self, ms=70):
        self.fd = -1
        self.effect = -1
        try:
            for node in sorted(os.listdir("/sys/class/input")):
                if not node.startswith("event"):
                    continue
                with open("/sys/class/input/%s/device/name" % node) as fh:
                    if fh.read().strip() != "regulator-haptic":
                        continue
                self.fd = os.open("/dev/input/" + node, os.O_RDWR | os.O_CLOEXEC)
                # struct ff_effect, 32-bit: type, id, direction, trigger,
                # replay, then the rumble magnitudes and padding.
                buf = bytearray(struct.pack("<HhHHHHHHH", 0x50, -1, 0, 0, 0, ms, 0,
                                            0xFFFF, 0xFFFF) + bytes(32))
                fcntl.ioctl(self.fd, self.EVIOCSFF, buf)
                self.effect = struct.unpack_from("<h", buf, 2)[0]
                break
        except OSError:
            self.fd = -1

    def __call__(self):
        if self.fd >= 0:
            try:
                os.write(self.fd, struct.pack("<llHHi", 0, 0, 0x15, self.effect, 1))
            except OSError:
                pass


# --- pictures -----------------------------------------------------------------
def photo_to_picture(path):
    """Turn a photo into a grid picture; None when Pillow cannot read it."""
    try:
        from PIL import Image, ImageFilter, ImageOps
    except ImportError:
        return None
    try:
        img = ImageOps.exif_transpose(Image.open(path)).convert("RGB")
    except OSError:
        return None
    w, h = img.size
    if w >= h:
        cols, rows = 64, max(8, round(64 * h / w))
    else:
        rows, cols = 64, max(8, round(64 * w / h))
    small = img.filter(ImageFilter.MedianFilter(3)).resize((cols, rows), Image.LANCZOS)
    pal_img = small.quantize(colors=16, method=Image.Quantize.MEDIANCUT,
                             dither=Image.Dither.NONE)
    raw = pal_img.getpalette()[:48]
    used = sorted(set(pal_img.getdata()))
    colours = [tuple(raw[i * 3:i * 3 + 3]) for i in used]
    # Light to dark, so number 1 is the lightest colour.
    order = sorted(range(len(used)),
                   key=lambda i: -(0.299 * colours[i][0] + 0.587 * colours[i][1]
                                   + 0.114 * colours[i][2]))
    remap = {used[i]: n for n, i in enumerate(order)}
    palette = ["#%02x%02x%02x" % colours[i] for i in order]
    data = list(pal_img.getdata())
    grid = ["".join(DIGITS[remap[data[y * cols + x]]] for x in range(cols))
            for y in range(rows)]
    name = os.path.splitext(os.path.basename(path))[0]
    return {"name": name, "level": 5, "w": cols, "h": rows, "palette": palette, "rows": grid}


def load_pictures():
    found = []
    if os.path.isdir(BUILTIN):
        for f in sorted(os.listdir(BUILTIN)):
            if f.endswith(".json"):
                try:
                    with open(os.path.join(BUILTIN, f)) as fh:
                        pic = json.load(fh)
                except (OSError, ValueError):
                    continue
                pic["id"] = "builtin-" + f[:-5]
                found.append(pic)
    if os.path.isdir(PHOTOS):
        cache = os.path.join(DATA, "photos")
        os.makedirs(cache, exist_ok=True)
        for f in sorted(os.listdir(PHOTOS)):
            if not f.lower().endswith((".jpg", ".jpeg", ".png")):
                continue
            path = os.path.join(PHOTOS, f)
            try:
                st = os.stat(path)
            except OSError:
                continue
            key = hashlib.sha1(("64|%s|%d|%d" % (path, st.st_size, st.st_mtime)).encode()).hexdigest()[:16]
            cached = os.path.join(cache, key + ".json")
            pic = None
            if os.path.exists(cached):
                try:
                    with open(cached) as fh:
                        pic = json.load(fh)
                except (OSError, ValueError):
                    pic = None
            if pic is None:
                pic = photo_to_picture(path)
                if pic is None:
                    continue
                with open(cached, "w") as fh:
                    json.dump(pic, fh, ensure_ascii=False)
            pic["id"] = "photo-" + key
            pic["level"] = 5
            found.append(pic)
    for pic in found:
        pic["cells"] = [[int(ch, 36) for ch in row] for row in pic["rows"]]
    return found


def progress_path(pic):
    return os.path.join(DATA, "progress", pic["id"] + ".json")


def load_progress(pic):
    try:
        with open(progress_path(pic)) as fh:
            rows = json.load(fh)["filled"]
        return [[ch == "1" for ch in row] for row in rows]
    except (OSError, ValueError, KeyError):
        return [[False] * pic["w"] for _ in range(pic["h"])]


def save_progress(pic, filled):
    path = progress_path(pic)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".new"
    with open(tmp, "w") as fh:
        json.dump({"filled": ["".join("1" if f else "0" for f in row) for row in filled]}, fh)
    os.replace(tmp, path)


def read_last():
    try:
        with open(os.path.join(DATA, "last")) as fh:
            return fh.read().strip()
    except OSError:
        return None


def write_last(pic_id):
    try:
        os.makedirs(DATA, exist_ok=True)
        with open(os.path.join(DATA, "last"), "w") as fh:
            fh.write(pic_id)
    except OSError:
        pass


def share_done(pic, filled):
    total = pic["w"] * pic["h"]
    done = sum(row.count(True) for row in filled)
    return done, total


def hex_rgb(colour):
    return tuple(int(colour[i:i + 2], 16) / 255.0 for i in (1, 3, 5))


def surface(pic, colour_of):
    """A one-pixel-per-cell image; colour_of(x, y) gives (r, g, b) in 0..1."""
    w, h = pic["w"], pic["h"]
    stride = cairo.ImageSurface.format_stride_for_width(cairo.FORMAT_RGB24, w)
    buf = bytearray(stride * h)
    for y in range(h):
        i = y * stride
        for x in range(w):
            r, g, b = colour_of(x, y)
            buf[i] = int(b * 255)
            buf[i + 1] = int(g * 255)
            buf[i + 2] = int(r * 255)
            i += 4
    return cairo.ImageSurface.create_for_data(buf, cairo.FORMAT_RGB24, w, h, stride)


def paint_scaled(cr, image, cell):
    cr.save()
    cr.scale(cell, cell)
    cr.set_source_surface(image, 0, 0)
    cr.get_source().set_filter(cairo.FILTER_NEAREST)
    cr.paint()
    cr.restore()


def draw_icon(cr, name, size, rgb, full=False):
    """Icons drawn on a 48x48 grid with round 4-unit strokes."""
    cr.save()
    cr.scale(size / 48.0, size / 48.0)
    cr.set_source_rgb(*rgb)
    cr.set_line_width(4)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.set_line_join(cairo.LINE_JOIN_ROUND)
    if name == "back":
        cr.move_to(40, 24)
        cr.line_to(9, 24)
        cr.move_to(21, 11)
        cr.line_to(8, 24)
        cr.line_to(21, 37)
        cr.stroke()
    elif name in ("zoom-in", "zoom-out"):
        cr.arc(20, 20, 13, 0, 2 * math.pi)
        cr.move_to(30, 30)
        cr.line_to(42, 42)
        cr.move_to(13, 20)
        cr.line_to(27, 20)
        if name == "zoom-in":
            cr.move_to(20, 13)
            cr.line_to(20, 27)
        cr.stroke()
    elif name == "find":
        cr.arc(24, 24, 14, 0, 2 * math.pi)
        for x0, y0, x1, y1 in ((24, 3, 24, 12), (24, 36, 24, 45), (3, 24, 12, 24),
                               (36, 24, 45, 24)):
            cr.move_to(x0, y0)
            cr.line_to(x1, y1)
        cr.stroke()
        cr.arc(24, 24, 4.5, 0, 2 * math.pi)
        cr.fill()
    elif name == "undo":
        # Most of a circle from the top round to the lower left, with the
        # arrow head at the top pointing left: "turn back".
        cr.arc(25, 27, 15, -0.5 * math.pi, 0.85 * math.pi)
        cr.stroke()
        cr.move_to(9, 12)
        cr.line_to(22, 3)
        cr.line_to(22, 21)
        cr.close_path()
        cr.fill()
    elif name == "full":
        # Corners point out to go full screen, in to come back.
        for sx, sy in ((1, 1), (-1, 1), (1, -1), (-1, -1)):
            cx, cy = 24 - sx * 18, 24 - sy * 18
            if not full:
                cr.move_to(cx, cy + sy * 11)
                cr.line_to(cx, cy)
                cr.line_to(cx + sx * 11, cy)
            else:
                ix, iy = cx + sx * 11, cy + sy * 11
                cr.move_to(cx, iy)
                cr.line_to(ix, iy)
                cr.line_to(ix, cy)
        cr.stroke()
    elif name == "look":
        cr.move_to(4, 24)
        cr.curve_to(14, 9, 34, 9, 44, 24)
        cr.curve_to(34, 39, 14, 39, 4, 24)
        cr.close_path()
        cr.stroke()
        cr.arc(24, 24, 7, 0, 2 * math.pi)
        cr.fill()
    cr.restore()


def text_colour(colour):
    r, g, b = hex_rgb(colour)
    return (0.0, 0.0, 0.0) if 0.299 * r + 0.587 * g + 0.114 * b > 0.55 else (1.0, 1.0, 1.0)


# --- the picture being painted ----------------------------------------------
class Board(Gtk.DrawingArea):
    def __init__(self, app, pic):
        super().__init__()
        self.app = app
        self.pic = pic
        self.filled = load_progress(pic)
        self.pal = [hex_rgb(c) for c in pic["palette"]]
        # Unpainted cells show a very pale picture, so a zoomed-out view
        # still shows where things are.
        self.pale = [(0.82 + 0.18 * r, 0.82 + 0.18 * g, 0.82 + 0.18 * b) for r, g, b in self.pal]
        self.counts = [0] * len(self.pal)
        for y in range(pic["h"]):
            for x in range(pic["w"]):
                if not self.filled[y][x]:
                    self.counts[pic["cells"][y][x]] += 1
        self.chosen = 0
        self.cell = OPEN_CELL
        self.image = None
        self.undo = []  # each entry: the cells one tap painted
        self.wrong = None
        self.flash = None  # (x, y, on): the "where?" marker
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                        | Gdk.EventMask.TOUCH_MASK)
        self.connect("draw", self.on_draw)
        self.tap = Gtk.GestureMultiPress.new(self)
        self.tap.set_propagation_phase(Gtk.PropagationPhase.BUBBLE)
        self.tap.connect("released", self.on_tap)

    def set_cell(self, cell):
        self.cell = cell
        self.set_size_request(int(cell * self.pic["w"] + 0.999), int(cell * self.pic["h"] + 0.999))
        self.queue_draw()

    def left(self, number):
        return self.counts[number]

    def refresh(self):
        """Rebuild the cell image after the state changed."""
        cells, filled, chosen = self.pic["cells"], self.filled, self.chosen

        def colour_of(x, y):
            n = cells[y][x]
            if filled[y][x]:
                return self.pal[n]
            return MARK if n == chosen else self.pale[n]

        self.image = surface(self.pic, colour_of)
        self.queue_draw()

    def on_draw(self, _widget, cr):
        pic, s = self.pic, self.cell
        if self.image is None:
            self.refresh()
        paint_scaled(cr, self.image, s)
        if s >= GRID:
            # Only the visible cells: a 96x70 picture is too many to draw.
            x0, y0, x1, y1 = cr.clip_extents()
            cx0, cy0 = max(0, int(x0 // s)), max(0, int(y0 // s))
            cx1, cy1 = min(pic["w"], int(x1 // s) + 1), min(pic["h"], int(y1 // s) + 1)
            cr.set_source_rgb(0.75, 0.75, 0.74)
            cr.set_line_width(1)
            for y in range(cy0, cy1):
                frow = self.filled[y]
                for x in range(cx0, cx1):
                    if not frow[x]:
                        cr.rectangle(int(x * s) + 0.5, int(y * s) + 0.5, s - 1, s - 1)
            cr.stroke()
            if s >= NUMBERS:
                cr.select_font_face("Sans", 0, 1)
                for bold in (False, True):
                    cr.set_font_size(s * (0.5 if bold else 0.4))
                    if bold:
                        cr.set_source_rgb(0.18, 0.2, 0.21)
                    else:
                        cr.set_source_rgb(0.6, 0.6, 0.6)
                    for y in range(cy0, cy1):
                        row, frow = pic["cells"][y], self.filled[y]
                        for x in range(cx0, cx1):
                            n = row[x]
                            if frow[x] or (n == self.chosen) != bold:
                                continue
                            label = str(n + 1)
                            ext = cr.text_extents(label)
                            cr.move_to(x * s + (s - ext.width) / 2 - ext.x_bearing,
                                       y * s + (s - ext.height) / 2 - ext.y_bearing)
                            cr.show_text(label)
        if self.flash and self.flash[2]:
            fx, fy, _on = self.flash
            # A ring around the cell, large enough to see when zoomed out.
            cr.set_source_rgb(0.21, 0.52, 0.89)
            cr.set_line_width(max(4, s / 5))
            cr.arc((fx + 0.5) * s, (fy + 0.5) * s, max(24, s * 1.4), 0, 2 * math.pi)
            cr.stroke()
        if self.wrong:
            wx, wy = self.wrong
            cr.set_source_rgb(0.88, 0.11, 0.14)
            cr.set_line_width(max(2, s / 8))
            cr.rectangle(wx * s + 1, wy * s + 1, s - 2, s - 2)
            cr.stroke()
        return False

    def on_tap(self, _gesture, _n, px, py):
        x, y = int(px // self.cell), int(py // self.cell)
        if not (0 <= x < self.pic["w"] and 0 <= y < self.pic["h"]) or self.filled[y][x]:
            return
        if self.pic["cells"][y][x] != self.chosen:
            self.wrong = (x, y)
            self.queue_draw()
            GLib.timeout_add(400, self.clear_wrong)
            return
        cells = self.area(x, y)
        for cx, cy in cells:
            self.filled[cy][cx] = True
        self.counts[self.chosen] -= len(cells)
        self.undo.append(cells)
        self.app.buzz()
        self.refresh()
        save_progress(self.pic, self.filled)
        self.app.cell_painted(self.chosen)

    def area(self, x, y):
        """Unpainted cells of the same number connected to (x, y)."""
        n = self.pic["cells"][y][x]
        seen = {(x, y)}
        todo = [(x, y)]
        while todo:
            cx, cy = todo.pop()
            for nx, ny in ((cx + 1, cy), (cx - 1, cy), (cx, cy + 1), (cx, cy - 1)):
                if (0 <= nx < self.pic["w"] and 0 <= ny < self.pic["h"]
                        and (nx, ny) not in seen and not self.filled[ny][nx]
                        and self.pic["cells"][ny][nx] == n):
                    seen.add((nx, ny))
                    todo.append((nx, ny))
        return sorted(seen)

    def nearest(self, fx, fy):
        """The unpainted cell of the chosen number closest to (fx, fy)."""
        best, where = None, None
        for y in range(self.pic["h"]):
            row, frow = self.pic["cells"][y], self.filled[y]
            for x in range(self.pic["w"]):
                if row[x] == self.chosen and not frow[x]:
                    d = (x - fx) ** 2 + (y - fy) ** 2
                    if best is None or d < best:
                        best, where = d, (x, y)
        return where

    def clear_wrong(self):
        self.wrong = None
        self.queue_draw()
        return False

    def undo_last(self):
        if not self.undo:
            return
        cells = self.undo.pop()
        for x, y in cells:
            self.filled[y][x] = False
        x, y = cells[0]
        number = self.pic["cells"][y][x]
        self.counts[number] += len(cells)
        save_progress(self.pic, self.filled)
        self.refresh()
        self.app.cell_painted(number)


# --- the program ------------------------------------------------------------
class Paint:
    def __init__(self, open_id=None):
        self.buzz = Buzz()
        self.win = Gtk.Window(title="Раскраска")
        self.win.set_default_size(1160, 800)
        self.win.connect("destroy", Gtk.main_quit)
        self.full = False
        self.win.connect("window-state-event", self.on_window_state)
        self.stack = Gtk.Stack()
        self.win.add(self.stack)
        self.board = None
        self.swatches = []
        self.show_gallery()
        self.win.show_all()
        open_id = open_id or read_last()
        pic = next((p for p in load_pictures() if p["id"] == open_id), None)
        if pic:
            done, total = share_done(pic, load_progress(pic))
            if done < total:
                self.open(pic)

    # gallery
    def show_gallery(self):
        self.cards = {}
        old = self.stack.get_child_by_name("gallery")
        if old:
            self.stack.remove(old)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        bar = Gtk.Box(spacing=12)
        bar.get_style_context().add_class("bar")
        title = Gtk.Label(label="Раскраски")
        title.get_style_context().add_class("title")
        bar.pack_start(title, True, True, 0)
        box.pack_start(bar, False, False, 0)

        # One section per level, easier at the top.
        sections = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        pictures = load_pictures()
        for level, heading in LEVELS:
            pics = sorted((p for p in pictures if p.get("level") == level),
                          key=lambda p: THEMES.index(p["theme"]) if p.get("theme") in THEMES
                          else len(THEMES))
            if not pics:
                continue
            label = Gtk.Label(label=heading, xalign=0)
            label.get_style_context().add_class("section")
            sections.pack_start(label, False, False, 0)
            flow = Gtk.FlowBox()
            flow.set_selection_mode(Gtk.SelectionMode.NONE)
            flow.set_homogeneous(True)
            flow.set_max_children_per_line(3)
            flow.set_min_children_per_line(3)
            flow.set_row_spacing(16)
            flow.set_column_spacing(16)
            flow.set_margin_start(16)
            flow.set_margin_end(16)
            flow.set_margin_bottom(8)
            for pic in pics:
                flow.add(self.card(pic))
            sections.pack_start(flow, False, False, 0)
        if not pictures:
            sections.pack_start(Gtk.Label(label="Нет картинок"), True, True, 0)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_kinetic_scrolling(True)
        scroll.add(sections)
        box.pack_start(scroll, True, True, 0)
        box.show_all()
        self.stack.add_named(box, "gallery")
        self.stack.set_visible_child_name("gallery")
        # GTK scrolls to whichever card takes the focus; show the last
        # picture's card instead, or the top.
        self.win.set_focus(None)
        GLib.timeout_add(150, self.scroll_to_last, scroll, sections)

    def scroll_to_last(self, scroll, sections):
        y = 0
        card = self.cards.get(read_last())
        if card:
            pos = card.translate_coordinates(sections, 0, 0)
            if pos:
                y = max(0, pos[1] - 70)
        scroll.get_vadjustment().set_value(y)
        return False

    def card(self, pic):
        filled = load_progress(pic)
        done, total = share_done(pic, filled)
        thumb = Gtk.DrawingArea()
        tw, th = 320, 220
        cell = min(tw / pic["w"], th / pic["h"])
        thumb.set_size_request(tw, th)

        pal = [hex_rgb(c) for c in pic["palette"]]
        # Still to paint: a pale version, so the picture shows.
        pale = [(0.72 + 0.28 * r, 0.72 + 0.28 * g, 0.72 + 0.28 * b) for r, g, b in pal]
        image = surface(pic, lambda x, y: (pal if filled[y][x] or done == total else pale)
                        [pic["cells"][y][x]])

        def draw(_w, cr):
            cr.translate((tw - cell * pic["w"]) / 2, (th - cell * pic["h"]) / 2)
            paint_scaled(cr, image, cell)
            return False

        thumb.connect("draw", draw)
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        inner.pack_start(thumb, False, False, 0)
        name = Gtk.Label(label=pic["name"])
        name.set_line_wrap(True)
        name.set_justify(Gtk.Justification.CENTER)
        name.set_max_width_chars(18)
        inner.pack_start(name, False, False, 0)
        if pic.get("theme"):
            theme = Gtk.Label(label=pic["theme"])
            theme.get_style_context().add_class("progress")
            inner.pack_start(theme, False, False, 0)
        state = "Готово" if done == total else ("%d%%" % (100 * done // total) if done else "Новая")
        prog = Gtk.Label(label=state)
        prog.get_style_context().add_class("progress")
        inner.pack_start(prog, False, False, 0)
        button = Gtk.Button()
        button.get_style_context().add_class("card")
        button.add(inner)
        button.connect("clicked", lambda _b: self.open(pic))
        self.cards[pic["id"]] = button
        return button

    # board
    def open(self, pic):
        write_last(pic["id"])
        old = self.stack.get_child_by_name("board")
        if old:
            self.stack.remove(old)
        self.board = Board(self, pic)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        middle = Gtk.Box()
        box.pack_start(middle, True, True, 0)

        # Icon buttons on the right, in groups: leave; zoom; find and undo;
        # how the screen looks.
        tools = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        tools.get_style_context().add_class("tools")
        self.full_icon = None
        for name, action, gap in (("back", self.back, True), ("zoom-in", self.zoom_in, False),
                                  ("zoom-out", self.zoom_out, True), ("find", self.find, False),
                                  ("undo", self.board.undo_last, True),
                                  ("full", self.toggle_full, False), ("look", None, False)):
            tools.pack_start(self.tool(name, action), False, False, 0)
            if gap:
                tools.pack_start(Gtk.Box(), True, True, 0)
        middle.pack_end(tools, False, False, 0)

        self.scroll = Gtk.ScrolledWindow()
        self.scroll.set_kinetic_scrolling(True)
        self.scroll.connect("size-allocate", self.on_view_size)
        self.view_size = None
        self.zoom = None
        self.scroll.get_style_context().add_class("paint-bg")
        holder = Gtk.Box()
        holder.set_halign(Gtk.Align.CENTER)
        holder.set_valign(Gtk.Align.CENTER)
        holder.pack_start(self.board, False, False, 0)
        self.scroll.add(holder)
        middle.pack_start(self.scroll, True, True, 0)

        pal_scroll = Gtk.ScrolledWindow()
        pal_scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.NEVER)
        pal_scroll.set_kinetic_scrolling(True)
        pal = Gtk.Box(spacing=8)
        pal.get_style_context().add_class("palette")
        self.swatches = []
        for n, colour in enumerate(pic["palette"]):
            b = Gtk.Button()
            b.get_style_context().add_class("swatch")
            prov = Gtk.CssProvider()
            prov.load_from_data((".swatch { background-color: %s; }" % colour).encode())
            b.get_style_context().add_provider(prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
            fg = "#000000" if text_colour(colour) == (0.0, 0.0, 0.0) else "#ffffff"
            lab = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            num = Gtk.Label()
            num.set_markup('<span foreground="%s">%d</span>' % (fg, n + 1))
            left = Gtk.Label()
            left.get_style_context().add_class("left")
            lab.pack_start(num, True, True, 0)
            lab.pack_start(left, False, False, 0)
            b.add(lab)
            b.connect("clicked", lambda _b, k=n: self.choose(k))
            pal.pack_start(b, False, False, 0)
            self.swatches.append((b, left, fg))
        pal_scroll.add(pal)
        box.pack_start(pal_scroll, False, False, 0)

        box.show_all()
        self.stack.add_named(box, "board")
        self.stack.set_visible_child_name("board")
        first = next((n for n in range(len(pic["palette"])) if self.board.left(n)), 0)
        self.choose(first)

    def tool(self, name, action):
        """A button with a drawn icon; "look" works while it is held."""
        b = Gtk.Button()
        b.get_style_context().add_class("tool")
        if name == "find":
            b.get_style_context().add_class("accent")
        icon = Gtk.DrawingArea()
        icon.set_size_request(48, 48)
        rgb = (1.0, 1.0, 1.0) if name == "find" else (0.18, 0.2, 0.21)
        def draw(widget, cr):
            cr.translate((widget.get_allocated_width() - 48) / 2,
                         (widget.get_allocated_height() - 48) / 2)
            draw_icon(cr, name, 48, rgb, self.full)
            return False

        icon.connect("draw", draw)
        b.add(icon)
        if name == "full":
            self.full_icon = icon
        if action:
            b.connect("clicked", lambda _b: (self.buzz(), action()))
        else:
            b.connect("pressed", lambda _b: (self.buzz(), self.preview(True)))
            b.connect("released", lambda _b: self.preview(False))
        return b

    def find(self):
        """Show the nearest unpainted cell of the chosen colour, and flash it."""
        h, v = self.scroll.get_hadjustment(), self.scroll.get_vadjustment()
        s = self.board.cell
        cx = (h.get_value() + h.get_page_size() / 2) / s
        cy = (v.get_value() + v.get_page_size() / 2) / s
        where = self.board.nearest(cx, cy)
        if not where or not self.view_size:
            return
        x, y = where
        steps = self.steps()
        index = max(self.zoom or 0,
                    next((i for i, z in enumerate(steps) if z >= OPEN_CELL), len(steps) - 1))
        self.set_zoom(index, ((x + 0.5) / self.board.pic["w"], (y + 0.5) / self.board.pic["h"]))
        count = [0]

        def blink():
            count[0] += 1
            done = count[0] >= 8
            self.board.flash = None if done else (x, y, count[0] % 2 == 1)
            self.board.queue_draw()
            if done:
                self.flash_timer = None
            return not done

        if getattr(self, "flash_timer", None):
            GLib.source_remove(self.flash_timer)
        self.flash_timer = GLib.timeout_add(260, blink)
        blink()

    def on_view_size(self, _widget, alloc):
        size = (alloc.width, alloc.height)
        if size == self.view_size or alloc.width < 50:
            return
        self.view_size = size
        GLib.idle_add(self.set_zoom, self.zoom)

    def steps(self):
        """Cell sizes: the whole picture in view, then the fixed ones above."""
        w, h = self.view_size
        whole = max(2.0, min((w - 4) / self.board.pic["w"], (h - 4) / self.board.pic["h"]))
        return [whole] + [z for z in ZOOMS if z > whole * 1.15]

    def set_zoom(self, index, focus=None):
        if not self.board or not self.view_size:
            return False
        steps = self.steps()
        if index is None:
            index = next((i for i, z in enumerate(steps) if z >= OPEN_CELL), len(steps) - 1)
        index = max(0, min(index, len(steps) - 1))
        # Keep the middle of the view on the same spot of the picture.
        h, v = self.scroll.get_hadjustment(), self.scroll.get_vadjustment()
        if focus:
            fx, fy = focus
        else:
            fx = (h.get_value() + h.get_page_size() / 2) / max(1, h.get_upper())
            fy = (v.get_value() + v.get_page_size() / 2) / max(1, v.get_upper())
        self.zoom = index
        self.board.set_cell(steps[index])

        def recentre():
            for adj, f in ((h, fx), (v, fy)):
                adj.set_value(f * adj.get_upper() - adj.get_page_size() / 2)
            return False

        GLib.timeout_add(60, recentre)
        return False

    def zoom_in(self):
        if self.zoom is not None:
            self.set_zoom(self.zoom + 1)

    def zoom_out(self):
        if self.zoom is not None and self.zoom > 0:
            self.set_zoom(self.zoom - 1)

    def toggle_full(self):
        if self.full:
            self.win.unfullscreen()
        else:
            self.win.fullscreen()

    def on_window_state(self, _win, event):
        self.full = bool(event.new_window_state & Gdk.WindowState.FULLSCREEN)
        if self.board and self.full_icon:
            self.full_icon.queue_draw()
        return False

    def choose(self, number):
        self.board.chosen = number
        self.board.refresh()
        self.refresh_swatches()

    def refresh_swatches(self):
        for n, (b, left, fg) in enumerate(self.swatches):
            count = self.board.left(n)
            left.set_markup('<span foreground="%s">%s</span>' % (fg, "✓" if count == 0 else str(count)))
            ctx = b.get_style_context()
            (ctx.add_class if n == self.board.chosen else ctx.remove_class)("chosen")
            (ctx.add_class if count == 0 else ctx.remove_class)("done")

    def cell_painted(self, number):
        if self.board.left(number) == 0:
            nxt = next((n for n in range(len(self.board.pic["palette"]))
                        if self.board.left(n)), None)
            if nxt is None:
                self.refresh_swatches()
                self.finished()
                return
            if number == self.board.chosen:
                self.choose(nxt)
                return
        self.refresh_swatches()

    def preview(self, on):
        # While "look" is held, the board shows the finished picture.
        if not self.board:
            return
        if on:
            self.saved_filled = self.board.filled
            self.board.filled = [[True] * self.board.pic["w"] for _ in range(self.board.pic["h"])]
        elif getattr(self, "saved_filled", None) is not None:
            self.board.filled = self.saved_filled
            self.saved_filled = None
        self.board.refresh()

    def finished(self):
        dialog = Gtk.MessageDialog(transient_for=self.win, modal=True,
                                   message_type=Gtk.MessageType.INFO,
                                   buttons=Gtk.ButtonsType.OK, text="Готово!")
        dialog.format_secondary_text("Картинка раскрашена.")
        dialog.run()
        dialog.destroy()
        self.back()

    def back(self):
        self.board = None
        self.show_gallery()


def main():
    run = os.environ.get("XDG_RUNTIME_DIR") or os.path.expanduser("~/.cache")
    lock = open(os.path.join(run, "b8k-paint.lock"), "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    os.makedirs(PHOTOS, exist_ok=True)
    # --open ID goes straight to one picture (for testing).
    open_id = sys.argv[2] if sys.argv[1:2] == ["--open"] and len(sys.argv) > 2 else None
    Paint(open_id)
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
