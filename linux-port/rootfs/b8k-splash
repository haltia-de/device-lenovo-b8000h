#!/usr/bin/python3
# Blank curtain under the top bar, with a loading mark.
# b8k-launch starts this while a program is opening, then stops it.
import ctypes
import math
import mmap
import os
import socket
import struct
import sys
import time

BAR = 120  # width of the panel on the left edge
ANCHOR_ALL = 15
LAYER_TOP = 2
# XRGB8888
FMT = 1
BG = (0x1E, 0x24, 0x30)
INK = (0xF2, 0xF2, 0xF2)
DIM = (0x5C, 0x6B, 0x86)
HOT = (0x8E, 0xB7, 0xFF)
DOTS = 10
SPOTS = tuple(
    (math.cos(6.28318530718 * i / DOTS - 1.57079632679) * 86,
     math.sin(6.28318530718 * i / DOTS - 1.57079632679) * 86)
    for i in range(DOTS)
)


def pad(n):
    return (n + 3) & ~3


def put_string(text):
    raw = text.encode() + b"\x00"
    return struct.pack("<I", len(raw)) + raw + b"\x00" * (pad(len(raw)) - len(raw))


def take_string(body, off):
    (length,) = struct.unpack_from("<I", body, off)
    off += 4
    text = body[off : off + max(0, length - 1)].decode("utf-8", "replace")
    return text, off + pad(length)


def unit(rgb):
    return rgb[0] / 255.0, rgb[1] / 255.0, rgb[2] / 255.0


class Painter:
    """Draws the curtain with Cairo so the word is a real font."""

    def __init__(self):
        self.cairo = ctypes.CDLL("libcairo.so.2")
        self.pango = ctypes.CDLL("libpango-1.0.so.0")
        self.pangocairo = ctypes.CDLL("libpangocairo-1.0.so.0")
        self.gobject = ctypes.CDLL("libgobject-2.0.so.0")
        c = self.cairo
        c.cairo_image_surface_create_for_data.restype = ctypes.c_void_p
        c.cairo_image_surface_create_for_data.argtypes = [
            ctypes.c_void_p, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int,
        ]
        c.cairo_create.restype = ctypes.c_void_p
        c.cairo_create.argtypes = [ctypes.c_void_p]
        c.cairo_destroy.argtypes = [ctypes.c_void_p]
        c.cairo_surface_destroy.argtypes = [ctypes.c_void_p]
        c.cairo_surface_flush.argtypes = [ctypes.c_void_p]
        c.cairo_set_source_rgb.argtypes = [
            ctypes.c_void_p, ctypes.c_double, ctypes.c_double, ctypes.c_double,
        ]
        c.cairo_paint.argtypes = [ctypes.c_void_p]
        c.cairo_arc.argtypes = [
            ctypes.c_void_p, ctypes.c_double, ctypes.c_double, ctypes.c_double,
            ctypes.c_double, ctypes.c_double,
        ]
        c.cairo_fill.argtypes = [ctypes.c_void_p]
        c.cairo_move_to.argtypes = [ctypes.c_void_p, ctypes.c_double, ctypes.c_double]
        self.pangocairo.pango_cairo_create_layout.restype = ctypes.c_void_p
        self.pangocairo.pango_cairo_create_layout.argtypes = [ctypes.c_void_p]
        self.pangocairo.pango_cairo_show_layout.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
        self.pango.pango_font_description_from_string.restype = ctypes.c_void_p
        self.pango.pango_font_description_from_string.argtypes = [ctypes.c_char_p]
        self.pango.pango_font_description_free.argtypes = [ctypes.c_void_p]
        self.pango.pango_layout_set_font_description.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
        self.pango.pango_layout_set_text.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
        self.pango.pango_layout_get_pixel_size.argtypes = [
            ctypes.c_void_p, ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int),
        ]
        self.gobject.g_object_unref.argtypes = [ctypes.c_void_p]
        self.cr = None
        self.surface = None
        self._hold = None

    def bind(self, mem, width, height, stride):
        if self.cr:
            self.cairo.cairo_destroy(self.cr)
            self.cairo.cairo_surface_destroy(self.surface)
        self._hold = (ctypes.c_ubyte * (stride * height)).from_buffer(mem)
        self.surface = self.cairo.cairo_image_surface_create_for_data(
            ctypes.cast(self._hold, ctypes.c_void_p), 0, width, height, stride,
        )
        self.cr = self.cairo.cairo_create(self.surface)
        self.width = width
        self.height = height

    def frame(self, step):
        c = self.cairo
        cr = self.cr
        c.cairo_set_source_rgb(cr, *unit(BG))
        c.cairo_paint(cr)
        layout = self.pangocairo.pango_cairo_create_layout(cr)
        desc = self.pango.pango_font_description_from_string(b"DejaVu Sans 52")
        self.pango.pango_layout_set_font_description(layout, desc)
        self.pango.pango_font_description_free(desc)
        self.pango.pango_layout_set_text(layout, "Загрузка".encode(), -1)
        tw, th = ctypes.c_int(), ctypes.c_int()
        self.pango.pango_layout_get_pixel_size(layout, ctypes.byref(tw), ctypes.byref(th))
        c.cairo_set_source_rgb(cr, *unit(INK))
        c.cairo_move_to(cr, (self.width - tw.value) / 2, self.height / 2 - 160)
        self.pangocairo.pango_cairo_show_layout(cr, layout)
        self.gobject.g_object_unref(layout)
        cx = self.width / 2
        cy = self.height / 2 + 70
        for i, (dx, dy) in enumerate(SPOTS):
            lead = i == step
            c.cairo_set_source_rgb(cr, *(unit(HOT) if lead else unit(DIM)))
            c.cairo_arc(cr, cx + dx, cy + dy, 18 if lead else 12, 0, 6.28318530718)
            c.cairo_fill(cr)
        c.cairo_surface_flush(self.surface)


class Conn:
    def __init__(self):
        display = os.environ.get("WAYLAND_DISPLAY", "wayland-0")
        path = display if display.startswith("/") else os.path.join(
            os.environ["XDG_RUNTIME_DIR"], display
        )
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(path)
        self.buf = b""
        self.next_id = 1

    def alloc(self):
        self.next_id += 1
        return self.next_id

    def send(self, obj, opcode, payload=b"", fd=None):
        size = 8 + len(payload)
        msg = struct.pack("<IHH", obj, opcode, size) + payload
        if fd is None:
            self.sock.sendall(msg)
            return
        self.sock.sendmsg(
            [msg], [(socket.SOL_SOCKET, socket.SCM_RIGHTS, struct.pack("i", fd))]
        )

    def recv(self):
        while len(self.buf) < 8:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise EOFError("wayland closed")
            self.buf += chunk
        obj, opcode, size = struct.unpack_from("<IHH", self.buf, 0)
        while len(self.buf) < size:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise EOFError("wayland closed")
            self.buf += chunk
        body = self.buf[8:size]
        self.buf = self.buf[size:]
        return obj, opcode, body

    def roundtrip(self):
        token = self.alloc()
        self.send(1, 0, struct.pack("<I", token))
        while True:
            obj, opcode, body = self.recv()
            if obj == token and opcode == 0:
                return
            yield obj, opcode, body


def make_buffer(conn, shm, width, height):
    stride = width * 4
    size = stride * height
    fd = os.memfd_create("b8k-splash")
    os.ftruncate(fd, size)
    mem = mmap.mmap(fd, size)
    pool = conn.alloc()
    conn.send(shm, 0, struct.pack("<Ii", pool, size), fd)
    os.close(fd)
    buf_id = conn.alloc()
    conn.send(pool, 0, struct.pack("<IiiiiI", buf_id, 0, width, height, stride, FMT))
    return buf_id, mem, stride


def main():
    painter = Painter()
    conn = Conn()
    registry = conn.alloc()
    conn.send(1, 1, struct.pack("<I", registry))
    globals_ = {}
    for obj, opcode, body in conn.roundtrip():
        if obj == 1 and opcode == 0 and len(body) >= 8:
            message, _ = take_string(body, 8)
            raise RuntimeError(message)
        if obj == registry and opcode == 0 and len(body) >= 8:
            name = struct.unpack_from("<I", body, 0)[0]
            iface, off = take_string(body, 4)
            version = struct.unpack_from("<I", body, off)[0]
            globals_[iface] = (name, version)
    for iface in ("wl_compositor", "wl_shm", "zwlr_layer_shell_v1"):
        if iface not in globals_:
            raise RuntimeError("missing " + iface)
    comp = conn.alloc()
    cname, cver = globals_["wl_compositor"]
    conn.send(registry, 0, struct.pack("<I", cname) + put_string("wl_compositor") + struct.pack("<II", min(cver, 4), comp))
    shm = conn.alloc()
    sname, sver = globals_["wl_shm"]
    conn.send(registry, 0, struct.pack("<I", sname) + put_string("wl_shm") + struct.pack("<II", min(sver, 1), shm))
    shell = conn.alloc()
    lname, lver = globals_["zwlr_layer_shell_v1"]
    conn.send(registry, 0, struct.pack("<I", lname) + put_string("zwlr_layer_shell_v1") + struct.pack("<II", min(lver, 4), shell))
    surface = conn.alloc()
    conn.send(comp, 0, struct.pack("<I", surface))
    layer = conn.alloc()
    conn.send(
        shell, 0,
        struct.pack("<III", layer, surface, 0)
        + struct.pack("<I", LAYER_TOP)
        + put_string("b8k-splash"),
    )
    # Cover the area under the bar. Zone -1 uses the full output, then the
    # left margin keeps the panel free.
    conn.send(layer, 0, struct.pack("<II", 0, 0))
    conn.send(layer, 1, struct.pack("<I", ANCHOR_ALL))
    conn.send(layer, 2, struct.pack("<i", -1))
    conn.send(layer, 3, struct.pack("<iiii", 0, 0, 0, BAR))
    conn.send(surface, 6)
    serial = None
    width = height = 0
    deadline = time.monotonic() + 2
    conn.sock.settimeout(2)
    while serial is None:
        remain = deadline - time.monotonic()
        if remain <= 0:
            break
        conn.sock.settimeout(remain)
        obj, opcode, body = conn.recv()
        if obj == 1 and opcode == 0 and len(body) >= 8:
            message, _ = take_string(body, 8)
            raise RuntimeError(message)
        if obj == layer and opcode == 0 and len(body) >= 12:
            serial, width, height = struct.unpack_from("<III", body, 0)
        if obj == layer and opcode == 1:
            return 0
    if not serial or width < 100 or height < 100:
        raise RuntimeError("compositor gave no splash size")
    conn.send(layer, 6, struct.pack("<I", serial))
    buf_id, mem, stride = make_buffer(conn, shm, width, height)
    painter.bind(mem, width, height, stride)
    step = 0
    painter.frame(step)
    sys.stderr.write("b8k-splash %dx%d\n" % (width, height))
    sys.stderr.flush()
    conn.send(surface, 1, struct.pack("<Iii", buf_id, 0, 0))
    conn.send(surface, 2, struct.pack("<iiii", 0, 0, width, height))
    conn.send(surface, 6)
    for obj, opcode, body in conn.roundtrip():
        if obj == 1 and opcode == 0 and len(body) >= 8:
            message, _ = take_string(body, 8)
            raise RuntimeError(message)
        if obj == layer and opcode == 1:
            return 0
    while True:
        step = (step + 1) % DOTS
        painter.frame(step)
        conn.send(surface, 1, struct.pack("<Iii", buf_id, 0, 0))
        conn.send(surface, 2, struct.pack("<iiii", 0, max(0, height // 2 - 220), width, 460))
        conn.send(surface, 6)
        deadline = time.monotonic() + 0.28
        while True:
            remain = deadline - time.monotonic()
            if remain <= 0:
                break
            conn.sock.settimeout(remain)
            try:
                obj, opcode, body = conn.recv()
            except socket.timeout:
                break
            if obj == 1 and opcode == 0 and len(body) >= 8:
                message, _ = take_string(body, 8)
                raise RuntimeError(message)
            if obj == layer and opcode == 1:
                return 0
            if obj == layer and opcode == 0 and len(body) >= 12:
                serial, new_w, new_h = struct.unpack_from("<III", body, 0)
                conn.send(layer, 6, struct.pack("<I", serial))
                if (new_w, new_h) != (width, height) and new_w >= 100 and new_h >= 100:
                    width, height = new_w, new_h
                    buf_id, mem, stride = make_buffer(conn, shm, width, height)
                    painter.bind(mem, width, height, stride)
                    painter.frame(step)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, RuntimeError, EOFError, struct.error) as exc:
        sys.stderr.write("b8k-splash: %s\n" % exc)
        sys.exit(1)
