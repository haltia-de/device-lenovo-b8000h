#!/bin/sh
# On-screen keyboard. Keys are a step smaller than the first large layout.
# Shown only while a text field is focused.
# The bottom layer is arranged after the panel on the top layer, so the
# keyboard takes the width right of the panel. On the top layer it was
# arranged first, squeezed the panel to 440px and phoc looped on the
# resize, so the keyboard never appeared. Windows keep out of its zone,
# so nothing covers it.
exec /usr/local/bin/wvkbd-b8k \
	--auto --hidden --no-popup --wayland-layer bottom \
	-H 360 -L 360 -R 10 \
	--fn "Sans 28" \
	"$@"
