class Max(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="b8k.Max")
        self.win = None
        self.buzz = Buzz()
        self.backend = Backend(self)
        self.summaries = {}
        self.open_chat = None
        self.views = {}  # chat id -> built view, most recently used last
        self.view = None
        self.background = "--background" in sys.argv[1:]

    def do_activate(self):
        if self.win:
            self.win.present()
            return
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Gtk.Button()  # the "pressed" signal exists once the class is set up
        GObject.add_emission_hook(Gtk.Button, "pressed", self.buzz)

        self.win = Gtk.ApplicationWindow(application=self, title="MAX")
        self.win.set_default_size(1160, 800)
        # Closing only hides the window: messages keep coming in.
        self.win.connect("delete-event", lambda w, _e: w.hide() or True)
        bar = Gtk.HeaderBar()
        heading = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.title = label("MAX", "title", xalign=0.5)
        self.sub = label("", "sub", xalign=0.5)
        heading.pack_start(self.title, False, False, 0)
        heading.pack_start(self.sub, False, False, 0)
        bar.set_custom_title(heading)
        self.back = Gtk.Button(label="←")
        self.back.get_style_context().add_class("back")
        self.back.connect("clicked", lambda _b: self.show_list())
        self.back.set_no_show_all(True)
        bar.pack_start(self.back)
        self.win.set_titlebar(bar)

        self.stack = Gtk.Stack()
        self.win.add(self.stack)
        wait = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        wait.set_valign(Gtk.Align.CENTER)
        self.wait_text = label("Подключение к MAX…", "big", xalign=0.5)
        wait.pack_start(self.wait_text, False, False, 0)
        self.stack.add_named(wait, "wait")

        qr = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
        qr.set_valign(Gtk.Align.CENTER)
        qr.pack_start(label("Вход в MAX", "big", xalign=0.5), False, False, 0)
        self.qr_image = Gtk.Image()
        qr.pack_start(self.qr_image, False, False, 0)
        qr.pack_start(label("Откройте MAX на телефоне и отсканируйте этот код",
                            "hint", xalign=0.5), False, False, 0)
        self.stack.add_named(qr, "qr")

        self.list = Gtk.ListBox()
        self.list.set_selection_mode(Gtk.SelectionMode.NONE)
        self.list.connect("row-activated", self.on_row)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_kinetic_scrolling(True)
        scroll.add(self.list)
        self.stack.add_named(scroll, "chats")

        chat = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.msg_scroll = Gtk.ScrolledWindow()
        self.msg_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.msg_scroll.set_kinetic_scrolling(True)
        self.viewport = Gtk.Viewport()
        self.viewport.set_shadow_type(Gtk.ShadowType.NONE)
        self.msg_scroll.add(self.viewport)
        # Stay at the newest message while photos load and messages come in,
        # unless the reader has scrolled up to older ones.
        self.at_bottom = True
        adj = self.msg_scroll.get_vadjustment()
        adj.connect("changed", self.keep_bottom)
        adj.connect("value-changed", self.track_bottom)
        chat.pack_start(self.msg_scroll, True, True, 0)
        self.inputbar = Gtk.Box(spacing=10)
        self.inputbar.get_style_context().add_class("inputbar")
        self.entry = Gtk.Entry()
        self.entry.get_style_context().add_class("input")
        self.entry.set_placeholder_text("Сообщение")
        self.entry.connect("activate", lambda _e: self.send())
        self.sendb = Gtk.Button(label="Отправить")
        self.sendb.get_style_context().add_class("send")
        # The button must not take the focus from the entry: that hid the
        # keyboard, the window grew under the finger, and the tap was lost.
        self.sendb.set_can_focus(False)
        self.sendb.set_focus_on_click(False)
        self.sendb.connect("clicked", lambda _b: self.send())
        self.inputbar.pack_start(self.entry, True, True, 0)
        self.inputbar.pack_start(self.sendb, False, False, 0)
        chat.pack_start(self.inputbar, False, False, 0)
        self.stack.add_named(chat, "chat")

        # The last known list at once; the connection refreshes it.
        cached = load_list()
        if cached:
            self.summaries = {c["id"]: c for c in cached}
            self.fill_list()
            self.sub.set_text("подключение…")
        if self.background:
            # Started with the session: everything built, nothing on screen.
            self.background = False
            self.win.get_child().show_all()
            bar.show_all()
        else:
            self.win.show_all()
        self.stack.set_visible_child_name("chats" if cached else "wait")
        threading.Thread(target=prune_photos, daemon=True).start()
        self.backend.start()

    # called from the MAX thread through idle_add
    def show_qr(self, path):
        self.qr_image.set_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file(path))
        self.stack.set_visible_child_name("qr")
        self.win.present()  # a login needs the person, background or not
        return False

    def failed(self, why):
        self.wait_text.set_text("Нет связи с MAX.\n%s" % why[:120])
        self.stack.set_visible_child_name("wait")
        return False

    def show_chats(self, summaries):
        self.summaries = {s["id"]: s for s in summaries}
        save_list(summaries)
        self.fill_list()
        if self.open_chat is None:
            self.stack.set_visible_child_name("chats")
        return False

    def incoming(self, msg, summary):
        if summary:
            self.summaries[summary["id"]] = summary
        here = self.open_chat == msg["chat"] and self.win.is_visible()
        view = self.views.get(msg["chat"])
        if view and msg["id"] not in view.shown:
            self.add_bubble(view, msg)
            if here:
                self.scroll_down()
        if here and not msg["mine"] and self.win.is_active():
            self.backend.run(self.backend.read(msg["chat"], msg["id"]))
            self.summaries[msg["chat"]]["unread"] = 0
        if not msg["mine"]:
            self.buzz()
            if not here:
                GLib.timeout_add(180, lambda: self.buzz() and False)
        self.fill_list()
        return False

    # the list
    def fill_list(self):
        for child in self.list.get_children():
            self.list.remove(child)
        total = 0
        for s in sorted(self.summaries.values(), key=lambda s: -(s["time"] or 0)):
            total += s["unread"]
            row = Gtk.ListBoxRow()
            row.chat_id = s["id"]
            box = Gtk.Box(spacing=18)
            box.set_margin_start(16)
            box.set_margin_end(16)
            box.set_margin_top(10)
            box.set_margin_bottom(10)
            box.pack_start(initials_icon(s["title"], s["id"]), False, False, 0)
            mid = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            mid.set_valign(Gtk.Align.CENTER)
            mid.pack_start(label(s["title"], "chat-name", ellipsize=True), False, False, 0)
            mid.pack_start(label(s["last"], "chat-last", ellipsize=True), False, False, 0)
            box.pack_start(mid, True, True, 0)
            right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            right.set_valign(Gtk.Align.CENTER)
            right.pack_start(label(when(s["time"]), "chat-time", xalign=1.0), False, False, 0)
            if s["unread"]:
                badge = label(str(s["unread"]), "badge", xalign=0.5)
                badge.set_halign(Gtk.Align.END)
                right.pack_start(badge, False, False, 0)
            box.pack_end(right, False, False, 0)
            row.add(box)
            self.list.add(row)
        self.list.show_all()
        if self.open_chat is None:
            self.sub.set_text("непрочитанных: %d" % total if total else "")
        # The button counts people, not news: channels are left out.
        set_badge(sum(s["unread"] for s in self.summaries.values() if s.get("type") != "CHANNEL"))

    def on_row(self, _list, row):
        self.buzz()
        self.open(row.chat_id)

    def show_list(self):
        self.open_chat = None
        self.back.hide()
        self.title.set_text("MAX")
        self.fill_list()
        self.stack.set_visible_child_name("chats")

    # a chat
    def view_for(self, chat_id):
        """The built chat, from memory, else from the disk cache."""
        view = self.views.pop(chat_id, None)
        if view is None:
            view = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            view.set_margin_start(16)
            view.set_margin_end(16)
            view.set_margin_top(12)
            view.set_margin_bottom(12)
            view.chat_id = chat_id
            view.shown = set()
            view.last_day = None
            for m in cache_read(chat_id):
                self.add_bubble(view, m)
        self.views[chat_id] = view  # most recently used last
        while len(self.views) > VIEWS:
            old_id = next(iter(self.views))
            old = self.views.pop(old_id)
            if old is self.view:
                self.views[old_id] = old
                break
            old.destroy()
        return view

    def open(self, chat_id):
        s = self.summaries.get(chat_id, {})
        self.open_chat = chat_id
        view = self.view_for(chat_id)
        if self.view is not view:
            if self.view is not None:
                self.viewport.remove(self.view)
            self.viewport.add(view)
            self.view = view
        view.show_all()
        self.title.set_text(s.get("title", ""))
        self.sub.set_text("" if view.shown else "загрузка…")
        self.back.show()
        self.inputbar.set_visible(s.get("type") != "CHANNEL")
        self.stack.set_visible_child_name("chat")
        self.scroll_down()

        def done(msgs, err):
            if err:
                if self.open_chat == chat_id:
                    self.sub.set_text("" if view.shown else "не удалось загрузить")
                return
            latest = max((m["time"] for m in msgs if m["id"] in view.shown), default=0)
            for m in msgs or []:
                if m["id"] not in view.shown and m["time"] >= latest:
                    self.add_bubble(view, m)
            if self.open_chat == chat_id:
                self.sub.set_text("")
            if chat_id in self.summaries:
                self.summaries[chat_id]["unread"] = 0
                self.fill_list()

        self.backend.run(self.backend.history(chat_id), done)

    def add_bubble(self, view, m):
        view.shown.add(m["id"])
        day = datetime.fromtimestamp(m["time"] / 1000).date() if m["time"] else None
        if day and day != view.last_day:
            view.last_day = day
            sep = label(day_label(m["time"]), "day", xalign=0.5)
            sep.set_halign(Gtk.Align.CENTER)
            view.pack_start(sep, False, False, 6)
            sep.show()
        bubble = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        bubble.get_style_context().add_class("bubble")
        bubble.get_style_context().add_class("mine" if m["mine"] else "theirs")
        bubble.set_halign(Gtk.Align.END if m["mine"] else Gtk.Align.START)
        group = self.summaries.get(view.chat_id, {}).get("type") in ("CHAT", "CHANNEL")
        if group and not m["mine"] and m["who"]:
            bubble.pack_start(label(m["who"], "who"), False, False, 0)
        for url in m["photos"]:
            img = Gtk.Image.new_from_icon_name("image-x-generic", Gtk.IconSize.DIALOG)
            img.set_size_request(460, 200)
            bubble.pack_start(img, False, False, 0)
            load_photo(url, lambda pix, img=img: pix and (img.set_from_pixbuf(pix),
                                                          img.set_size_request(-1, -1)))
        if m["text"]:
            text = label(m["text"], "msg", wrap=True)
            text.set_max_width_chars(38)
            text.set_selectable(False)
            bubble.pack_start(text, False, False, 0)
        bubble.pack_start(label(when(m["time"], full=True), "when", xalign=1.0), False, False, 0)
        view.pack_start(bubble, False, False, 0)
        bubble.show_all()

    def keep_bottom(self, adj):
        if self.at_bottom:
            adj.set_value(adj.get_upper() - adj.get_page_size())

    def track_bottom(self, adj):
        self.at_bottom = adj.get_value() + adj.get_page_size() >= adj.get_upper() - 60

    def scroll_down(self):
        self.at_bottom = True
        adj = self.msg_scroll.get_vadjustment()
        adj.set_value(adj.get_upper() - adj.get_page_size())

    def send(self):
        text = self.entry.get_text().strip()
        chat_id = self.open_chat
        if not text or chat_id is None:
            return
        self.sendb.set_sensitive(False)

        def done(msg, err):
            self.sendb.set_sensitive(True)
            if err:
                self.sub.set_text("не отправлено, попробуйте ещё раз")
                return
            self.entry.set_text("")
            self.sub.set_text("")
            view = self.views.get(chat_id)
            if msg and view and msg["id"] not in view.shown:
                self.add_bubble(view, msg)
                self.scroll_down()
            s = self.summaries.get(chat_id)
            if s:
                s["last"], s["time"] = "Вы: " + text, int(time.time() * 1000)

        self.backend.run(self.backend.send(chat_id, text), done)


if __name__ == "__main__":
    Max().run(None)
