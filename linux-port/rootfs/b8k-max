# --- haptics, as in the other b8k programs --------------------------------
class Buzz:
    EVIOCSFF = 0x40000000 | (0x2C << 16) | (ord("E") << 8) | 0x80

    def __init__(self, ms=70):
        self.fd = -1
        try:
            for node in sorted(os.listdir("/sys/class/input")):
                if not node.startswith("event"):
                    continue
                with open("/sys/class/input/%s/device/name" % node) as fh:
                    if fh.read().strip() != "regulator-haptic":
                        continue
                self.fd = os.open("/dev/input/" + node, os.O_RDWR | os.O_CLOEXEC)
                buf = bytearray(struct.pack("<HhHHHHHHH", 0x50, -1, 0, 0, 0, ms, 0,
                                            0xFFFF, 0xFFFF) + bytes(32))
                fcntl.ioctl(self.fd, self.EVIOCSFF, buf)
                self.effect = struct.unpack_from("<h", buf, 2)[0]
                break
        except OSError:
            self.fd = -1

    def __call__(self, *_args):
        if self.fd >= 0:
            try:
                os.write(self.fd, struct.pack("<llHHi", 0, 0, 0x15, self.effect, 1))
            except OSError:
                pass
        return True


# --- small helpers ----------------------------------------------------------
def kind(value):
    """An enum or a string, as a plain upper-case string."""
    value = getattr(value, "value", value)
    return str(value or "").upper()


def when(ms, full=False):
    if not ms:
        return ""
    t = datetime.fromtimestamp(ms / 1000)
    if t.date() == date.today() and not full:
        return t.strftime("%-H:%M")
    if full:
        return t.strftime("%-H:%M")
    return "%d %s" % (t.day, MONTHS[t.month - 1])


def day_label(ms):
    d = datetime.fromtimestamp(ms / 1000).date()
    delta = (date.today() - d).days
    if delta == 0:
        return "Сегодня"
    if delta == 1:
        return "Вчера"
    return "%d %s" % (d.day, MONTHS[d.month - 1])


def label(text, cls, xalign=0.0, wrap=False, ellipsize=False):
    lab = Gtk.Label(label=text, xalign=xalign)
    lab.get_style_context().add_class(cls)
    if wrap:
        lab.set_line_wrap(True)
        lab.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
    if ellipsize:
        lab.set_ellipsize(Pango.EllipsizeMode.END)
        lab.set_single_line_mode(True)
    return lab


def initials_icon(name, key, size=64):
    area = Gtk.DrawingArea()
    area.set_size_request(size, size)
    letters = "".join(w[0] for w in (name or "?").split()[:2]).upper() or "?"
    colour = COLOURS[int(key) % len(COLOURS)]

    def draw(_w, cr):
        cr.set_source_rgb(*colour)
        cr.arc(size / 2, size / 2, size / 2, 0, 6.2832)
        cr.fill()
        cr.set_source_rgb(1, 1, 1)
        cr.select_font_face("Sans", 0, 1)
        cr.set_font_size(size * 0.38)
        ext = cr.text_extents(letters)
        cr.move_to((size - ext.width) / 2 - ext.x_bearing, (size - ext.height) / 2 - ext.y_bearing)
        cr.show_text(letters)
        return False

    area.connect("draw", draw)
    return area


def user_name(user):
    for n in getattr(user, "names", None) or []:
        full = getattr(n, "name", None) or " ".join(
            x for x in (getattr(n, "first_name", None), getattr(n, "last_name", None)) if x)
        if full:
            return full
    return "Пользователь %s" % getattr(user, "id", "")


def attach_summary(a):
    """(what, photo url or None) for one attachment."""
    t = kind(getattr(a, "type", ""))
    if t == "PHOTO":
        return "", getattr(a, "base_url", None)
    names = {"VIDEO": "видео", "AUDIO": "голосовое сообщение", "FILE": "файл",
             "STICKER": "стикер", "CONTACT": "контакт", "POLL": "опрос", "CALL": "звонок",
             "SHARE": "ссылка"}
    if t == "FILE" and getattr(a, "name", None):
        return "файл «%s»" % a.name, None
    return names.get(t, ""), None


# --- MAX, in its own thread -------------------------------------------------
class Backend:
    def __init__(self, ui):
        self.ui = ui
        self.loop = None
        self.client = None
        self.me = None
        self.names = {}
        self.chats = {}

    def start(self):
        threading.Thread(target=self._thread, daemon=True).start()

    def _thread(self):
        self.loop = asyncio.new_event_loop()
        asyncio.set_event_loop(self.loop)
        try:
            self.loop.run_until_complete(self._main())
        except Exception as exc:  # the client gave up for good
            GLib.idle_add(self.ui.failed, repr(exc))

    def run(self, coro, done=None):
        """Run a coroutine in the MAX thread; done(result, error) in the window's."""
        if not self.loop:
            return
        fut = asyncio.run_coroutine_threadsafe(coro, self.loop)
        if done:
            def back(f):
                try:
                    res, err = f.result(), None
                except Exception as exc:
                    res, err = None, exc
                GLib.idle_add(lambda: done(res, err) and False)
            fut.add_done_callback(back)

    async def _main(self):
        from pymax import WebClient
        from pymax.config import ExtraConfig

        os.makedirs(DATA, mode=0o700, exist_ok=True)
        self.client = WebClient(session_name="web.db", work_dir=DATA,
                                extra_config=ExtraConfig(telemetry=False, log_level="WARNING",
                                                         reconnect_delay=3.0),
                                qr_provider=self)
        self.client.on_start()(self._started)
        self.client.on_message()(self._message)
        await self.client.start()

    # QrHandler for PyMax
    async def show_qr(self, qr_url):
        import qrcode

        path = os.path.join(DATA, "qr.png")
        qrcode.make(qr_url, box_size=12, border=2).save(path)
        GLib.idle_add(self.ui.show_qr, path)

    async def _started(self, client):
        try:
            os.chmod(os.path.join(DATA, "web.db"), 0o600)
            os.remove(os.path.join(DATA, "qr.png"))
        except OSError:
            pass
        self.me = client.me.contact.id if client.me else None
        if self.me and client.me:
            self.names[self.me] = user_name(client.me.contact)
        # On a reconnect the sync only brings chats that changed since the
        # last one, so page through the whole list as well.
        found = {c.id: c for c in client.chats or []}
        marker = None
        for _page in range(5):
            try:
                page = await client._app.api.chats.fetch_chats(marker)
            except Exception:
                break
            fresh = [c for c in page if c.id not in found]
            for c in page:
                found.setdefault(c.id, c)
            if not page or not fresh:
                break
            marker = min(c.last_event_time for c in page if c.last_event_time) - 1
        chats = list(found.values())
        self.chats = found
        want = set()
        for c in chats:
            if kind(c.type) == "DIALOG":
                want.update(u for u in c.participants if u != self.me)
        await self.lookup(want)
        GLib.idle_add(self.ui.show_chats, [self.summary(c) for c in chats])

    async def lookup(self, ids):
        ids = [i for i in ids if i and i not in self.names]
        for k in range(0, len(ids), 50):
            try:
                users = await self.client._app.api.users.get_users(ids[k:k + 50])
            except Exception:
                continue
            for u in users or []:
                if u:
                    self.names[u.id] = user_name(u)

    def title(self, chat):
        if chat.title:
            return chat.title
        if kind(chat.type) == "DIALOG":
            others = [u for u in chat.participants if u != self.me]
            if not others:
                return "Избранное"
            return self.names.get(others[0], "Собеседник")
        return "Чат"

    def preview(self, msg):
        if not msg:
            return ""
        text = (msg.text or "").replace("\n", " ")
        if not text:
            parts = [attach_summary(a)[0] or "фото" for a in msg.attaches or []]
            text = ", ".join(p for p in parts if p).capitalize()
        if msg.sender == self.me and self.me:
            text = "Вы: " + text
        return text

    def summary(self, chat):
        last = chat.last_message
        return {"id": chat.id, "title": self.title(chat), "type": kind(chat.type),
                "last": self.preview(last), "time": (last.time if last else 0) or chat.last_event_time,
                "unread": chat.new_messages or 0}

    def message(self, msg):
        texts, photos = [], []
        for a in msg.attaches or []:
            what, url = attach_summary(a)
            if url:
                photos.append(url)
            elif what:
                texts.append("[%s]" % what)
        body = msg.text or ""
        if texts:
            body = (body + "\n" if body else "") + " ".join(texts)
        return {"id": msg.id, "chat": msg.chat_id, "sender": msg.sender,
                "who": self.names.get(msg.sender, ""), "text": body, "photos": photos,
                "time": msg.time, "mine": bool(self.me) and msg.sender == self.me}

    async def history(self, chat_id):
        chat = self.chats.get(chat_id)
        if not chat:
            return []
        msgs = await chat.history(backward=HISTORY)
        await self.lookup({m.sender for m in msgs})
        msgs.sort(key=lambda m: m.time)
        if msgs:
            try:
                await self.client._app.api.messages.read_message(msgs[-1].id, chat_id)
                chat.new_messages = 0
            except Exception:
                pass
        return [self.message(m) for m in msgs]

    async def send(self, chat_id, text):
        msg = await self.client._app.api.messages.send_message(chat_id, text)
        return self.message(msg) if msg else None

    async def read(self, chat_id, msg_id):
        await self.client._app.api.messages.read_message(msg_id, chat_id)

    async def _message(self, msg, _client):
        await self.lookup({msg.sender})
        chat = self.chats.get(msg.chat_id)
        if chat is not None:
            chat.last_message = msg
            if msg.sender != self.me:
                chat.new_messages = (chat.new_messages or 0) + 1
        GLib.idle_add(self.ui.incoming, self.message(msg),
                      self.summary(chat) if chat is not None else None)


def photo_ok(url):
    parts = urllib.parse.urlsplit(url or "")
    host = (parts.hostname or "").lower()
    return parts.scheme == "https" and any(host == h or host.endswith("." + h)
                                           for h in PHOTO_HOSTS)


class PhotoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if not photo_ok(newurl):
            return None  # urllib then raises: no hop off MAX's CDN
        return super().redirect_request(req, fp, code, msg, headers, newurl)


PHOTO_OPENER = urllib.request.build_opener(PhotoRedirect)


def prune_photos():
    limit = time.time() - PHOTO_DAYS * 86400
    try:
        for name in os.listdir(PHOTOS):
            path = os.path.join(PHOTOS, name)
            if os.path.getmtime(path) < limit:
                os.remove(path)
    except OSError:
        pass


def load_photo(url, done):
    """Download one photo in a thread (cached by URL) and hand back a pixbuf."""
    if not photo_ok(url):
        return
    os.makedirs(PHOTOS, mode=0o700, exist_ok=True)
    path = os.path.join(PHOTOS, hashlib.sha1(url.encode()).hexdigest()[:20] + ".img")

    def work():
        try:
            if not os.path.exists(path):
                req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
                with PHOTO_OPENER.open(req, timeout=20) as fh:
                    data = fh.read(8 * 1024 * 1024)
                with open(path + ".new", "wb") as out:
                    out.write(data)
                os.replace(path + ".new", path)
            pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 460, 460, True)
        except Exception:
            pix = None
        GLib.idle_add(lambda: done(pix) and False)

    threading.Thread(target=work, daemon=True).start()


