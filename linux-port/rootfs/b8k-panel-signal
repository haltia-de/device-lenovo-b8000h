"""b8k-panel-signal N: make the panel refresh the modules on signal N now.

Sends SIGRTMIN+N to the panel (the process running the real
/usr/bin/waybar), but only once it catches that signal: an uncaught
real-time signal would kill the bar, and the whole session with it. Used
by root helpers (NetworkManager's dispatcher, b8k-suspend, b8k-netwatch)
so the Wi-Fi icon follows the network at once instead of at its next poll.
"""
import os
import signal
import sys


def catches(pid, signum):
    try:
        with open("/proc/%d/status" % pid) as fh:
            for line in fh:
                if line.startswith("SigCgt:"):
                    return bool(int(line.split()[1], 16) >> (signum - 1) & 1)
    except (OSError, ValueError):
        pass
    return False


def main():
    try:
        n = int(sys.argv[1])
    except (IndexError, ValueError):
        sys.stderr.write("usage: b8k-panel-signal N\n")
        return 2
    signum = signal.SIGRTMIN + n
    if n <= 0 or signum > signal.SIGRTMAX:
        return 2
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        pid = int(name)
        try:
            if os.readlink("/proc/%d/exe" % pid) != "/usr/bin/waybar":
                continue
        except OSError:
            continue
        if catches(pid, signum):
            try:
                os.kill(pid, signum)
            except OSError:
                pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
