{
  "layer": "top",
  "position": "left",
  "width": 120,
  "spacing": 4,
  "modules-left": [
    "custom/home",
    "custom/firefox",
    "custom/max"
  ],
  "modules-right": [
    "group/system",
    "custom/battery",
    "custom/clock",
    "custom/hide"
  ],
  "custom/home": {
    "exec": "/usr/local/bin/b8k-meter home",
    "return-type": "json",
    "format": "{text}",
    "signal": 8,
    "exec-on-event": false,
    "on-click-release": "/usr/local/bin/b8k-press home 8; /usr/local/bin/b8k-home toggle",
    "tooltip": false
  },
  "custom/firefox": {
    "exec": "/usr/local/bin/b8k-launch status firefox",
    "return-type": "json",
    "format": "{text}",
    "signal": 1,
    "exec-on-event": false,
    "on-click-release": "/usr/local/bin/b8k-press firefox 1; /usr/local/bin/b8k-launch tap firefox",
    "tooltip": false
  },
  "custom/calc": {
    "exec": "/usr/local/bin/b8k-launch status calc",
    "return-type": "json",
    "format": "{text}",
    "signal": 2,
    "exec-on-event": false,
    "on-click-release": "/usr/local/bin/b8k-press calc 2; /usr/local/bin/b8k-launch tap calc",
    "tooltip": false
  },
  "custom/weather": {
    "exec": "/usr/local/bin/b8k-launch status weather",
    "return-type": "json",
    "format": "{text}",
    "signal": 5,
    "exec-on-event": false,
    "on-click-release": "/usr/local/bin/b8k-press weather 5; /usr/local/bin/b8k-launch tap weather",
    "tooltip": false
  },
  "custom/news": {
    "exec": "/usr/local/bin/b8k-launch status news",
    "return-type": "json",
    "format": "{text}",
    "signal": 6,
    "exec-on-event": false,
    "on-click-release": "/usr/local/bin/b8k-press news 6; /usr/local/bin/b8k-launch tap news",
    "tooltip": false
  },
  "custom/max": {
    "exec": "/usr/local/bin/b8k-launch status max",
    "return-type": "json",
    "format": "{text}",
    "signal": 7,
    "exec-on-event": false,
    "on-click-release": "/usr/local/bin/b8k-press max 7; /usr/local/bin/b8k-launch tap max",
    "tooltip": false
  },
  "custom/paint": {
    "exec": "/usr/local/bin/b8k-launch status paint",
    "return-type": "json",
    "format": "{text}",
    "signal": 4,
    "exec-on-event": false,
    "on-click-release": "/usr/local/bin/b8k-press paint 4; /usr/local/bin/b8k-launch tap paint",
    "tooltip": false
  },
  "custom/cards": {
    "exec": "/usr/local/bin/b8k-launch status cards",
    "return-type": "json",
    "format": "{text}",
    "signal": 3,
    "exec-on-event": false,
    "on-click-release": "/usr/local/bin/b8k-press cards 3; /usr/local/bin/b8k-launch tap cards",
    "tooltip": false
  },
  "group/system": {
    "orientation": "vertical",
    "drawer": {
      "click-to-reveal": true,
      "transition-duration": 250,
      "transition-left-to-right": true,
      "children-class": "drawer-child"
    },
    "modules": [
      "custom/system",
      "custom/brightness",
      "custom/volume",
      "custom/wifi3"
    ]
  },
  "custom/system": {
    "exec": "/usr/local/bin/b8k-meter system",
    "return-type": "json",
    "format": "{text}",
    "signal": 10,
    "interval": 30,
    "exec-on-event": false,
    "on-click-release": "/usr/local/bin/b8k-meter toggle; /usr/local/bin/b8k-press system 10",
    "tooltip": false
  },
  "custom/brightness": {
    "exec": "/usr/local/bin/b8k-meter brightness",
    "return-type": "json",
    "format": "{text}",
    "signal": 9,
    "exec-on-event": false,
    "on-click-release": "/usr/local/bin/b8k-press brightness 9; /usr/local/bin/b8k-brightness",
    "tooltip": false
  },
  "custom/volume": {
    "exec": "/usr/local/bin/b8k-meter volume",
    "return-type": "json",
    "format": "{text}",
    "signal": 10,
    "interval": 60,
    "exec-on-event": true,
    "on-click-release": "/usr/local/bin/b8k-press volume 10; pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip": false
  },
  "custom/wifi3": {
    "exec": "/usr/local/bin/b8k-meter wifi",
    "return-type": "json",
    "format": "{text}",
    "interval": 30,
    "exec-on-event": false,
    "on-click-release": "/usr/local/bin/b8k-press wifi 10; /usr/local/bin/b8k-launch tap settings",
    "tooltip": false,
    "signal": 10
  },
  "custom/battery": {
    "exec": "/usr/local/bin/b8k-meter battery",
    "return-type": "json",
    "format": "{text}",
    "interval": 30,
    "exec-on-event": false,
    "tooltip": false,
    "signal": 11
  },
  "custom/clock": {
    "exec": "/usr/local/bin/b8k-clock",
    "return-type": "json",
    "format": "{text}",
    "interval": 15,
    "exec-on-event": false,
    "on-click-release": "/usr/local/bin/b8k-press clock; /usr/local/bin/b8k-launch tap calendar",
    "tooltip": false,
    "align": 0.5,
    "justify": "center"
  },
  "custom/hide": {
    "exec": "/usr/local/bin/b8k-meter hide",
    "return-type": "json",
    "format": "{text}",
    "exec-on-event": false,
    "on-click-release": "/usr/local/bin/b8k-press hide 0; /usr/local/bin/b8k-ask hide",
    "tooltip": false
  }
}
