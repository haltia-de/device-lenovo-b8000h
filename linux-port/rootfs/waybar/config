{
  "layer": "top",
  "position": "top",
  "height": 96,
  "spacing": 4,
  "modules-left": [
    "custom/firefox",
    "custom/calc",
    "custom/weather",
    "custom/news",
    "custom/max",
    "custom/term"
  ],
  "modules-right": ["custom/volume", "custom/wifi3", "custom/battery", "custom/clock"],
  "custom/firefox": {
    "exec": "/usr/local/bin/b8k-launch status firefox",
    "return-type": "json",
    "format": "{text}",
    "signal": 1,
    "exec-on-event": false,
    "on-click": "/usr/local/bin/b8k-launch tap firefox",
    "tooltip": false
  },
  "custom/calc": {
    "exec": "/usr/local/bin/b8k-launch status calc",
    "return-type": "json",
    "format": "{text}",
    "signal": 2,
    "exec-on-event": false,
    "on-click": "/usr/local/bin/b8k-launch tap calc",
    "tooltip": false
  },
  "custom/weather": {
    "exec": "/usr/local/bin/b8k-launch status weather",
    "return-type": "json",
    "format": "{text}",
    "signal": 5,
    "exec-on-event": false,
    "on-click": "/usr/local/bin/b8k-launch tap weather",
    "tooltip": false
  },
  "custom/news": {
    "exec": "/usr/local/bin/b8k-launch status news",
    "return-type": "json",
    "format": "{text}",
    "signal": 6,
    "exec-on-event": false,
    "on-click": "/usr/local/bin/b8k-launch tap news",
    "tooltip": false
  },
  "custom/max": {
    "exec": "/usr/local/bin/b8k-launch status max",
    "return-type": "json",
    "format": "{text}",
    "signal": 7,
    "exec-on-event": false,
    "on-click": "/usr/local/bin/b8k-launch tap max",
    "tooltip": false
  },
  "custom/term": {
    "exec": "/usr/local/bin/b8k-launch status term",
    "return-type": "json",
    "format": "{text}",
    "signal": 3,
    "exec-on-event": false,
    "on-click": "/usr/local/bin/b8k-launch tap term",
    "tooltip": false
  },
  "custom/volume": {
    "exec": "/usr/local/bin/b8k-meter volume",
    "return-type": "json",
    "format": "{text}",
    "signal": 8,
    "interval": 60,
    "exec-on-event": true,
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip": false
  },
  "custom/wifi3": {
    "exec": "/usr/local/bin/b8k-meter wifi",
    "return-type": "json",
    "format": "{text}",
    "interval": 10,
    "exec-on-event": false,
    "on-click": "/usr/local/bin/b8k-launch tap settings",
    "tooltip": false
  },
  "custom/battery": {
    "exec": "/usr/local/bin/b8k-meter battery",
    "return-type": "json",
    "format": "{text}",
    "interval": 15,
    "exec-on-event": false,
    "on-click": "/usr/local/bin/b8k-ask power",
    "tooltip": false
  },
  "custom/clock": {
    "exec": "/usr/local/bin/b8k-clock",
    "return-type": "json",
    "format": "{text}",
    "interval": 15,
    "exec-on-event": false,
    "tooltip": false,
    "align": 0.5,
    "justify": "center"
  }
}
