"""Volume keys: 5% up or down on the PulseAudio default sink.

Phosh used to handle the keys; phoc alone ignores them, so the sound could
be muted at 0% with no way back. Runs in the session as the user, who is
in the input group. The keypad is only read, not grabbed.
"""
import os
import signal
import struct
import subprocess
import sys
import time

KEY_VOLUMEDOWN = 114
KEY_VOLUMEUP = 115
EV_KEY = 1
EVENT = struct.Struct("llHHi")  # struct input_event on 32-bit ARM
STEP = 5  # percent; up stops at 100, past which PulseAudio would overdrive


def find_keypad():
    for node in sorted(os.listdir("/sys/class/input")):
        if not node.startswith("event"):
            continue
        try:
            with open("/sys/class/input/%s/device/capabilities/key" % node) as fh:
                words = fh.read().split()
        except OSError:
            continue
        # A hex bitmap of key codes, lowest word last, one long per word.
        bits = 0
        for i, word in enumerate(reversed(words)):
            bits |= int(word, 16) << (32 * i)
        if bits >> KEY_VOLUMEUP & 1 and bits >> KEY_VOLUMEDOWN & 1:
            return "/dev/input/" + node
    return None


def pactl(*args):
    subprocess.call(["pactl"] + list(args), stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL)


def volume():
    # Current default-sink volume in percent, rounded to the step grid.
    out = subprocess.run(["pactl", "get-sink-volume", "@DEFAULT_SINK@"],
                         capture_output=True, text=True).stdout
    try:
        pct = int(out.split("/")[1].strip().rstrip("%"))
    except (IndexError, ValueError):
        return 50
    return int(round(pct / STEP)) * STEP


def refresh_bar():
    # The volume in the drawer and the handle (a muted speaker) listen on
    # SIGRTMIN+10. Signal only a bar that catches it: an uncaught real-time
    # signal would kill the bar.
    signum = signal.SIGRTMIN + 10
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open("/proc/%s/comm" % pid) as fh:
                if fh.read().strip() != "waybar":
                    continue
            with open("/proc/%s/status" % pid) as fh:
                cgt = next(l for l in fh if l.startswith("SigCgt:"))
            if int(cgt.split()[1], 16) >> (signum - 1) & 1:
                os.kill(int(pid), signum)
        except (OSError, StopIteration, ValueError):
            pass


def main():
    path = find_keypad()
    if not path:
        sys.exit("b8k-volume: no device with volume keys")
    with open(path, "rb", buffering=0) as dev:
        while True:
            data = dev.read(EVENT.size)
            if len(data) < EVENT.size:
                time.sleep(1)
                continue
            _sec, _usec, etype, code, value = EVENT.unpack(data)
            # 1 is a press, 2 an autorepeat while the key is held.
            if etype != EV_KEY or value not in (1, 2):
                continue
            if code == KEY_VOLUMEUP:
                pactl("set-sink-mute", "@DEFAULT_SINK@", "0")
                pactl("set-sink-volume", "@DEFAULT_SINK@",
                      "%d%%" % min(100, volume() + STEP))
            elif code == KEY_VOLUMEDOWN:
                pactl("set-sink-volume", "@DEFAULT_SINK@",
                      "%d%%" % max(0, volume() - STEP))
            else:
                continue
            refresh_bar()


if __name__ == "__main__":
    main()
