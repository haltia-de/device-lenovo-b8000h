#!/bin/sh
# Program buttons, a Wi-Fi icon, a battery icon and a clock.
# A tap on Wi-Fi opens Settings. A tap on the battery opens the power menu.
# One window watcher updates a button only when its state changes.
# The keyboard stays hidden until a text field is focused.
run=${XDG_RUNTIME_DIR:-$HOME/.cache}
mkdir -p "$run"
# A new panel starts with its drawer closed (b8k-meter).
rm -f "$run"/b8k-drawer-open
# No screen reader runs here. Without these GTK starts the at-spi bus and
# its registry for every session.
export NO_AT_BRIDGE=1 GTK_A11Y=none
# The shell's GTK theme (themes/b8k): tall headers with room for «✕», large
# questions. A program with a theme of its own (env= in apps.conf) keeps it.
if [ -f /usr/share/themes/b8k/gtk-3.0/gtk.css ]; then
	export GTK_THEME=b8k
fi
# The programs and the panel as set in ~/.config/b8k (b8k-apps): the
# session's apps.conf, read by everything started below, and the panel's
# config and style. Without them, the built-in ones.
panel=
rm -f "$run"/b8k/apps.conf
if [ -x /usr/local/bin/b8k-apps ] && /usr/local/bin/b8k-apps >"$run"/b8k-apps.log 2>&1 &&
	[ -s "$run"/b8k/waybar.json ] && [ -s "$run"/b8k/style.css ]; then
	panel=yes
fi
# The home screen: every program as a tile, on the background layer right
# of the panel; the panel's home button raises it over the windows.
if [ -x /usr/local/bin/b8k-home ]; then
	setsid /usr/local/bin/b8k-home >"$run"/b8k-home.log 2>&1 &
fi
# The "✕" in the top right corner that closes the program in front.
if [ -x /usr/local/bin/b8k-close ]; then
	setsid /usr/local/bin/b8k-close >"$run"/b8k-close.log 2>&1 &
fi
# The brightness chosen last time (b8k-brightness keeps it).
/usr/local/bin/b8k-brightness --restore >"$run"/b8k-brightness.log 2>&1
# Settings starts through D-Bus activation and takes the bus environment.
dbus-update-activation-environment NO_AT_BRIDGE GTK_A11Y ${GTK_THEME:+GTK_THEME} 2>/dev/null
# Volume keys. Without this nothing handles them, and a muted sink at 0%
# has no way back.
if [ -x /usr/local/bin/b8k-volume ]; then
	setsid /usr/local/bin/b8k-volume >"$run"/b8k-volume.log 2>&1 &
fi
if [ -x /usr/local/bin/b8k-focus ]; then
	setsid /usr/local/bin/b8k-focus watch >"$run"/b8k-focus-watch.log 2>&1 &
fi
# Notifications (org.freedesktop.Notifications): large cards at the top
# that buzz once; a tap opens what they are about.
if command -v mako >/dev/null && ! pgrep -x -u "$(id -u)" mako >/dev/null; then
	setsid mako -c /usr/local/share/b8k/mako.conf >"$run"/mako.log 2>&1 &
fi
# Counts on buttons from programs' Unity LauncherEntry signals.
if [ -x /usr/local/bin/b8k-badges ]; then
	setsid /usr/local/bin/b8k-badges >"$run"/b8k-badges.log 2>&1 &
fi
# Wi-Fi passwords: NetworkManager asks a secret agent, which GNOME keeps
# in its shell. Without one, a tap on a protected network in Settings
# does nothing. The session restarts with waybar; one agent is enough.
if command -v nm-applet >/dev/null && ! pgrep -x -u "$(id -u)" nm-applet >/dev/null; then
	setsid nm-applet >"$run"/nm-applet.log 2>&1 &
fi
# MAX lives in the background: messages buzz and the button counts them
# with no window open. (Until MAX brings an XDG autostart file of its own.)
if [ -x /usr/local/bin/b8k-max ] && [ -s "$HOME/.local/share/b8k-max/web.db" ] &&
	[ ! -e /etc/xdg/autostart/io.github.trudenboy.Max.desktop ]; then
	setsid /usr/local/bin/b8k-max --background >"$run"/b8k-max.log 2>&1 &
fi
# Programs started in the background the standard way: XDG autostart
# entries marked X-B8K-Autostart=true, and one's own ~/.config/autostart.
if [ -x /usr/local/bin/b8k-apps ]; then
	/usr/local/bin/b8k-apps autostart >"$run"/b8k-autostart.log 2>&1
fi
if [ -x /usr/local/bin/b8k-keyboard ]; then
	pidof wvkbd-b8k >/dev/null 2>&1 || \
		/usr/local/bin/b8k-keyboard >"$run"/b8k-keyboard.log 2>&1 &
elif [ -x /usr/bin/squeekboard ]; then
	squeekboard >"$run"/squeekboard.log 2>&1 &
fi
# Firefox starts only from its button: running without a window it held
# 300-500 MB, and once its WebExtensions process filled the swap and froze
# the session.
if [ -n "$panel" ]; then
	exec waybar -c "$run"/b8k/waybar.json -s "$run"/b8k/style.css
fi
exec waybar
