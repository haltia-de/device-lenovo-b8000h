#!/bin/sh
# Large questions: the power menu (a one-second hold of the power key) and
# "close this program?" (a tap on the program already in front).
#
#   b8k-ask power
#   b8k-ask close <id>
#   b8k-ask close-webapp <id>
#   b8k-ask close-front       (the "✕" of b8k-close: the window in front)
#   b8k-ask pin <id>          (a long press on a home screen tile)
#   b8k-ask hide              (the panel's "‹": hiding it is asked first, as
#                             a hidden panel is easily lost by accident)
#
# The question is a fuzzel menu (C, Wayland only) on the overlay layer: it
# shows in about 0.3 s, where the GTK version in Python took 2.3 s, and it
# is always on top, so nothing has to raise it. fuzzel takes taps as well
# as keys. A choice buzzes like the panel (b8k-press without a signal).
set -u
run=${XDG_RUNTIME_DIR:-$HOME/.cache}
APPS=/usr/local/share/b8k/apps.conf
[ -f "$run/b8k/apps.conf" ] && APPS="$run/b8k/apps.conf"

# One question at a time; a second tap while one is open does nothing.
exec 9>"$run/b8k-ask.lock" || exit 1
flock -n 9 || exit 0

# A value of one section of apps.conf.
conf() {
	awk -v sec="[$1]" -v key="$2" '
		/^\[/ { inside = ($0 == sec); next }
		inside && $0 ~ "^" key "[ \t]*=" {
			sub("^[^=]*=[ \t]*", ""); print; exit
		}' "$APPS"
}

# ask TITLE ITEM... -- prints the index of the chosen item, nothing on cancel.
# The last item, Отмена, is the one highlighted, so Enter never does harm.
ask() {
	title=$1
	shift
	printf '%s\n' "$@" | fuzzel --config /usr/local/share/b8k/fuzzel-ask.ini \
		--dmenu --index --mesg "$title" --cache /dev/null --select-index $(($# - 1)) 2>/dev/null
}

chosen() {
	/usr/local/bin/b8k-press ask >/dev/null 2>&1
}

case ${1:-} in
power)
	# The USB port is a device until switched to host for a keyboard
	# (b8k-usb): the item offers the other role.
	usb=
	for f in /sys/class/usb_role/*/role; do [ -r "$f" ] && read -r usb <"$f"; done
	case $usb in
	host) usb_item="USB: компьютер" usb_to=device ;;
	*) usb_item="USB: клавиатура" usb_to=host ;;
	esac
	case $(ask "Питание" "Выключить" "Перезагрузить" "Терминал" "$usb_item" "Отмена") in
	0) chosen; doas -n /usr/local/sbin/b8k-poweroff off ;;
	1) chosen; doas -n /usr/local/sbin/b8k-poweroff reboot ;;
	2) chosen; /usr/local/bin/b8k-launch start term ;;
	3) chosen; doas -n /usr/local/sbin/b8k-usb "$usb_to" ;;
	esac
	;;
close | close-webapp)
	id=${2:-}
	[ -n "$id" ] || exit 2
	label=$(conf "$id" label)
	[ "$(ask "Закрыть «${label:-$id}»?" "Закрыть" "Отмена")" = 0 ] || exit 0
	chosen
	if [ "$1" = close-webapp ]; then
		/usr/local/bin/b8k-focus close-webapp "$id"
	else
		ids=$(conf "$id" app_ids)
		# shellcheck disable=SC2086 # the app_ids are separate words
		/usr/local/bin/b8k-focus close ${ids:-$id}
	fi
	;;
close-front)
	# A program still starting under its curtain is stopped at once: there
	# is nothing of it to lose yet.
	if read -r sid spid cpid <"$run/b8k-launch/starting" 2>/dev/null; then
		rm -f "$run/b8k-launch/starting"
		kill "$spid" "$cpid" 2>/dev/null
		/usr/local/bin/b8k-close update 2>/dev/null
		exit 0
	fi
	# The window in front by its app id; its program's label when one of
	# apps.conf has that app id.
	app=$(cat "$run/b8k-launch/front" 2>/dev/null)
	[ -n "$app" ] || exit 0
	id=$(awk -v app="$app" '
		/^\[/ { sec = $0; gsub(/[][ \t]/, "", sec); next }
		/^[ \t]*app_ids[ \t]*=/ {
			v = $0; sub(/^[^=]*=/, "", v); n = split(v, a, " ")
			for (i = 1; i <= n; i++) if (a[i] == app) { print sec; exit }
		}' "$APPS")
	label=
	[ -n "$id" ] && label=$(conf "$id" label)
	[ "$(ask "Закрыть «${label:-$app}»?" "Закрыть" "Отмена")" = 0 ] || exit 0
	chosen
	/usr/local/bin/b8k-focus close "$app"
	;;
hide)
	[ "$(ask "Спрятать панель? Вернуть — касанием «›» внизу слева" "Спрятать" "Отмена")" = 0 ] || exit 0
	chosen
	exec /usr/local/bin/b8k-tab
	;;
pin)
	id=${2:-}
	[ -n "$id" ] || exit 2
	label=$(conf "$id" label)
	sig=$(conf "$id" signal)
	if [ "${sig:-0}" -gt 0 ] 2>/dev/null; then
		item="Убрать с панели" verb=unpin
	else
		item="Закрепить на панели" verb=pin
	fi
	[ "$(ask "«${label:-$id}»" "$item" "Отмена")" = 0 ] || exit 0
	chosen
	/usr/local/bin/b8k-apps "$verb" "$id" >/dev/null
	;;
*)
	echo "usage: b8k-ask power | hide | b8k-ask close|close-webapp|pin <id>" >&2
	exit 2
	;;
esac
