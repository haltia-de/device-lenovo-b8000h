# B8000-H speaker and microphone: hardware gains at their top steps, software volume in
# PulseAudio (see /usr/share/pulseaudio/alsa-mixer/profile-sets/b8k.conf).
SUBSYSTEM=="sound", KERNEL=="card*", ATTR{id}=="B8000", ENV{PULSE_PROFILE_SET}="b8k.conf", RUN+="/usr/bin/amixer -q -c B8000 sset Speaker 7", RUN+="/usr/bin/amixer -q -c B8000 sset Mic 5"
