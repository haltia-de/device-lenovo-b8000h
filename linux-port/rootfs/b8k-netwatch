#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Wi-Fi watchdog. wlan_mt6628 sometimes stops passing traffic, mostly
# during a large transfer, while the link still looks connected. Every
# 30 s ping the gateway (each ping wakes the radio, so not more often).
# After two misses in a row, mark the network down and reload the driver
# once. The driver also does not survive a system
# sleep: the link is simply gone. So when the network was up and the link
# stays down for a minute while Wi-Fi is switched on, reload once as well.
# Another reload waits until the gateway has answered again, so a router
# that is really gone does not cause a loop.
# State for the panel icon: /run/b8k-net/state = up | down | off.
set -u
dir=/run/b8k-net
mkdir -p "$dir"
exec 9>"$dir/lock"
flock -n 9 || exit 0

state() {
	cur=
	read -r cur < "$dir/state" 2>/dev/null
	[ "$cur" = "$1" ] && return
	echo "$1" > "$dir/state.new" && mv "$dir/state.new" "$dir/state"
	logger -t b8k-netwatch "network $1"
}

reload() {
	reloaded=1
	logger -t b8k-netwatch "$1, reloading wlan_mt6628"
	sh /etc/local.d/00-b8k-modules.start
	misses=0
	gone=0
	sleep 30
}

misses=0
gone=0
reloaded=0
was_up=0
while :; do
	sleep 30
	gw=$(ip route show default dev wlan0 2>/dev/null | awk '{ print $3; exit }')
	carrier=
	read -r carrier < /sys/class/net/wlan0/carrier 2>/dev/null
	if [ "$carrier" != 1 ] || [ -z "$gw" ]; then
		misses=0
		state off
		# Only a link that was up and vanished; Wi-Fi switched off is left alone.
		if [ "$was_up" = 1 ] && [ "$reloaded" = 0 ] &&
		   [ "$(nmcli radio wifi 2>/dev/null)" = enabled ]; then
			gone=$((gone + 1))
			[ "$gone" -ge 2 ] && reload "link gone for a minute"
		fi
		continue
	fi
	gone=0
	if ping -c 1 -W 3 "$gw" >/dev/null 2>&1; then
		misses=0
		reloaded=0
		was_up=1
		state up
		continue
	fi
	misses=$((misses + 1))
	[ "$misses" -ge 2 ] || continue
	state down
	[ "$reloaded" = 0 ] && reload "gateway $gw silent"
done
