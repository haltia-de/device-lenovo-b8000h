#!/bin/sh
# Waybar status for the drawer handle, the volume, the Wi-Fi icon and the
# 4-bar battery. "b8k-meter toggle" flips the handle between open and closed.
# Always prints one JSON line and exits 0, so the icon cannot disappear.
set -u

# b8k-press marks a tap for 300 ms: print the class with "pressed" added.
out() {
	if [ -e "${XDG_RUNTIME_DIR:-/tmp}/b8k-press/$1" ]; then
		printf '{"text":" ","class":["%s","pressed"]}\n' "$2"
	else
		printf '{"text":" ","class":"%s"}\n' "$2"
	fi
}

wifi_class() {
	# w0 is disconnected. w1..w4 are four signal bars, same idea as the battery.
	# wx: associated, but the gateway does not answer (b8k-netwatch).
	class=w0
	if [ -r /sys/class/net/wlan0/operstate ] && [ -r /sys/class/net/wlan0/carrier ]; then
		op=$(cat /sys/class/net/wlan0/operstate 2>/dev/null || echo down)
		car=$(cat /sys/class/net/wlan0/carrier 2>/dev/null || echo 0)
		if [ "$op" = "up" ] && [ "$car" = "1" ]; then
			bars=1
			sig=$(iw dev wlan0 link 2>/dev/null | awk '/signal:/ { print $2; exit }')
			case $sig in
				''|*[!0-9-]*) ;;
				*)
					if [ "$sig" -ge -55 ]; then
						bars=4
					elif [ "$sig" -ge -67 ]; then
						bars=3
					elif [ "$sig" -ge -75 ]; then
						bars=2
					fi
					;;
			esac
			class=w$bars
			[ "$(cat /run/b8k-net/state 2>/dev/null)" = down ] && class=wx
		fi
	fi
	echo "$class"
}

wifi() {
	out wifi "$(wifi_class)"
}

battery() {
	cap=0
	status=Unknown
	if [ -r /sys/class/power_supply/battery/capacity ]; then
		cap=$(cat /sys/class/power_supply/battery/capacity 2>/dev/null || echo 0)
	fi
	case $cap in
		''|*[!0-9]*) cap=0 ;;
	esac
	if [ "$cap" -gt 100 ]; then
		cap=100
	fi
	if [ "$cap" -eq 0 ]; then
		bars=0
	else
		# 1-25, 26-50, 51-75, 76-100 -> 1..4 bars. 0 stays empty.
		bars=$(( (cap * 4 + 99) / 100 ))
		if [ "$bars" -gt 4 ]; then
			bars=4
		fi
	fi
	if [ -r /sys/class/power_supply/battery/status ]; then
		status=$(cat /sys/class/power_supply/battery/status 2>/dev/null || echo Unknown)
	fi
	# bN is the level. cN is the same level while the supply is charging or full.
	case $status in
		Charging|Full) class=c$bars ;;
		*) class=b$bars ;;
	esac
	out battery "$class"
}

volume() {
	# v0 is muted or 0%. v1..v4 are four waves, a quarter of the range each,
	# same idea as the Wi-Fi bars.
	vol=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | awk -F/ '/Volume/ { gsub(/[ %]/, "", $2); print $2; exit }')
	mute=$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{ print $2 }')
	case $vol in
		''|*[!0-9]*) out volume v0; return ;;
	esac
	if [ "$vol" -eq 0 ] || [ "$mute" = yes ] || [ "$mute" = да ]; then
		class=v0
	else
		# 1-25, 26-50, 51-75, 76-100 -> 1..4 waves.
		w=$(( (vol * 4 + 99) / 100 ))
		[ "$w" -gt 4 ] && w=4
		class=v$w
	fi
	out volume "$class"
}

# The drawer is open while this file exists. waybar keeps the state to
# itself, so a tap on the handle flips both (b8k-meter toggle in its
# on-click-release); b8k-launcher and b8k-apps reload remove the file, as a
# new panel starts closed.
drawer=${XDG_RUNTIME_DIR:-/tmp}/b8k-drawer-open

system() {
	# The handle of the drawer that holds brightness, volume and Wi-Fi: an
	# arrow up while closed, down while open (the drawer opens above it).
	# A problem shows on the closed handle instead of the arrow: no network
	# first (w0, or wx when the gateway does not answer), then a muted
	# speaker.
	if [ -e "$drawer" ]; then
		out system open
		return
	fi
	case $(wifi_class) in
		w0) out system w0; return ;;
		wx) out system wx; return ;;
	esac
	mute=$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{ print $2 }')
	case $mute in
		yes|да) out system muted ;;
		*) out system closed ;;
	esac
}

case ${1:-} in
	brightness) out brightness idle ;;
	volume) volume ;;
	system) system ;;
	toggle) if [ -e "$drawer" ]; then rm -f "$drawer"; else : > "$drawer"; fi ;;
	hide) out hide idle ;;
	home)
		# Lit while the home screen is up over the windows (b8k-home).
		if [ -e "${XDG_RUNTIME_DIR:-/tmp}/b8k-home.raised" ]; then
			out home raised
		else
			out home idle
		fi
		;;
	wifi) wifi ;;
	battery) battery ;;
	*) printf '{"text":" ","class":"w0"}\n' ;;
esac
exit 0
