class Buzz:
    EVIOCSFF = 0x40000000 | (0x2C << 16) | (ord("E") << 8) | 0x80

    def __init__(self, ms=70):
        self.fd = -1
        try:
            for node in sorted(os.listdir("/sys/class/input")):
                if not node.startswith("event"):
                    continue
                with open("/sys/class/input/%s/device/name" % node) as fh:
                    if fh.read().strip() != "regulator-haptic":
                        continue
                self.fd = os.open("/dev/input/" + node, os.O_RDWR | os.O_CLOEXEC)
                buf = bytearray(struct.pack("<HhHHHHHHH", 0x50, -1, 0, 0, 0, ms, 0,
                                            0xFFFF, 0xFFFF) + bytes(32))
                fcntl.ioctl(self.fd, self.EVIOCSFF, buf)
                self.effect = struct.unpack_from("<h", buf, 2)[0]
                break
        except OSError:
            self.fd = -1

    def __call__(self, *_args):
        if self.fd >= 0:
            try:
                os.write(self.fd, struct.pack("<llHHi", 0, 0, 0x15, self.effect, 1))
            except OSError:
                pass
        return True


def parse_when(raw):
    raw = (raw or "").strip()
    if not raw:
        return None
    try:
        stamp = parsedate_to_datetime(raw)
    except (TypeError, ValueError, IndexError, OverflowError):
        try:  # Atom: 2026-10-16T05:00:00+03:00
            stamp = datetime.fromisoformat(raw.replace("Z", "+00:00"))
        except ValueError:
            return None
    if stamp.tzinfo is None:
        stamp = stamp.replace(tzinfo=timezone.utc)
    return stamp


def load_feeds():
    """[(name, url, icon path or "")], from news.conf or the defaults."""
    if not os.path.exists(CONFIG):
        return list(DEFAULT_FEEDS)
    conf = configparser.ConfigParser(interpolation=None)
    try:
        conf.read(CONFIG, encoding="utf-8")
    except configparser.Error:
        return list(DEFAULT_FEEDS)
    return [(name, conf[name].get("url", ""), conf[name].get("icon", ""))
            for name in conf.sections() if conf[name].get("url", "").startswith(("https://", "http://"))]


def clean_name(text):
    """A feed's title as a section name of news.conf. Titles come from any
    site: no line breaks or brackets that could start new lines, sections
    or keys in the file, no control characters, not too long."""
    text = re.sub(r"[\x00-\x1f\x7f\[\]]+", " ", text or "")
    text = " ".join(text.split())[:80]
    return text or "Лента"


def clean_url(url):
    url = (url or "").strip()
    if not url.startswith(("https://", "http://")) or re.search(r"[\x00-\x20\x7f]", url):
        return ""
    return url


def save_feeds(feeds):
    conf = configparser.ConfigParser(interpolation=None)
    for name, url, icon in feeds:
        name, url = clean_name(name), clean_url(url)
        if not url or conf.has_section(name):
            continue
        conf[name] = {"url": url}
        if icon:
            conf[name]["icon"] = icon
    try:
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        with open(CONFIG + ".new", "w", encoding="utf-8") as fh:
            conf.write(fh)
        os.replace(CONFIG + ".new", CONFIG)
    except OSError:
        pass


def get(url, limit=2 * 1024 * 1024, timeout=10):
    """(bytes, final url, content type) of an http(s) page."""
    import urllib.request

    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 b8k-news"})
    with urllib.request.urlopen(req, timeout=timeout) as fh:
        return fh.read(limit), fh.geturl(), fh.headers.get_content_type()


def parse_xml(raw):
    import xml.etree.ElementTree as ET

    # Feeds come from anywhere now: no entity declarations, no expansion games.
    if b"<!ENTITY" in raw[:4096]:
        raise ValueError("entity declarations in the feed")
    return ET.fromstring(raw)


def feed_title(root):
    """The feed's own name, from RSS or Atom; None if root is no feed."""
    if root.tag == ATOM + "feed":
        return (root.findtext(ATOM + "title") or "").strip() or "Лента"
    channel = root.find("channel")
    if root.tag in ("rss", "{http://www.w3.org/1999/02/22-rdf-syntax-ns#}RDF") or channel is not None:
        title = channel.findtext("title") if channel is not None else ""
        return (title or "").strip() or "Лента"
    return None


class FeedLinks(HTMLParser):
    """<link rel="alternate" type="application/rss+xml|atom+xml" href> of a page."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.found = []

    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if tag == "link" and "alternate" in (a.get("rel") or "").lower() and \
                (a.get("type") or "").lower() in ("application/rss+xml", "application/atom+xml") and \
                a.get("href"):
            self.found.append(a["href"])


def discover(text):
    """(name, feed url) for an address the person typed: a feed, or a site."""
    import urllib.parse

    url = text.strip()
    if not url.startswith(("https://", "http://")):
        url = "https://" + url
    raw, final, _ctype = get(url)
    try:
        title = feed_title(parse_xml(raw))
        if title:
            return title, final
    except Exception:
        pass
    links = FeedLinks()
    links.feed(raw.decode("utf-8", "replace"))
    for href in links.found:
        feed_url = urllib.parse.urljoin(final, href)
        if not feed_url.startswith(("https://", "http://")):
            continue
        raw2, final2, _c = get(feed_url)
        title = feed_title(parse_xml(raw2))
        if title:
            return title, final2
    raise ValueError("no feed")


def looks_like_address(text):
    return " " not in text.strip() and "." in text


def search_feeds(text):
    """Feeds for what the person typed: [(title, url, note)].

    An address is tried here first (the page's own <link rel=alternate>),
    then through feedsearch.dev, which knows more of a site's feeds. Words
    go to Feedly's open feed search, the largest index of feeds there is.
    Both are asked only when the person presses Найти."""
    import json as _json
    import urllib.parse

    found = []
    if looks_like_address(text):
        try:
            name, url = discover(text)
            found.append((name, url, ""))
        except Exception:
            pass
        try:
            raw, _f, _c = get("https://feedsearch.dev/api/v1/search?url="
                              + urllib.parse.quote(text.strip()), timeout=20)
            for r in _json.loads(raw.decode("utf-8", "replace")):
                url = r.get("url") or ""
                if url.startswith(("https://", "http://")) and \
                        all(url.lower() != f[1].lower() for f in found):
                    found.append((r.get("title") or r.get("site_name") or url, url,
                                  r.get("site_name") or ""))
        except Exception:
            pass
        return found[:12]
    raw, _f, _c = get("https://cloud.feedly.com/v3/search/feeds?count=12&locale=ru&query="
                      + urllib.parse.quote(text.strip()), timeout=15)
    for r in _json.loads(raw.decode("utf-8", "replace")).get("results", []):
        url = (r.get("feedId") or "")[5:]  # "feed/<url>"
        if not url.startswith(("https://", "http://")):
            continue
        site = urllib.parse.urlsplit(r.get("website") or url).hostname or ""
        readers = r.get("subscribers") or 0
        note = site.replace("www.", "")
        if readers:
            note += " · читателей: %d" % readers
        found.append(((r.get("title") or site).strip(), url, note))
    return found


def one_feed(name, url):
    items = []
    try:
        raw, _final, _ctype = get(url, timeout=8)
        root = parse_xml(raw)
    except Exception:
        return items
    if root.tag == ATOM + "feed":
        for entry in root.iter(ATOM + "entry"):
            title = (entry.findtext(ATOM + "title") or "").strip()
            link = ""
            for ln in entry.findall(ATOM + "link"):
                if ln.get("rel", "alternate") == "alternate":
                    link = (ln.get("href") or "").strip()
                    break
            if not title or not link.startswith(("https://", "http://")):
                continue
            summary = entry.findtext(ATOM + "content") or entry.findtext(ATOM + "summary") or ""
            when = entry.findtext(ATOM + "published") or entry.findtext(ATOM + "updated")
            items.append((parse_when(when), name, title, link, summary.strip(), ""))
            if len(items) >= PER_FEED:
                break
        return items
    for item in root.iter("item"):
        title = (item.findtext("title") or "").strip()
        link = (item.findtext("link") or "").strip()
        # Only web links: anything else would reach Firefox as an option.
        if not title or not link.startswith(("https://", "http://")):
            continue
        enc = item.find("enclosure")
        image = enc.get("url", "") if enc is not None else ""
        if not image.startswith("https://") or "default" in image:
            image = ""  # Фонтанка sends one stock picture for every story
        items.append((parse_when(item.findtext("pubDate")), name, title, link,
                      (item.findtext("description") or "").strip(), image))
        if len(items) >= PER_FEED:
            break
    return items


def paragraphs(text):
    """Plain paragraphs from feed or page text that may hold HTML."""
    text = re.sub(r"(?i)<br\s*/?>|</p>|</div>", "\n", text)
    text = html.unescape(re.sub(r"<[^>]+>", "", text)).replace("\xa0", " ")
    return [p.strip() for p in re.split(r"\n+", text) if p.strip()]


class ArticleParser(HTMLParser):
    """The paragraphs inside itemprop="articleBody", and any JSON-LD."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.depth = 0  # >0 inside the article element
        self.in_p = False
        self.in_ld = False
        self.paras = []
        self.ld = []
        self.buf = []

    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if tag == "script" and a.get("type") == "application/ld+json":
            self.in_ld, self.buf = True, []
        elif self.depth:
            if tag not in ("br", "img", "hr", "meta", "link", "input", "source"):
                self.depth += 1
            if tag == "p":
                self.in_p, self.buf = True, []
        elif a.get("itemprop") == "articleBody":
            self.depth = 1

    def handle_endtag(self, tag):
        if self.in_ld and tag == "script":
            self.in_ld = False
            self.ld.append("".join(self.buf))
        elif self.depth:
            if tag == "p" and self.in_p:
                self.in_p = False
                text = " ".join("".join(self.buf).split())
                if text:
                    self.paras.append(text)
            self.depth -= 1

    def handle_data(self, data):
        if self.in_ld or self.in_p:
            self.buf.append(data)


def find_body(node):
    if isinstance(node, dict):
        if isinstance(node.get("articleBody"), str):
            return node["articleBody"]
        node = list(node.values())
    if isinstance(node, list):
        for child in node:
            found = find_body(child)
            if found:
                return found
    return ""


def story(link, summary):
    """The story's paragraphs: the feed's, else the page's, else the summary."""
    if len(summary) >= FULL_FEED:
        return paragraphs(summary)
    import urllib.request

    try:
        req = urllib.request.Request(link, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=12) as fh:
            raw = fh.read(PAGE_MAX)
            charset = fh.headers.get_content_charset() or "utf-8"
        parser = ArticleParser()
        parser.feed(raw.decode(charset, "replace"))
        for block in parser.ld:
            try:
                body = find_body(json.loads(block))
            except ValueError:
                continue
            if body:
                return paragraphs(body)
        if parser.paras:
            return parser.paras
    except Exception:
        pass
    return paragraphs(summary)


def picture(url):
    import urllib.request

    try:
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=12) as fh:
            data = fh.read(PAGE_MAX)
        loader = GdkPixbuf.PixbufLoader()
        loader.write(data)
        loader.close()
        pix = loader.get_pixbuf()
        scale = min(1.0, 900 / pix.get_width())
        return pix.scale_simple(int(pix.get_width() * scale), int(pix.get_height() * scale),
                                GdkPixbuf.InterpType.BILINEAR)
    except Exception:
        return None


def headlines(feeds):
    from concurrent.futures import ThreadPoolExecutor

    found = []
    # All feeds at once: one slow site no longer holds up the others.
    with ThreadPoolExecutor(max_workers=4) as pool:
        for items in pool.map(lambda f: one_feed(f[0], f[1]), feeds):
            found.extend(items)
    epoch = datetime(1970, 1, 1, tzinfo=timezone.utc)
    found.sort(key=lambda item: item[0] or epoch, reverse=True)
    return found[:SHOW]


def initials(name, size=52):
    """A coloured circle with the first letters, for a source with no icon."""
    import zlib

    area = Gtk.DrawingArea()
    area.set_size_request(size, size)
    area.set_valign(Gtk.Align.CENTER)
    area.set_margin_start(16)
    letters = "".join(w[0] for w in re.findall(r"\w+", name)[:2]).upper() or "?"
    colour = COLOURS[zlib.crc32(name.encode()) % len(COLOURS)]

    def draw(_w, cr):
        cr.set_source_rgb(*colour)
        cr.arc(size / 2, size / 2, size / 2, 0, 6.2832)
        cr.fill()
        cr.set_source_rgb(1, 1, 1)
        cr.select_font_face("Sans", 0, 1)
        cr.set_font_size(size * 0.38)
        ext = cr.text_extents(letters)
        cr.move_to((size - ext.width) / 2 - ext.x_bearing, (size - ext.height) / 2 - ext.y_bearing)
        cr.show_text(letters)
        return False

    area.connect("draw", draw)
    return area


def clock(stamp):
    if stamp is None:
        return ""
    local = stamp.astimezone()
    return "%d %s, %02d:%02d" % (local.day, MONTHS[local.month - 1], local.hour, local.minute)


class News(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="b8k.News")
        self.icons = {}
        self.busy = False
        self.have_items = False
        self.generation = 0

    def do_activate(self):
        if self.get_windows():
            self.get_windows()[0].present()
            return
        self.feeds = load_feeds()
        self.load_icons()
        # A buzz on every button and every headline, as in the other programs.
        self.buzz = Buzz()
        Gtk.Button()  # the "pressed" signal exists once the class is set up
        GObject.add_emission_hook(Gtk.Button, "pressed", self.buzz)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        win = Gtk.ApplicationWindow(application=self, title="Новости")
        win.set_default_size(1180, 680)
        header = Gtk.HeaderBar()
        header.set_show_close_button(False)
        title = Gtk.Label(label="Новости")
        title.get_style_context().add_class("title")
        header.set_custom_title(title)
        # The same button as in b8k-weather: the symbolic icon, white on blue.
        self.refresh_btn = Gtk.Button.new_from_icon_name("view-refresh-symbolic",
                                                         Gtk.IconSize.DIALOG)
        self.refresh_btn.get_style_context().add_class("refresh")
        self.refresh_btn.connect("clicked", lambda *_a: self.refresh(True))
        header.pack_end(self.refresh_btn)
        self.gear_btn = Gtk.Button.new_from_icon_name("emblem-system-symbolic", Gtk.IconSize.DIALOG)
        self.gear_btn.get_style_context().add_class("gear")
        self.gear_btn.connect("clicked", lambda *_a: self.show_sources())
        header.pack_end(self.gear_btn)
        self.header_title = title
        self.back_btn = Gtk.Button(label="←")
        self.back_btn.get_style_context().add_class("back")
        self.back_btn.connect("clicked", lambda *_a: self.show_list())
        self.back_btn.set_no_show_all(True)
        header.pack_start(self.back_btn)
        win.set_titlebar(header)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.scroll = Gtk.ScrolledWindow()
        self.scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        self.listbox.connect("row-activated", self.open_row)
        self.scroll.add(self.listbox)
        box.pack_start(self.scroll, True, True, 0)
        self.stack = Gtk.Stack()
        self.stack.add_named(box, "list")
        self.story_scroll = Gtk.ScrolledWindow()
        self.story_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.story_scroll.get_style_context().add_class("story")
        # One viewport for good: add() would wrap each story in a new one,
        # and the second story found the first one's still in place.
        self.story_port = Gtk.Viewport()
        self.story_port.set_shadow_type(Gtk.ShadowType.NONE)
        self.story_scroll.add(self.story_port)
        self.stack.add_named(self.story_scroll, "story")
        self.story_box = None
        self.stories = {}  # link -> paragraphs, for this run
        self.showing = None
        win.add(self.stack)
        self.note("Загрузка")
        # The feeds are fetched once the window is drawn: started earlier,
        # the fetching thread took the CPU from the first draw.
        self.first_draw = win.connect("draw", self.on_first_draw)
        win.show_all()
        GLib.timeout_add_seconds(REFRESH_SEC, self.auto_refresh)

    def on_first_draw(self, win, _cr):
        win.disconnect(self.first_draw)
        GLib.idle_add(lambda: self.refresh(True) and False)
        return False

    def note(self, text):
        self.listbox.foreach(lambda row: self.listbox.remove(row))
        row = Gtk.ListBoxRow()
        label = Gtk.Label(label=text, xalign=0)
        label.get_style_context().add_class("item")
        label.set_margin_start(18)
        label.set_margin_top(16)
        label.set_margin_bottom(16)
        row.add(label)
        row.link = ""
        self.listbox.add(row)
        self.listbox.show_all()

    def auto_refresh(self):
        self.refresh(False)
        return True

    def refresh(self, jump):
        if self.busy:
            return
        self.busy = True
        self.refresh_btn.set_sensitive(False)
        if not self.have_items:
            self.note("Загрузка")
        self.generation += 1
        gen = self.generation
        threading.Thread(target=self.load, args=(gen, jump), daemon=True).start()

    def load(self, gen, jump):
        try:
            items = headlines(list(self.feeds))
        except Exception:
            items = []
        GLib.idle_add(self.show_items, items, gen, jump)

    def show_items(self, items, gen, jump):
        if gen != self.generation:
            return False
        self.busy = False
        self.refresh_btn.set_sensitive(True)
        if not items:
            if not self.have_items:
                self.note("Не удалось загрузить новости")
            return False
        y = 0
        if not jump:
            y = self.scroll.get_vadjustment().get_value()
        self.have_items = True
        self.listbox.foreach(lambda row: self.listbox.remove(row))
        for stamp, name, title, link, summary, image in items:
            row = Gtk.ListBoxRow()
            line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
            pix = self.icons.get(name)
            if pix is not None:
                icon = Gtk.Image.new_from_pixbuf(pix)
            else:
                icon = initials(name)
            icon.set_valign(Gtk.Align.CENTER)
            icon.set_margin_start(16)
            words = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            headline = Gtk.Label(label=title, xalign=0)
            headline.set_line_wrap(True)
            headline.set_max_width_chars(40)
            headline.get_style_context().add_class("item")
            headline.set_margin_end(18)
            when = Gtk.Label(label=clock(stamp), xalign=0)
            when.get_style_context().add_class("when")
            when.set_margin_bottom(8)
            words.pack_start(headline, False, False, 0)
            words.pack_start(when, False, False, 0)
            words.set_margin_top(10)
            line.pack_start(icon, False, False, 0)
            line.pack_start(words, True, True, 0)
            row.add(line)
            row.link = link
            row.item = (stamp, name, title, link, summary, image)
            self.listbox.add(row)
        self.listbox.show_all()
        if not jump:
            GLib.idle_add(self.keep_place, y)
        return False

    def keep_place(self, y):
        self.scroll.get_vadjustment().set_value(y)
        return False

    def open_row(self, _box, row):
        self.buzz()
        item = getattr(row, "item", None)
        if item:
            self.show_story(item)

    def show_list(self):
        self.showing = None
        self.back_btn.hide()
        self.refresh_btn.show()
        self.gear_btn.show()
        self.header_title.set_text("Новости")
        changed = getattr(self, "sources_changed", False)
        self.sources_changed = False
        self.stack.set_visible_child_name("list")
        if changed:
            self.have_items = False
            self.refresh(True)

    # the sources
    def load_icons(self):
        self.icons = {}
        for name, _url, path in self.feeds:
            self.icons[name] = None
            if path:
                try:
                    self.icons[name] = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 52, 52, True)
                except GLib.Error:
                    pass

    def show_sources(self):
        self.header_title.set_text("Источники")
        self.back_btn.show()
        self.refresh_btn.hide()
        self.gear_btn.hide()
        old = self.stack.get_child_by_name("sources")
        if old:
            old.destroy()
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        page.get_style_context().add_class("sources")
        for side in ("start", "end", "top", "bottom"):
            getattr(page, "set_margin_" + side)(16)

        head = Gtk.Label(label="Найти ленту", xalign=0)
        head.get_style_context().add_class("src-head")
        page.pack_start(head, False, False, 0)
        line = Gtk.Box(spacing=10)
        entry = Gtk.Entry()
        entry.get_style_context().add_class("src-entry")
        entry.set_placeholder_text("Название, тема или адрес сайта")
        add = Gtk.Button(label="Найти")
        add.get_style_context().add_class("add")
        line.pack_start(entry, True, True, 0)
        line.pack_start(add, False, False, 0)
        page.pack_start(line, False, False, 0)
        hint = ("Например: «Коммерсант», «погода», «lenta.ru». Название и тему ищет сервис "
                "Feedly, адрес сайта — сама программа и сервис feedsearch.dev.")
        note = Gtk.Label(label=hint, xalign=0)
        note.set_line_wrap(True)
        note.get_style_context().add_class("src-note")
        page.pack_start(note, False, False, 0)
        results = Gtk.ListBox()
        results.set_selection_mode(Gtk.SelectionMode.NONE)
        page.pack_start(results, False, False, 0)

        head2 = Gtk.Label(label="Мои источники", xalign=0)
        head2.get_style_context().add_class("src-head")
        head2.set_margin_top(12)
        page.pack_start(head2, False, False, 0)
        rows = Gtk.ListBox()
        rows.set_selection_mode(Gtk.SelectionMode.NONE)
        page.pack_start(rows, False, False, 0)
        reset = Gtk.Button(label="Вернуть источники как было")
        reset.get_style_context().add_class("plain")
        reset.set_halign(Gtk.Align.START)
        page.pack_start(reset, False, False, 0)

        def fill():
            for child in rows.get_children():
                child.destroy()
            if not self.feeds:
                empty = Gtk.Label(label="Источников нет — добавьте ленту выше.", xalign=0)
                empty.get_style_context().add_class("src-note")
                rows.add(empty)
            for feed in self.feeds:
                name, url, _icon = feed
                box = Gtk.Box(spacing=16)
                box.set_margin_top(10)
                box.set_margin_bottom(10)
                box.set_margin_start(12)
                box.set_margin_end(12)
                pix = self.icons.get(name)
                box.pack_start(Gtk.Image.new_from_pixbuf(pix) if pix else initials(name),
                               False, False, 0)
                words = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                n = Gtk.Label(label=name, xalign=0)
                n.get_style_context().add_class("src-name")
                u = Gtk.Label(label=url, xalign=0)
                u.set_ellipsize(3)  # Pango.EllipsizeMode.END
                u.get_style_context().add_class("src-url")
                words.pack_start(n, False, False, 0)
                words.pack_start(u, False, False, 0)
                box.pack_start(words, True, True, 0)
                remove = Gtk.Button(label="Убрать")
                remove.get_style_context().add_class("plain")
                remove.set_valign(Gtk.Align.CENTER)
                remove.connect("clicked", lambda _b, f=feed: drop(f))
                box.pack_end(remove, False, False, 0)
                rows.add(box)
            rows.show_all()

        def changed():
            save_feeds(self.feeds)
            self.load_icons()
            self.sources_changed = True
            fill()

        def drop(feed):
            self.feeds = [f for f in self.feeds if f != feed]
            changed()

        def do_reset(_b):
            try:
                os.remove(CONFIG)
            except OSError:
                pass
            self.feeds = load_feeds()
            self.load_icons()
            self.sources_changed = True
            fill()

        def row_for(title, url, extra, action, label_text):
            box = Gtk.Box(spacing=16)
            for side in ("top", "bottom"):
                getattr(box, "set_margin_" + side)(8)
            box.set_margin_start(12)
            box.set_margin_end(12)
            words = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            n = Gtk.Label(label=title, xalign=0)
            n.set_line_wrap(True)
            n.get_style_context().add_class("src-name")
            words.pack_start(n, False, False, 0)
            u = Gtk.Label(label=extra or url, xalign=0)
            u.set_ellipsize(3)  # Pango.EllipsizeMode.END
            u.get_style_context().add_class("src-url")
            words.pack_start(u, False, False, 0)
            box.pack_start(words, True, True, 0)
            b = Gtk.Button(label=label_text)
            b.get_style_context().add_class("add")
            b.set_valign(Gtk.Align.CENTER)
            if action:
                b.connect("clicked", action)
            box.pack_end(b, False, False, 0)
            return box, b

        def do_add(*_a):
            text = entry.get_text().strip()
            if not text:
                return
            add.set_sensitive(False)
            note.set_text("Ищу…")
            for child in results.get_children():
                child.destroy()

            def work():
                try:
                    found, err = search_feeds(text), None
                except Exception as exc:
                    found, err = [], exc
                GLib.idle_add(show_found, found, err)

            threading.Thread(target=work, daemon=True).start()

        def show_found(found, err):
            add.set_sensitive(True)
            if err:
                note.set_text("Нет связи с сервисом поиска. Попробуйте ещё раз или введите адрес сайта.")
                return False
            if not found:
                note.set_text("Ничего не нашлось. Попробуйте другое слово или адрес сайта.")
                return False
            note.set_text("Нажмите «Добавить» у нужной ленты.")
            for title, url, extra in found:
                have = any(f[1] == url for f in self.feeds)
                box, b = row_for(title, url, extra, None, "Есть" if have else "Добавить")
                b.set_sensitive(not have)
                b.connect("clicked", lambda btn, t=title, u=url: take(btn, t, u))
                results.add(box)
            results.show_all()
            return False

        def take(btn, title, url):
            title, url = clean_name(title), clean_url(url)
            if not url or any(f[1] == url for f in self.feeds):
                return
            name, k = title, 2
            while any(f[0] == name for f in self.feeds):
                name = "%s %d" % (title, k)
                k += 1
            self.feeds.append((name, url, ""))
            btn.set_label("Добавлено")
            btn.set_sensitive(False)
            changed()

        add.connect("clicked", do_add)
        entry.connect("activate", do_add)
        reset.connect("clicked", do_reset)
        fill()
        # The whole page scrolls: search results and one's own list together.
        outer = Gtk.ScrolledWindow()
        outer.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        outer.get_style_context().add_class("sources")
        outer.add(page)
        outer.show_all()
        page = outer
        self.stack.add_named(page, "sources")
        self.stack.set_visible_child_name("sources")

    def show_story(self, item):
        stamp, name, title, link, summary, image = item
        self.showing = link
        if self.story_box is not None:
            self.story_box.destroy()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.set_margin_start(40)
        box.set_margin_end(40)
        box.set_margin_top(24)
        box.set_margin_bottom(32)
        meta = Gtk.Label(label="%s · %s" % (name, clock(stamp)), xalign=0)
        meta.get_style_context().add_class("story-meta")
        box.pack_start(meta, False, False, 0)
        head = Gtk.Label(label=title, xalign=0)
        head.set_line_wrap(True)
        head.get_style_context().add_class("story-title")
        box.pack_start(head, False, False, 0)
        pic = Gtk.Image()
        pic.set_no_show_all(True)
        box.pack_start(pic, False, False, 0)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.pack_start(text, False, False, 0)
        full = Gtk.Button(label="Открыть полную версию в браузере")
        full.get_style_context().add_class("full")
        full.set_halign(Gtk.Align.START)
        full.connect("clicked", lambda b: self.open_link(link, b))
        box.pack_start(full, False, False, 8)
        self.story_box = box
        self.story_port.add(box)
        self.story_scroll.get_vadjustment().set_value(0)
        box.show_all()
        self.back_btn.show()
        self.refresh_btn.hide()
        self.gear_btn.hide()
        self.stack.set_visible_child_name("story")

        def put_text(paras):
            if self.showing != link:
                return False
            self.stories[link] = paras
            for child in text.get_children():
                child.destroy()
            for para in paras or ["Текст новости не найден. Полная версия — в браузере."]:
                lab = Gtk.Label(label=para, xalign=0)
                lab.set_line_wrap(True)
                lab.get_style_context().add_class("story-text")
                text.pack_start(lab, False, False, 0)
            text.show_all()
            return False

        def put_picture(pix):
            if self.showing == link and pix is not None:
                pic.set_from_pixbuf(pix)
                pic.show()
            return False

        if link in self.stories:
            put_text(self.stories[link])
        else:
            put_text(paragraphs(summary) or ["Загрузка…"])
            self.stories.pop(link, None)
            threading.Thread(target=lambda: GLib.idle_add(put_text, story(link, summary)),
                             daemon=True).start()
        if image:
            threading.Thread(target=lambda: GLib.idle_add(put_picture, picture(image)),
                             daemon=True).start()

    def open_link(self, link, button):
        # Firefox can take 20 s to start; without a sign that the tap was
        # taken, people tapped again and got the page in several tabs.
        # b8k-launch shows the splash and opens one tab per link.
        subprocess = __import__("subprocess")
        subprocess.Popen(
            ["/usr/local/bin/b8k-launch", "url", link],
            start_new_session=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        button.set_sensitive(False)
        button.set_label("Открывается в браузере…")

        def again():
            button.set_label("Открыть полную версию в браузере")
            button.set_sensitive(True)
            return False

        GLib.timeout_add_seconds(8, again)


