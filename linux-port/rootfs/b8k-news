def parse_when(raw):
    raw = (raw or "").strip()
    if not raw:
        return None
    try:
        stamp = parsedate_to_datetime(raw)
    except (TypeError, ValueError, IndexError, OverflowError):
        return None
    if stamp.tzinfo is None:
        stamp = stamp.replace(tzinfo=timezone.utc)
    return stamp


def one_feed(name, url):
    items = []
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "b8k-news"})
        with urllib.request.urlopen(req, timeout=8) as fh:
            root = ET.fromstring(fh.read())
    except (OSError, ET.ParseError):
        return items
    for item in root.iter("item"):
        title = (item.findtext("title") or "").strip()
        link = (item.findtext("link") or "").strip()
        # Only web links: anything else would reach Firefox as an option.
        if not title or not link.startswith(("https://", "http://")):
            continue
        enc = item.find("enclosure")
        image = enc.get("url", "") if enc is not None else ""
        if not image.startswith("https://") or "default" in image:
            image = ""  # Фонтанка sends one stock picture for every story
        items.append((parse_when(item.findtext("pubDate")), name, title, link,
                      (item.findtext("description") or "").strip(), image))
        if len(items) >= PER_FEED:
            break
    return items


def paragraphs(text):
    """Plain paragraphs from feed or page text that may hold HTML."""
    text = re.sub(r"(?i)<br\s*/?>|</p>|</div>", "\n", text)
    text = html.unescape(re.sub(r"<[^>]+>", "", text)).replace("\xa0", " ")
    return [p.strip() for p in re.split(r"\n+", text) if p.strip()]


class ArticleParser(HTMLParser):
    """The paragraphs inside itemprop="articleBody", and any JSON-LD."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.depth = 0  # >0 inside the article element
        self.in_p = False
        self.in_ld = False
        self.paras = []
        self.ld = []
        self.buf = []

    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if tag == "script" and a.get("type") == "application/ld+json":
            self.in_ld, self.buf = True, []
        elif self.depth:
            if tag not in ("br", "img", "hr", "meta", "link", "input", "source"):
                self.depth += 1
            if tag == "p":
                self.in_p, self.buf = True, []
        elif a.get("itemprop") == "articleBody":
            self.depth = 1

    def handle_endtag(self, tag):
        if self.in_ld and tag == "script":
            self.in_ld = False
            self.ld.append("".join(self.buf))
        elif self.depth:
            if tag == "p" and self.in_p:
                self.in_p = False
                text = " ".join("".join(self.buf).split())
                if text:
                    self.paras.append(text)
            self.depth -= 1

    def handle_data(self, data):
        if self.in_ld or self.in_p:
            self.buf.append(data)


def find_body(node):
    if isinstance(node, dict):
        if isinstance(node.get("articleBody"), str):
            return node["articleBody"]
        node = list(node.values())
    if isinstance(node, list):
        for child in node:
            found = find_body(child)
            if found:
                return found
    return ""


def story(link, summary):
    """The story's paragraphs: the feed's, else the page's, else the summary."""
    if len(summary) >= FULL_FEED:
        return paragraphs(summary)
    try:
        req = urllib.request.Request(link, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=12) as fh:
            raw = fh.read(PAGE_MAX)
            charset = fh.headers.get_content_charset() or "utf-8"
        parser = ArticleParser()
        parser.feed(raw.decode(charset, "replace"))
        for block in parser.ld:
            try:
                body = find_body(json.loads(block))
            except ValueError:
                continue
            if body:
                return paragraphs(body)
        if parser.paras:
            return parser.paras
    except Exception:
        pass
    return paragraphs(summary)


def picture(url):
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=12) as fh:
            data = fh.read(PAGE_MAX)
        loader = GdkPixbuf.PixbufLoader()
        loader.write(data)
        loader.close()
        pix = loader.get_pixbuf()
        scale = min(1.0, 900 / pix.get_width())
        return pix.scale_simple(int(pix.get_width() * scale), int(pix.get_height() * scale),
                                GdkPixbuf.InterpType.BILINEAR)
    except Exception:
        return None


def headlines():
    found = []
    for name, url, _icon in FEEDS:
        found.extend(one_feed(name, url))
    epoch = datetime(1970, 1, 1, tzinfo=timezone.utc)
    found.sort(key=lambda item: item[0] or epoch, reverse=True)
    return found[:SHOW]


def clock(stamp):
    if stamp is None:
        return ""
    local = stamp.astimezone()
    return "%d %s, %02d:%02d" % (local.day, MONTHS[local.month - 1], local.hour, local.minute)


class News(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="b8k.News")
        self.icons = {}
        self.busy = False
        self.have_items = False
        self.generation = 0

    def do_activate(self):
        if self.get_windows():
            self.get_windows()[0].present()
            return
        for name, _url, path in FEEDS:
            try:
                self.icons[name] = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 52, 52, True)
            except GLib.Error:
                self.icons[name] = None
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        win = Gtk.ApplicationWindow(application=self, title="Новости")
        win.set_default_size(1180, 680)
        header = Gtk.HeaderBar()
        header.set_show_close_button(False)
        title = Gtk.Label(label="Новости")
        title.get_style_context().add_class("title")
        header.set_custom_title(title)
        self.refresh_btn = Gtk.Button()
        self.refresh_btn.get_style_context().add_class("refresh")
        try:
            pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                "/usr/local/share/b8k/refresh.png", 48, 48, True
            )
            self.refresh_btn.set_image(Gtk.Image.new_from_pixbuf(pix))
            self.refresh_btn.set_always_show_image(True)
        except GLib.Error:
            self.refresh_btn.set_label("↻")
        self.refresh_btn.connect("clicked", lambda *_a: self.refresh(True))
        header.pack_end(self.refresh_btn)
        self.back_btn = Gtk.Button(label="←")
        self.back_btn.get_style_context().add_class("back")
        self.back_btn.connect("clicked", lambda *_a: self.show_list())
        self.back_btn.set_no_show_all(True)
        header.pack_start(self.back_btn)
        win.set_titlebar(header)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.scroll = Gtk.ScrolledWindow()
        self.scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        self.listbox.connect("row-activated", self.open_row)
        self.scroll.add(self.listbox)
        box.pack_start(self.scroll, True, True, 0)
        self.stack = Gtk.Stack()
        self.stack.add_named(box, "list")
        self.story_scroll = Gtk.ScrolledWindow()
        self.story_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.story_scroll.get_style_context().add_class("story")
        self.stack.add_named(self.story_scroll, "story")
        self.story_box = None
        self.stories = {}  # link -> paragraphs, for this run
        self.showing = None
        win.add(self.stack)
        self.note("Загрузка")
        win.show_all()
        self.refresh(True)
        GLib.timeout_add_seconds(REFRESH_SEC, self.auto_refresh)

    def note(self, text):
        self.listbox.foreach(lambda row: self.listbox.remove(row))
        row = Gtk.ListBoxRow()
        label = Gtk.Label(label=text, xalign=0)
        label.get_style_context().add_class("item")
        label.set_margin_start(18)
        label.set_margin_top(16)
        label.set_margin_bottom(16)
        row.add(label)
        row.link = ""
        self.listbox.add(row)
        self.listbox.show_all()

    def auto_refresh(self):
        self.refresh(False)
        return True

    def refresh(self, jump):
        if self.busy:
            return
        self.busy = True
        self.refresh_btn.set_sensitive(False)
        if not self.have_items:
            self.note("Загрузка")
        self.generation += 1
        gen = self.generation
        threading.Thread(target=self.load, args=(gen, jump), daemon=True).start()

    def load(self, gen, jump):
        try:
            items = headlines()
        except Exception:
            items = []
        GLib.idle_add(self.show_items, items, gen, jump)

    def show_items(self, items, gen, jump):
        if gen != self.generation:
            return False
        self.busy = False
        self.refresh_btn.set_sensitive(True)
        if not items:
            if not self.have_items:
                self.note("Не удалось загрузить новости")
            return False
        y = 0
        if not jump:
            y = self.scroll.get_vadjustment().get_value()
        self.have_items = True
        self.listbox.foreach(lambda row: self.listbox.remove(row))
        for stamp, name, title, link, summary, image in items:
            row = Gtk.ListBoxRow()
            line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
            icon = Gtk.Image()
            pix = self.icons.get(name)
            if pix is not None:
                icon.set_from_pixbuf(pix)
            icon.set_valign(Gtk.Align.CENTER)
            icon.set_margin_start(16)
            words = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            headline = Gtk.Label(label=title, xalign=0)
            headline.set_line_wrap(True)
            headline.set_max_width_chars(40)
            headline.get_style_context().add_class("item")
            headline.set_margin_end(18)
            when = Gtk.Label(label=clock(stamp), xalign=0)
            when.get_style_context().add_class("when")
            when.set_margin_bottom(8)
            words.pack_start(headline, False, False, 0)
            words.pack_start(when, False, False, 0)
            words.set_margin_top(10)
            line.pack_start(icon, False, False, 0)
            line.pack_start(words, True, True, 0)
            row.add(line)
            row.link = link
            row.item = (stamp, name, title, link, summary, image)
            self.listbox.add(row)
        self.listbox.show_all()
        if not jump:
            GLib.idle_add(self.keep_place, y)
        return False

    def keep_place(self, y):
        self.scroll.get_vadjustment().set_value(y)
        return False

    def open_row(self, _box, row):
        item = getattr(row, "item", None)
        if item:
            self.show_story(item)

    def show_list(self):
        self.showing = None
        self.back_btn.hide()
        self.refresh_btn.show()
        self.stack.set_visible_child_name("list")

    def show_story(self, item):
        stamp, name, title, link, summary, image = item
        self.showing = link
        if self.story_box is not None:
            self.story_box.destroy()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.set_margin_start(40)
        box.set_margin_end(40)
        box.set_margin_top(24)
        box.set_margin_bottom(32)
        meta = Gtk.Label(label="%s · %s" % (name, clock(stamp)), xalign=0)
        meta.get_style_context().add_class("story-meta")
        box.pack_start(meta, False, False, 0)
        head = Gtk.Label(label=title, xalign=0)
        head.set_line_wrap(True)
        head.get_style_context().add_class("story-title")
        box.pack_start(head, False, False, 0)
        pic = Gtk.Image()
        pic.set_no_show_all(True)
        box.pack_start(pic, False, False, 0)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.pack_start(text, False, False, 0)
        full = Gtk.Button(label="Открыть полную версию в браузере")
        full.get_style_context().add_class("full")
        full.set_halign(Gtk.Align.START)
        full.connect("clicked", lambda *_a: self.open_link(link))
        box.pack_start(full, False, False, 8)
        self.story_box = box
        self.story_scroll.add(box)
        self.story_scroll.get_vadjustment().set_value(0)
        box.show_all()
        self.back_btn.show()
        self.refresh_btn.hide()
        self.stack.set_visible_child_name("story")

        def put_text(paras):
            if self.showing != link:
                return False
            self.stories[link] = paras
            for child in text.get_children():
                child.destroy()
            for para in paras or ["Текст новости не найден. Полная версия — в браузере."]:
                lab = Gtk.Label(label=para, xalign=0)
                lab.set_line_wrap(True)
                lab.get_style_context().add_class("story-text")
                text.pack_start(lab, False, False, 0)
            text.show_all()
            return False

        def put_picture(pix):
            if self.showing == link and pix is not None:
                pic.set_from_pixbuf(pix)
                pic.show()
            return False

        if link in self.stories:
            put_text(self.stories[link])
        else:
            put_text(paragraphs(summary) or ["Загрузка…"])
            self.stories.pop(link, None)
            threading.Thread(target=lambda: GLib.idle_add(put_text, story(link, summary)),
                             daemon=True).start()
        if image:
            threading.Thread(target=lambda: GLib.idle_add(put_picture, picture(image)),
                             daemon=True).start()

    def open_link(self, link):
        subprocess = __import__("subprocess")
        subprocess.Popen(
            ["firefox", link],
            start_new_session=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


if __name__ == "__main__":
    News().run(None)
