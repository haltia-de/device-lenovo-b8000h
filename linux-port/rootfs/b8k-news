#!/usr/bin/env python3
# Large headlines. A tap opens the story itself in large type: the text from
# the feed when the feed carries all of it (Деловой Петербург), otherwise
# from the story's page (the JSON-LD articleBody of Фонтанка, the
# itemprop="articleBody" paragraphs of Интерфакс), else the feed's summary.
# A button under the story opens the full page in Firefox.
# The window appears at once. The list fills when the feeds answer.
# One title only: the header bar. A second "Новости" label used to sit under it.
import html
import json
import re
import threading
import urllib.request
from html.parser import HTMLParser
import xml.etree.ElementTree as ET
from datetime import datetime, timezone
from email.utils import parsedate_to_datetime

