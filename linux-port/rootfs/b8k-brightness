#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0
# Screen brightness: a large slider opened from the sun on the panel.
# The chosen level is kept in ~/.config/b8k/brightness; --restore sets it
# again at session start (b8k-launcher) without opening the window.
# The level goes through logind (Session.SetBrightness), so no root is
# needed; the dialog redraws while the slider moves, and that frame is
# what makes the BLS take the new duty at once.
# The dialog is a card on the overlay layer (gtk-layer-shell), drawn like
# the questions of b8k-ask: always on top, so nothing has to raise it.
import fcntl
import os
import struct
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, Gio, GLib, GObject, Gtk, GtkLayerShell  # noqa: E402

BACKLIGHT = "mt6589-bls"
SYSFS = "/sys/class/backlight/%s" % BACKLIGHT
LOWEST = 10  # never black: the slider must stay visible
SAVED = os.path.join(os.path.expanduser("~"), ".config", "b8k", "brightness")

CSS = b"""
window { background-color: transparent; }
.card {
  background-color: #242424;
  border: 2px solid #3a3a3a;
  border-radius: 16px;
}
label { color: #9a9996; font-size: 35px; }
button label { color: #ffffff; }
scale trough {
  min-height: 24px;
  border-radius: 12px;
  background-color: #3a3a3a;
  border: none;
}
scale highlight { background-color: #3584e4; border-radius: 12px; border: none; }
scale slider {
  min-width: 64px;
  min-height: 64px;
  border-radius: 32px;
  background-color: #ffffff;
  border: none;
  box-shadow: none;
}
button {
  font-size: 35px;
  min-height: 80px;
  border-radius: 12px;
  background: #3a3a3a;
  color: #ffffff;
  border: none;
  box-shadow: none;
}
"""


class Buzz:
    EVIOCSFF = 0x40000000 | (0x2C << 16) | (ord("E") << 8) | 0x80

    def __init__(self, ms=70):
        self.fd = -1
        try:
            for node in sorted(os.listdir("/sys/class/input")):
                if not node.startswith("event"):
                    continue
                with open("/sys/class/input/%s/device/name" % node) as fh:
                    if fh.read().strip() != "regulator-haptic":
                        continue
                self.fd = os.open("/dev/input/" + node, os.O_RDWR | os.O_CLOEXEC)
                buf = bytearray(struct.pack("<HhHHHHHHH", 0x50, -1, 0, 0, 0, ms, 0,
                                            0xFFFF, 0xFFFF) + bytes(32))
                fcntl.ioctl(self.fd, self.EVIOCSFF, buf)
                self.effect = struct.unpack_from("<h", buf, 2)[0]
                break
        except OSError:
            self.fd = -1

    def __call__(self, *_args):
        if self.fd >= 0:
            try:
                os.write(self.fd, struct.pack("<llHHi", 0, 0, 0x15, self.effect, 1))
            except OSError:
                pass
        return True


def read_int(path, default):
    try:
        with open(path) as fh:
            return int(fh.read().strip())
    except (OSError, ValueError):
        return default


def save(level):
    try:
        os.makedirs(os.path.dirname(SAVED), exist_ok=True)
        tmp = SAVED + ".new"
        with open(tmp, "w") as fh:
            fh.write("%d\n" % level)
        os.replace(tmp, SAVED)
    except OSError as exc:
        sys.stderr.write("b8k-brightness: cannot save: %s\n" % exc)


def session_paths():
    yield "/org/freedesktop/login1/session/auto"
    sid = os.environ.get("XDG_SESSION_ID")
    if sid:
        # Object paths escape every byte that is not [A-Za-z0-9] as _xx.
        esc = "".join(c if c.isalnum() else "_%02x" % ord(c) for c in sid)
        yield "/org/freedesktop/login1/session/" + esc


class Brightness:
    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.path = None
        self.pending = None

    def set(self, level):
        args = GLib.Variant("(ssu)", ("backlight", BACKLIGHT, int(level)))
        paths = [self.path] if self.path else list(session_paths())
        for path in paths:
            try:
                self.bus.call_sync("org.freedesktop.login1", path,
                                   "org.freedesktop.login1.Session",
                                   "SetBrightness", args, None,
                                   Gio.DBusCallFlags.NONE, -1, None)
                self.path = path
                return
            except GLib.Error as exc:
                sys.stderr.write("b8k-brightness: %s: %s\n" % (path, exc.message))


def restore():
    level = read_int(SAVED, 0)
    if level >= LOWEST:
        Brightness().set(min(level, read_int(SYSFS + "/max_brightness", 255)))
    return 0


def main():
    if sys.argv[1:] == ["--restore"]:
        return restore()
    lock = open(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"),
                             "b8k-brightness.lock"), "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0  # already open, and on top

    top = read_int(SYSFS + "/max_brightness", 255)
    now = read_int(SYSFS + "/brightness", top // 2)
    light = Brightness()

    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    buzz = Buzz()
    Gtk.Button()  # the "pressed" signal exists once the class is set up
    GObject.add_emission_hook(Gtk.Button, "pressed", buzz)

    win = Gtk.Window(title="Яркость")
    visual = win.get_screen().get_rgba_visual()
    if visual:
        win.set_visual(visual)  # round corners over whatever is below
    GtkLayerShell.init_for_window(win)
    GtkLayerShell.set_layer(win, GtkLayerShell.Layer.OVERLAY)
    GtkLayerShell.set_namespace(win, "b8k-brightness")
    win.set_size_request(800, -1)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=28)
    box.get_style_context().add_class("card")
    for side in ("start", "end", "top", "bottom"):
        getattr(box, "set_margin_" + side)(0)
    inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=28)
    inner.set_margin_top(28)
    inner.set_margin_bottom(28)
    inner.set_margin_start(32)
    inner.set_margin_end(32)
    box.pack_start(inner, True, True, 0)
    title = Gtk.Label(label="Яркость", xalign=0)
    inner.pack_start(title, False, False, 0)

    scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, LOWEST, top, 1)
    scale.set_draw_value(False)
    scale.set_value(max(LOWEST, now))
    scale.connect("button-press-event", lambda *_a: buzz() and False)
    inner.pack_start(scale, True, True, 0)

    def apply():
        light.set(scale.get_value())
        save(int(scale.get_value()))
        light.pending = None
        return False

    def changed(_scale):
        # Coalesce a drag into one call every 60 ms.
        if light.pending is None:
            light.pending = GLib.timeout_add(60, apply)

    scale.connect("value-changed", changed)

    done = Gtk.Button(label="Готово")
    done.connect("clicked", lambda _b: Gtk.main_quit())
    inner.pack_start(done, False, False, 0)

    win.connect("destroy", Gtk.main_quit)
    win.add(box)
    win.show_all()
    Gtk.main()
    if light.pending is not None:
        apply()
    return 0


if __name__ == "__main__":
    sys.exit(main())
