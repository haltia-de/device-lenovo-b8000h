#!/sbin/openrc-run
# SPDX-License-Identifier: GPL-2.0
# B8000-H: load the SGX544 modules and start PowerVR Services at boot, so the
# GPU compositor (phoc-gpu, G5) finds the GPU ready.  Same steps as g3-run.sh
# up to the render test: modules from /root/kN (N = kernel build number),
# then the stock pvrsrvctl in pvr-run.sh's bionic environment.
# Services are initialised once per module load; a second pvrsrvctl --start
# logs "PVRSRVInitSrvConnect failed (129)" (PVRSRV_ERROR_SRV_CONNECT_FAILED:
# init already ran), which counts as ready - Services were started by hand
# (g3-run.sh).  /run/b8k-gpu.ready tells phoc-gpu the GPU is usable.
# Install: /etc/init.d/b8k-gpu, rc-update add b8k-gpu default.

description="SGX544 GPU modules and PowerVR Services"
READY=/run/b8k-gpu.ready
LOG=/root/pvrlog/boot-gpu

depend() {
	after modules localmount
	before local
}

start() {
	local n moddir m rc

	ebegin "Starting SGX544 Services"
	n=$(uname -r | sed -n 's/.*-b8000h\([0-9]*\)-.*/\1/p')
	moddir=/root/k$n
	[ -d "$moddir" ] || moddir=/root
	for m in ion_legacy pvrsrvkm dc_nohw; do
		grep -q "^$m " /proc/modules && continue
		if ! insmod "$moddir/$m.ko"; then
			eend 1 "insmod $moddir/$m.ko failed"
			return 1
		fi
	done
	# The stock gralloc opens /dev/pvr_sync; our KM has no native sync.
	[ -e /dev/pvr_sync ] || ln -s /dev/null /dev/pvr_sync
	if [ -e "$READY" ]; then
		eend 0
		return 0
	fi

	rm -rf "$LOG.old"
	[ -d "$LOG" ] && mv "$LOG" "$LOG.old"
	PVR_FAKE_NODES=pvr_sync PVR_LOG_DIR=$LOG /root/pvr-run.sh \
		/system/vendor/bin/pvrsrvctl --start --no-module \
		> /dev/null 2>&1
	rc=$?
	if [ $rc = 0 ] ||
	   grep -q "PVRSRVInitSrvConnect failed (129)" "$LOG/log-main.txt" \
		2>/dev/null; then
		touch "$READY"
		eend 0
	else
		eend 1 "pvrsrvctl failed (rc $rc), logs in $LOG"
	fi
}

stop() {
	# The compositor may still hold the GPU: keep the modules loaded.
	rm -f "$READY"
	return 0
}
