# --- data -------------------------------------------------------------------
def num(v, default=None):
    try:
        return float(v)
    except (TypeError, ValueError):
        return default


def values(el):
    """The attributes of one <values> (or <day>) element, numbers as numbers."""
    out = {}
    for k, v in el.attrib.items():
        n = num(v)
        out[k] = v if n is None or k in ("icon", "descr", "date", "valid") else n
    return out


def load_city():
    conf = configparser.ConfigParser(interpolation=None)
    conf.read(CONFIG, encoding="utf-8")
    try:
        return int(conf["city"]["id"]), conf["city"].get("name") or "?"
    except (KeyError, ValueError):
        return DEFAULT_CITY


def save_city(city_id, name):
    conf = configparser.ConfigParser(interpolation=None)
    conf["city"] = {"id": str(city_id), "name": name}
    try:
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        with open(CONFIG + ".new", "w", encoding="utf-8") as fh:
            conf.write(fh)
        os.replace(CONFIG + ".new", CONFIG)
    except OSError:
        pass


def get_xml(url):
    import urllib.request
    import xml.etree.ElementTree as ET

    req = urllib.request.Request(url, headers={"User-Agent": "b8k-weather/1.0"})
    with urllib.request.urlopen(req, timeout=15) as fh:
        raw = fh.read(512 * 1024)
    # The service never sends a DOCTYPE; refusing one keeps entity tricks out.
    if b"<!DOCTYPE" in raw or b"<!ENTITY" in raw:
        raise ValueError("unexpected DOCTYPE")
    return ET.fromstring(raw)


def find_cities(text):
    """Cities whose name starts with text: (id, name, where)."""
    import urllib.parse

    root = get_xml(SERVICE + "cities/?lang=ru&startsWith=" + urllib.parse.quote(text))
    found = []
    for item in root.iter("item"):
        try:
            cid = int(item.get("id"))
        except (TypeError, ValueError):
            continue
        where = ", ".join(x for x in (item.get("district_name"), item.get("country_name")) if x)
        found.append((cid, item.get("n") or "?", where))
    return found[:25]


def fetch(city_id):
    # urllib is imported in get_xml, in the fetching thread: it took 0.3 s
    # of the start, before the window was drawn.
    root = get_xml(SERVICE + "forecast/?city=%d&lang=ru" % city_id)
    loc = root.find("location")
    fact = loc.find("fact")
    data = {"fetched": time.time(), "city": loc.get("name"), "city_id": city_id, "now": values(fact.find("values")),
            "now_time": fact.get("valid"), "days": []}
    # risem/setm: sunrise and sunset in minutes after local midnight. (The
    # sunrise/sunset stamps count local time as if it were UTC.)
    data["now"].update({k: num(fact.get(k)) for k in ("risem", "setm", "durm")})
    for d in loc.iter("day"):
        day = values(d)
        day["steps"] = []
        for f in d.iter("forecast"):
            step = values(f.find("values"))
            step["valid"] = f.get("valid")
            day["steps"].append(step)
        data["days"].append(day)
    return data


def load_cache(city_id):
    try:
        with open(CACHE) as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return None
    # A forecast kept for another city is no forecast for this one.
    return data if data.get("city_id", DEFAULT_CITY[0]) == city_id else None


def save_cache(data):
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        with open(CACHE + ".new", "w") as fh:
            json.dump(data, fh, ensure_ascii=False)
        os.replace(CACHE + ".new", CACHE)
    except OSError:
        pass


def deg(t):
    if t is None:
        return "—"
    t = int(round(t))
    if t > 0:
        return "+%d°" % t
    if t < 0:
        return "−%d°" % -t
    return "0°"


def hm(minutes):
    return "%d:%02d" % divmod(int(minutes), 60) if minutes is not None else "—"


def day_title(iso):
    d = date.fromisoformat(iso)
    delta = (d - date.today()).days
    if delta == 0:
        return "Сегодня"
    if delta == 1:
        return "Завтра"
    return WEEKDAYS[d.weekday()].capitalize()


def day_date(iso):
    d = date.fromisoformat(iso)
    return "%d %s" % (d.day, MONTHS[d.month - 1])


def precip_text(v):
    """Rain, snow or none, from pt/pr/prflt."""
    kind = int(v.get("pt") or 0)
    if not kind:
        return ""
    names = {1: "дождь", 2: "снег", 3: "дождь со снегом"}
    mm = v.get("prflt")
    text = names.get(kind, "осадки")
    if mm:
        text += " %s мм" % ("%.1f" % mm).replace(".", ",")
    return text


# --- icons --------------------------------------------------------------------
def draw_weather(cr, code, size):
    """Draw a Gismeteo icon code ("d.c3.r1", "n.c2", "c4", ...) in size x size."""
    parts = (code or "").split(".")
    night = "n" in parts
    day = "d" in parts
    clouds = next((int(p[1:]) for p in parts if p[:1] == "c" and p[1:].isdigit()), 0)
    rain = next((int(p[1:]) for p in parts if p[:1] == "r" and p[1:].isdigit()), 0)
    snow = next((int(p[1:]) for p in parts if p[:1] == "s" and p[1:].isdigit()), 0)
    storm = any(p.startswith("st") for p in parts)
    if "rs" in parts:
        rain = snow = 1
    s = size / 100.0
    cr.save()
    cr.scale(s, s)
    # sun or moon, unless the sky is overcast
    if clouds < 4 or day or night:
        cx, cy, r = (38, 36, 20) if clouds else (50, 46, 26)
        if clouds >= 4:
            cx, cy, r = 34, 30, 16
        if night:
            cr.set_source_rgb(0.75, 0.75, 0.74)
            cr.arc(cx, cy, r, 0, 2 * math.pi)
            cr.fill()
            cr.set_source_rgb(0.95, 0.95, 0.94)
            cr.arc(cx + r * 0.55, cy - r * 0.35, r * 0.85, 0, 2 * math.pi)
            cr.fill()
        else:
            cr.set_source_rgb(0.96, 0.76, 0.07)
            cr.arc(cx, cy, r, 0, 2 * math.pi)
            cr.fill()
            cr.set_line_width(4)
            cr.set_line_cap(1)
            for k in range(8):
                a = k * math.pi / 4
                cr.move_to(cx + math.cos(a) * (r + 5), cy + math.sin(a) * (r + 5))
                cr.line_to(cx + math.cos(a) * (r + 12), cy + math.sin(a) * (r + 12))
            cr.stroke()
    # clouds: none, a small one, a big one, or two dark ones
    if clouds:
        dark = clouds >= 4 or rain >= 2 or storm
        if clouds >= 4:
            cloud(cr, 60, 40, 0.8, (0.6, 0.6, 0.59))
        cloud(cr, 54, 56, {1: 0.55, 2: 0.75}.get(clouds, 1.0),
              (0.47, 0.46, 0.48) if dark else (0.75, 0.75, 0.74))
    top = 74
    if rain:
        cr.set_source_rgb(0.21, 0.52, 0.89)
        cr.set_line_width(5)
        cr.set_line_cap(1)
        for k in range(min(3, rain + (1 if rain else 0))):
            x = 36 + k * 15 - (6 if snow else 0)
            cr.move_to(x, top)
            cr.line_to(x - 5, top + 14)
        cr.stroke()
    if snow:
        cr.set_source_rgb(0.38, 0.63, 0.92)
        cr.set_line_width(3)
        for k in range(min(3, snow + 1)):
            x, y = 44 + k * 15 + (8 if rain else 0), top + 8
            for a in range(3):
                ang = a * math.pi / 3
                cr.move_to(x - 6 * math.cos(ang), y - 6 * math.sin(ang))
                cr.line_to(x + 6 * math.cos(ang), y + 6 * math.sin(ang))
        cr.stroke()
    if storm:
        cr.set_source_rgb(0.96, 0.76, 0.07)
        cr.move_to(58, 68)
        cr.line_to(48, 84)
        cr.line_to(56, 84)
        cr.line_to(50, 98)
        cr.line_to(66, 78)
        cr.line_to(58, 78)
        cr.close_path()
        cr.fill()
    cr.restore()


def cloud(cr, cx, cy, k, rgb):
    cr.set_source_rgb(*rgb)
    for dx, dy, r in ((-18, 4, 13), (0, -6, 18), (18, 4, 13)):
        cr.arc(cx + dx * k, cy + dy * k, r * k, 0, 2 * math.pi)
        cr.fill()
    cr.rectangle(cx - 30 * k, cy + 2 * k, 60 * k, 15 * k)
    cr.fill()


def draw_pressure(widget, cr, steps):
    w, h = widget.get_allocated_width(), widget.get_allocated_height()
    vals = [st.get("p") for st in steps]
    times = [datetime.fromisoformat(st["valid"]) for st in steps]
    lo, hi = min(vals), max(vals)
    if hi - lo < 6:  # a calm day still reads as a gentle line, not a cliff
        mid = (hi + lo) / 2
        lo, hi = mid - 3, mid + 3
    left, right, top, bottom = 30, 30, 50, 56
    n = len(vals)
    xs = [left + (w - left - right) * k / (n - 1) for k in range(n)]

    def y_of(v):
        return top + (h - top - bottom) * (hi - v) / (hi - lo)

    cr.select_font_face("Sans", 0, 0)
    # the day boundary and its name
    for k in range(1, n):
        if times[k].date() != times[k - 1].date():
            x = (xs[k] + xs[k - 1]) / 2
            cr.set_source_rgb(0.75, 0.75, 0.74)
            cr.set_line_width(2)
            cr.move_to(x, 8)
            cr.line_to(x, h - 8)
            cr.stroke()
    # now
    now = datetime.now()
    for k in range(n - 1):
        if times[k] <= now < times[k + 1]:
            f = (now - times[k]).total_seconds() / (times[k + 1] - times[k]).total_seconds()
            x = xs[k] + (xs[k + 1] - xs[k]) * f
            cr.set_source_rgb(0.21, 0.52, 0.89)
            cr.set_line_width(3)
            cr.move_to(x, 14)
            cr.line_to(x, h - bottom + 6)
            cr.stroke()
    # the line
    cr.set_source_rgb(0.18, 0.2, 0.21)
    cr.set_line_width(4)
    cr.set_line_join(1)
    for k, v in enumerate(vals):
        (cr.line_to if k else cr.move_to)(xs[k], y_of(v))
    cr.stroke()
    # points, values above, hours below
    for k, v in enumerate(vals):
        x, y = xs[k], y_of(v)
        cr.set_source_rgb(0.21, 0.52, 0.89)
        cr.arc(x, y, 6, 0, 2 * math.pi)
        cr.fill()
        cr.set_source_rgb(0.18, 0.2, 0.21)
        cr.set_font_size(22)
        text = "%d" % v
        ext = cr.text_extents(text)
        cr.move_to(x - ext.width / 2 - ext.x_bearing, y - 14)
        cr.show_text(text)
        cr.set_source_rgb(0.47, 0.46, 0.48)
        cr.set_font_size(18)
        text = times[k].strftime("%-H")
        ext = cr.text_extents(text)
        cr.move_to(x - ext.width / 2 - ext.x_bearing, h - 18)
        cr.show_text(text)
    return False


def icon(code, size):
    area = Gtk.DrawingArea()
    area.set_size_request(size, size)
    area.connect("draw", lambda _w, cr: draw_weather(cr, code, size) or False)
    return area


def label(text, cls, xalign=0.5, wrap=False):
    lab = Gtk.Label(label=text, xalign=xalign)
    lab.get_style_context().add_class(cls)
    if wrap:
        lab.set_line_wrap(True)
        lab.set_justify(Gtk.Justification.CENTER if xalign == 0.5 else Gtk.Justification.LEFT)
    return lab


# --- the window -------------------------------------------------------------
class Weather(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="b8k.Weather")
        self.win = None
        self.data = None
        self.loading = False
        self.buzz = buzzer()
        # Nothing is fetched before the window is first drawn: a fetch that
        # came back first rebuilt the whole page before it was ever shown.
        self.drawn = False
        self.want_refresh = False
        self.generation = 0

    def do_activate(self):
        if self.win:
            self.win.present()
            return
        provider = Gtk.CssProvider()
        provider.load_from_data((b8k_ui.HEADER_CSS if b8k_ui else b"") + CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Gtk.Button()  # the "pressed" signal exists once the class is set up
        GObject.add_emission_hook(Gtk.Button, "pressed", self.buzz)

        self.win = Gtk.ApplicationWindow(application=self, title="Погода")
        self.win.set_default_size(1160, 800)
        bar = Gtk.HeaderBar()
        bar.set_show_close_button(False)
        heading = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.city_id, self.city_name = load_city()
        self.title = label(self.city_name, "title")
        heading.pack_start(self.title, False, False, 0)
        self.when = label("", "when")
        heading.pack_start(self.when, False, False, 0)
        bar.set_custom_title(heading)
        self.button = Gtk.Button.new_from_icon_name("view-refresh-symbolic", Gtk.IconSize.DIALOG)
        self.button.get_style_context().add_class("refresh")
        self.button.connect("clicked", lambda _b: self.refresh())
        bar.pack_end(self.button)
        self.gear = Gtk.Button.new_from_icon_name("emblem-system-symbolic", Gtk.IconSize.DIALOG)
        self.gear.get_style_context().add_class("gear")
        self.gear.connect("clicked", lambda _b: self.open_city())
        bar.pack_end(self.gear)
        # Back from a day or the city page to the whole page.
        self.back = Gtk.Button(label="←")
        self.back.get_style_context().add_class("back")
        self.back.connect("clicked", lambda _b: self.close_day())
        self.search_gen = 0
        self.back.set_no_show_all(True)
        bar.pack_start(self.back)
        self.win.set_titlebar(bar)

        self.stack = Gtk.Stack()
        self.scroll = Gtk.ScrolledWindow()
        self.scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scroll.set_kinetic_scrolling(True)
        self.day_scroll = Gtk.ScrolledWindow()
        self.day_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.day_scroll.set_kinetic_scrolling(True)
        self.stack.add_named(self.scroll, "main")
        self.stack.add_named(self.day_scroll, "day")
        self.stack.add_named(self.city_page(), "city")
        self.day_index = None
        self.win.add(self.stack)
        self.win.connect("notify::is-active", self.on_active)
        self.first_draw = self.win.connect("draw", self.on_first_draw)
        self.win.show_all()

        self.data = load_cache(self.city_id)
        self.show_data(None)
        if not self.data or time.time() - self.data.get("fetched", 0) > STALE_SEC:
            self.refresh()
        GLib.timeout_add_seconds(REFRESH_SEC, lambda: self.refresh() or True)

    def on_active(self, win, _param):
        # Back in front after a sleep or a while: bring the forecast up to date.
        if win.is_active() and (not self.data or time.time() - self.data.get("fetched", 0) > STALE_SEC):
            self.refresh()

    def on_first_draw(self, win, _cr):
        win.disconnect(self.first_draw)
        self.drawn = True
        if self.want_refresh:
            GLib.timeout_add(300, lambda: self.refresh() and False)
        return False

    def refresh(self):
        if not self.drawn:
            self.want_refresh = True
            return
        self.want_refresh = False
        if self.loading:
            return
        self.loading = True
        self.button.set_sensitive(False)
        threading.Thread(target=self.load, daemon=True).start()

    def load(self):
        try:
            data, error = fetch(self.city_id), None
        except Exception as exc:  # network, HTTP or a changed format
            data, error = None, exc
        GLib.idle_add(self.loaded, data, error)

    def loaded(self, data, error):
        self.loading = False
        self.button.set_sensitive(True)
        if data and data.get("city_id") != self.city_id:
            return False  # fetched for the city before the last choice
        if data:
            self.data = data
            save_cache(data)
        self.show_data(error)
        if self.day_index is not None:
            self.open_day(self.day_index)
        return False

    # building the page
    def show_data(self, error):
        old = self.scroll.get_child()
        if old:
            self.scroll.remove(old)
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        page.set_margin_start(16)
        page.set_margin_end(16)
        page.set_margin_bottom(24)
        data = self.data
        if error:
            page.pack_start(label("Нет связи с Gismeteo" + (", показан прошлый прогноз" if data else ""),
                                  "note", xalign=0), False, False, 0)
        if not data:
            self.when.set_text("загрузка…" if not error else "")
            page.show_all()
            self.scroll.add(page)
            return
        self.when.set_text("обновлено в " + datetime.fromtimestamp(data["fetched"]).strftime("%-H:%M"))
        # The card for now at once, the rest one part per idle turn: the
        # window shows up sooner and fills in under the reader's eyes.
        parts = [lambda: [self.now_card(data)]]
        for d in data["days"][:2]:
            if d.get("steps"):
                parts.append(lambda d=d: [
                    label("%s, %s" % (day_title(d["date"]), day_date(d["date"])), "section", xalign=0),
                    self.steps_card(d)])
        steps = [st for d in data["days"][:2] for st in d.get("steps", [])]
        if len(steps) > 1:
            parts.append(lambda: [label("Давление, мм рт. ст.", "section", xalign=0),
                                  self.pressure_card(steps)])
        parts.append(lambda: [label("На неделю", "section", xalign=0), self.week_card(data["days"])])
        self.generation += 1
        gen = self.generation

        def add_part():
            if gen != self.generation or not parts:
                return False
            for widget in parts.pop(0)():
                page.pack_start(widget, False, False, 0)
                widget.show_all()
            return bool(parts)

        add_part()
        page.show_all()
        self.scroll.add(page)
        GLib.idle_add(add_part, priority=GLib.PRIORITY_LOW)

    def now_card(self, data):
        v = data["now"]
        card = Gtk.Box(spacing=24)
        card.get_style_context().add_class("card")
        card.set_margin_top(12)
        card.pack_start(icon(v.get("icon"), 170), False, False, 0)
        main = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        main.set_valign(Gtk.Align.CENTER)
        main.pack_start(label(deg(v.get("t")), "now-temp", xalign=0), False, False, 0)
        main.pack_start(label(v.get("descr", ""), "now-desc", xalign=0, wrap=True), False, False, 0)
        main.pack_start(label("ощущается как " + deg(v.get("hi")), "dim", xalign=0), False, False, 0)
        card.pack_start(main, False, False, 0)

        grid = Gtk.Grid(column_spacing=28, row_spacing=14)
        grid.set_valign(Gtk.Align.CENTER)
        wd = int(v.get("wd") or 0)
        today = data["days"][0] if data["days"] else {}
        gust = today.get("gust_speed")
        tiles = [
            ("Ветер", "%d м/с" % (v.get("ws") or 0),
             WIND[wd] if wd < len(WIND) else "" + (", порывы до %d" % gust if gust else "")),
            ("Давление", "%d мм" % (v.get("p") or 0), "рт. ст."),
            ("Влажность", "%d %%" % (v.get("hum") or 0), ""),
            ("Вода", deg(v.get("water_t")), ""),
            ("Солнце", "%s – %s" % (hm(v.get("risem")), hm(v.get("setm"))),
             "день %d ч %d мин" % divmod(int(v.get("durm") or 0), 60)),
            ("Магнитное поле", GEOMAGNETIC[min(9, int(v.get("grade") or 0))].capitalize(), ""),
        ]
        if gust and wd < len(WIND):
            tiles[0] = ("Ветер", "%d м/с" % (v.get("ws") or 0), "%s, порывы до %d" % (WIND[wd], gust))
        if v.get("water_t") is None:
            tiles.pop(3)
        for k, (title, value, extra) in enumerate(tiles):
            tile = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            tile.pack_start(label(title, "tile-title", xalign=0), False, False, 0)
            tile.pack_start(label(value, "tile-value", xalign=0, wrap=True), False, False, 0)
            if extra:
                tile.pack_start(label(extra, "tile-extra", xalign=0, wrap=True), False, False, 0)
            grid.attach(tile, k % 2, k // 2, 1, 1)
        card.pack_end(grid, False, False, 0)
        return card

    def steps_card(self, day):
        card = Gtk.Box(homogeneous=True)
        card.get_style_context().add_class("card")
        now = datetime.now()
        for step in day["steps"]:
            start = datetime.fromisoformat(step["valid"])
            slot = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            slot.get_style_context().add_class("slot")
            delta = (now - start).total_seconds()
            if 0 <= delta < 3 * 3600:
                slot.get_style_context().add_class("now")
            elif delta >= 3 * 3600:
                slot.get_style_context().add_class("past")
            slot.pack_start(label(start.strftime("%-H:%M"), "slot-time"), False, False, 0)
            ic = icon(step.get("icon"), 76)
            ic.set_halign(Gtk.Align.CENTER)
            slot.pack_start(ic, False, False, 0)
            slot.pack_start(label(deg(step.get("t")), "slot-temp"), False, False, 0)
            wd = int(step.get("wd") or 0)
            slot.pack_start(label("%d м/с %s" % (step.get("ws") or 0, WIND_SHORT[wd] if wd < 9 else ""),
                                  "slot-small"), False, False, 0)
            rain = precip_text(step)
            slot.pack_start(label(rain or "%d %%" % (step.get("hum") or 0), "slot-small"),
                            False, False, 0)
            card.pack_start(slot, True, True, 0)
        return card

    def pressure_card(self, steps):
        """Pressure for today and tomorrow, in three-hour steps, as a line."""
        card = Gtk.Box()
        card.get_style_context().add_class("card")
        area = Gtk.DrawingArea()
        area.set_size_request(-1, 260)
        area.connect("draw", draw_pressure, steps)
        card.pack_start(area, True, True, 0)
        return card

    # one day
    def open_day(self, index):
        days = (self.data or {}).get("days", [])
        if index >= len(days):
            self.close_day()
            return
        d = days[index]
        self.day_index = index
        old = self.day_scroll.get_child()
        if old:
            self.day_scroll.remove(old)
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        page.set_margin_start(16)
        page.set_margin_end(16)
        page.set_margin_bottom(24)
        top, tiles = self.day_card(d)
        page.pack_start(top, False, False, 0)
        page.pack_start(tiles, False, False, 8)
        if d.get("steps"):
            page.pack_start(label("По 3 часа", "section", xalign=0), False, False, 0)
            page.pack_start(self.steps_card(d), False, False, 0)
            if len(d["steps"]) > 1:
                page.pack_start(label("Давление, мм рт. ст.", "section", xalign=0), False, False, 0)
                page.pack_start(self.pressure_card(d["steps"]), False, False, 0)
        else:
            page.pack_start(label("Подробно по часам Gismeteo даёт только сегодня и завтра.",
                                  "dim", xalign=0, wrap=True), False, False, 12)
        page.show_all()
        self.day_scroll.add(page)
        self.title.set_text("%s, %s" % (day_title(d["date"]), day_date(d["date"])))
        self.back.show()
        self.stack.set_visible_child_name("day")
        self.day_scroll.get_vadjustment().set_value(0)

    # the city
    def city_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        for side in ("start", "end", "top", "bottom"):
            getattr(box, "set_margin_" + side)(16)
        self.search = Gtk.SearchEntry()
        self.search.get_style_context().add_class("search")
        self.search.set_placeholder_text("Название города")
        self.search.connect("search-changed", self.on_search)
        box.pack_start(self.search, False, False, 0)
        self.city_note = label("Начните вводить название, например «Казань»", "dim", xalign=0)
        box.pack_start(self.city_note, False, False, 0)
        self.cities = Gtk.ListBox()
        self.cities.set_selection_mode(Gtk.SelectionMode.NONE)
        self.cities.connect("row-activated", self.on_city)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.add(self.cities)
        box.pack_start(scroll, True, True, 0)
        return box

    def open_city(self):
        self.day_index = None
        self.title.set_text("Город")
        self.when.hide()
        self.back.show()
        self.gear.hide()
        self.button.hide()
        self.search.set_text("")
        for row in self.cities.get_children():
            row.destroy()
        self.city_note.set_text("Сейчас: %s. Начните вводить название другого города."
                                % self.city_name)
        self.stack.set_visible_child_name("city")
        self.search.grab_focus()

    def on_search(self, entry):
        text = entry.get_text().strip()
        self.search_gen += 1
        gen = self.search_gen
        if len(text) < 2:
            return
        self.city_note.set_text("Поиск…")

        def work():
            try:
                found, err = find_cities(text), None
            except Exception as exc:
                found, err = [], exc
            GLib.idle_add(self.show_cities, gen, found, err)

        # Wait for a pause in typing before asking.
        GLib.timeout_add(500, lambda: gen == self.search_gen and
                         threading.Thread(target=work, daemon=True).start() and False)

    def show_cities(self, gen, found, err):
        if gen != self.search_gen:
            return False
        for row in self.cities.get_children():
            row.destroy()
        if err:
            self.city_note.set_text("Нет связи с Gismeteo")
        elif not found:
            self.city_note.set_text("Ничего не найдено")
        else:
            self.city_note.set_text("Нажмите на свой город")
        for cid, name, where in found:
            row = Gtk.ListBoxRow()
            row.get_style_context().add_class("city")
            row.city = (cid, name)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            box.pack_start(label(name, "city-name", xalign=0), False, False, 0)
            if where:
                box.pack_start(label(where, "city-where", xalign=0), False, False, 0)
            row.add(box)
            self.cities.add(row)
        self.cities.show_all()
        return False

    def on_city(self, _list, row):
        self.buzz()
        cid, name = row.city
        save_city(cid, name)
        self.city_id, self.city_name = cid, name
        self.data = None
        self.show_data(None)
        self.close_day()
        self.loading = False
        self.refresh()

    def close_day(self):
        self.day_index = None
        self.title.set_text(self.city_name)
        self.when.show()
        self.gear.show()
        self.button.show()
        self.back.hide()
        self.stack.set_visible_child_name("main")

    def day_card(self, d):
        card = Gtk.Box(spacing=24)
        card.get_style_context().add_class("card")
        card.set_margin_top(12)
        card.pack_start(icon(d.get("icon"), 150), False, False, 0)
        main = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        main.set_valign(Gtk.Align.CENTER)
        main.set_size_request(260, -1)
        temps = Gtk.Box(spacing=16)
        temps.pack_start(label(deg(d.get("tmax")), "day-hi"), False, False, 0)
        lo = label(deg(d.get("tmin")), "day-min")
        lo.set_valign(Gtk.Align.END)
        lo.set_margin_bottom(14)
        temps.pack_start(lo, False, False, 0)
        main.pack_start(temps, False, False, 0)
        main.pack_start(label(d.get("descr", ""), "now-desc", xalign=0, wrap=True), False, False, 0)
        card.pack_start(main, False, False, 0)

        wd = int(d.get("wd") or 0)
        wind_extra = WIND[wd] if wd < len(WIND) else ""
        if d.get("gust_speed"):
            wind_extra += ", порывы до %d" % d["gust_speed"]
        rain = precip_text(d) or "без осадков"
        if d.get("ts"):
            rain += ", гроза"
        cl = int(d.get("cl") or 0)
        tiles = [
            ("Ветер", "%d–%d м/с" % (d.get("wsmin") or 0, d.get("wsmax") or 0), wind_extra),
            ("Давление", "%d–%d мм" % (d.get("pmin") or 0, d.get("pmax") or 0), "рт. ст."),
            ("Влажность", "%d–%d %%" % (d.get("hummin") or 0, d.get("hummax") or 0), ""),
            ("Осадки", rain.capitalize(), ""),
            ("Облачность", CLOUDS[min(3, cl)].capitalize(), ""),
            ("Солнце", "%s – %s" % (hm(d.get("risem")), hm(d.get("setm"))),
             "день %d ч %d мин" % divmod(int(d.get("durm") or 0), 60)),
            ("Магнитное поле", GEOMAGNETIC[min(9, int(d.get("grademax") or 0))].capitalize(), ""),
        ]
        # All the values in a card of their own, four to a row.
        grid = Gtk.Grid(column_spacing=28, row_spacing=18, column_homogeneous=True)
        grid.get_style_context().add_class("card")
        for k, (title, value, extra) in enumerate(tiles):
            tile = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            tile.pack_start(label(title, "tile-title", xalign=0), False, False, 0)
            tile.pack_start(label(value, "tile-value", xalign=0, wrap=True), False, False, 0)
            if extra:
                tile.pack_start(label(extra, "tile-extra", xalign=0, wrap=True), False, False, 0)
            grid.attach(tile, k % 4, k // 4, 1, 1)
        return card, grid

    def week_card(self, days):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        card.get_style_context().add_class("card")
        for index, d in enumerate(days):
            row = Gtk.Box(spacing=18)
            row.get_style_context().add_class("day")
            name = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            name.set_size_request(230, -1)
            name.set_valign(Gtk.Align.CENTER)
            name.pack_start(label(day_title(d["date"]), "day-name", xalign=0), False, False, 0)
            name.pack_start(label(day_date(d["date"]), "day-date", xalign=0), False, False, 0)
            row.pack_start(name, False, False, 0)
            row.pack_start(icon(d.get("icon"), 72), False, False, 0)
            desc = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            desc.set_valign(Gtk.Align.CENTER)
            desc.pack_start(label(d.get("descr", ""), "day-desc", xalign=0, wrap=True), False, False, 0)
            wd = int(d.get("wd") or 0)
            extra = "ветер %d–%d м/с %s" % (d.get("wsmin") or 0, d.get("wsmax") or 0,
                                           WIND_SHORT[wd] if wd < 9 else "")
            rain = precip_text(d)
            if rain:
                extra += ", " + rain
            if d.get("pmin") and d.get("pmax"):
                extra += ", давление %d–%d мм" % (d["pmin"], d["pmax"])
            desc.pack_start(label(extra, "day-date", xalign=0, wrap=True), False, False, 0)
            row.pack_start(desc, True, True, 0)
            temps = Gtk.Box(spacing=12)
            temps.set_valign(Gtk.Align.CENTER)
            temps.pack_start(label(deg(d.get("tmax")), "day-temp"), False, False, 0)
            temps.pack_start(label(deg(d.get("tmin")), "day-min"), False, False, 0)
            row.pack_end(temps, False, False, 0)
            # The whole row is a button: a tap opens that day.
            button = Gtk.Button()
            button.get_style_context().add_class("dayrow")
            button.add(row)
            button.connect("clicked", lambda _b, i=index: self.open_day(i))
            card.pack_start(button, False, False, 0)
        return card


