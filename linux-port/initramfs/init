#!/bin/busybox sh

BB=/bin/busybox

$BB mkdir -p /dev /proc /sys /run /tmp /sbin /usr/bin /usr/sbin
$BB --install -s
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
$BB mount -t devtmpfs devtmpfs /dev
exec >/dev/console 2>&1

$BB mount -t proc proc /proc
$BB mount -t sysfs sysfs /sys
$BB mkdir -p /dev/pts /sys/kernel/config /sys/kernel/debug /sys/fs/pstore
$BB mount -t devpts devpts /dev/pts
$BB mount -t configfs configfs /sys/kernel/config
$BB mount -t debugfs debugfs /sys/kernel/debug
$BB mount -t pstore pstore /sys/fs/pstore

echo
echo "B8000-H safe Linux bring-up initramfs"
echo "No internal Android partition is mounted by this initramfs."
echo "Kernel: $($BB uname -a)"
echo "Command line: $($BB cat /proc/cmdline)"
echo "Pstore:"
$BB ls -la /sys/fs/pstore

G=/sys/kernel/config/usb_gadget/b8000h
if [ -d /sys/kernel/config/usb_gadget ]; then
	$BB mkdir -p "$G/strings/0x409" "$G/configs/c.1/strings/0x409"
	echo 0x1d6b > "$G/idVendor"
	echo 0x0104 > "$G/idProduct"
	echo B8000H-LINUX > "$G/strings/0x409/serialnumber"
	echo "B8000-H" > "$G/strings/0x409/manufacturer"
	echo "Safe Linux serial console" > "$G/strings/0x409/product"
	echo "ACM console" > "$G/configs/c.1/strings/0x409/configuration"
	$BB mkdir -p "$G/functions/acm.usb0"
	$BB ln -s "$G/functions/acm.usb0" "$G/configs/c.1/acm.usb0"
	UDC=$($BB ls /sys/class/udc | $BB head -n 1)
	if [ -n "$UDC" ]; then
		echo "$UDC" > "$G/UDC"
		echo "USB ACM gadget bound to $UDC"
	else
		echo "No USB device controller appeared"
	fi
else
	echo "USB gadget configfs is unavailable"
fi

# Boot the root filesystem selected by the DTB command line.  The SD rescue
# image uses mmcblk0p1; the future internal-storage image uses the existing
# USRDATA logical partition (mmcblk0p20).  If no root= argument is present,
# retain the proven SD default.  Without a usable root stay in this initramfs
# with the USB console below.
ROOTDEV=/dev/mmcblk0p1
ROOTPART=
for arg in $($BB cat /proc/cmdline); do
	case "$arg" in
		# LK appends its own "root=/dev/ram" after the DTB bootargs; ignore it.
		root=/dev/ram*) ;;
		root=/dev/*) ROOTDEV=${arg#root=} ;;
		# root=PARTNAME=USRDATA: find the partition by name, whatever mmcblkN
		# the eMMC got when the microSD slot is enabled too.
		root=PARTNAME=*) ROOTPART=${arg#root=PARTNAME=} ;;
	esac
done
find_part() {
	for u in /sys/class/block/*/uevent; do
		if $BB grep -qx "PARTNAME=$1" "$u"; then
			echo "/dev/$($BB sed -n 's/^DEVNAME=//p' "$u")"
			return
		fi
	done
}
echo "Waiting up to 20 s for root filesystem (${ROOTPART:+PARTNAME=}${ROOTPART:-$ROOTDEV})..."
i=0
while [ $i -lt 20 ]; do
	[ -n "$ROOTPART" ] && ROOTDEV=$(find_part "$ROOTPART")
	[ -b "$ROOTDEV" ] && break
	$BB sleep 1
	i=$((i + 1))
done
# A partition found by name is only booted once the microSD installer has
# verified it and left /b8k-installed; a half-written USRDATA never boots.
MARK=
[ -n "$ROOTPART" ] && MARK=/newroot/b8k-installed

# CWM-style installer: a microSD written with tools/mk-sd-installer.py starts
# with a "B8KINST1" header. If USRDATA has no /b8k-installed, unpack the gzip
# root image from the card into USRDATA, verify its md5, then boot it.
# Only the partition named by root=PARTNAME= is written, never BOOT.
installer_card() {
	for d in /dev/mmcblk[0-9]; do
		[ -b "$d" ] && [ "$($BB head -c 8 "$d" 2>/dev/null)" = B8KINST1 ] &&
			{ echo "$d"; return; }
	done
}
installer_hdr() {
	$BB head -c 4096 "$1" | $BB tr -d '\000' | $BB sed -n "s/^$2=//p"
}
auto_install() {
	SD=$(installer_card)
	[ -n "$SD" ] || { echo "No B8KINST1 microSD found"; return 1; }
	GZ_OFF=$(installer_hdr "$SD" gz_off)
	GZ_LEN=$(installer_hdr "$SD" gz_len)
	RAW_LEN=$(installer_hdr "$SD" raw_len)
	RAW_MD5=$(installer_hdr "$SD" raw_md5)
	if [ -z "$GZ_OFF" ] || [ -z "$GZ_LEN" ] || [ -z "$RAW_LEN" ] || [ -z "$RAW_MD5" ]; then
		echo "Installer header on $SD is incomplete"
		return 1
	fi
	PART=${ROOTDEV#/dev/}
	PART_BYTES=$(($($BB cat /sys/class/block/$PART/size) * 512))
	if [ "$RAW_LEN" -gt "$PART_BYTES" ]; then
		echo "Root image ($RAW_LEN) does not fit $ROOTDEV ($PART_BYTES)"
		return 1
	fi
	M=1048576
	echo "=== INSTALL: $SD -> $ROOTDEV ($ROOTPART), $((RAW_LEN / M)) MiB, do not power off ==="
	(
		$BB dd if="$SD" bs=$M skip=$((GZ_OFF / M)) count=$(((GZ_LEN + M - 1) / M)) 2>/dev/null |
			$BB head -c "$GZ_LEN" | $BB gunzip -c |
			$BB dd of="$ROOTDEV" bs=$M conv=fsync 2>/dev/null
		echo $? > /tmp/install.rc
	) &
	W0=$($BB awk '{ print $7 }' /sys/class/block/$PART/stat)
	while [ ! -e /tmp/install.rc ]; do
		$BB sleep 10
		W=$($BB awk '{ print $7 }' /sys/class/block/$PART/stat)
		echo "INSTALL $(((W - W0) * 512 * 100 / RAW_LEN))% uptime $($BB cut -d' ' -f1 /proc/uptime)s"
	done
	[ "$($BB cat /tmp/install.rc)" = 0 ] || { echo "INSTALL: write failed"; return 1; }
	$BB sync
	echo 3 > /proc/sys/vm/drop_caches
	echo "INSTALL: verifying md5"
	GOT=$($BB head -c "$RAW_LEN" "$ROOTDEV" | $BB md5sum | $BB cut -d' ' -f1)
	if [ "$GOT" != "$RAW_MD5" ]; then
		echo "INSTALL: md5 mismatch ($GOT != $RAW_MD5)"
		return 1
	fi
	$BB mount -t ext4 -o rw,noatime "$ROOTDEV" /newroot || return 1
	# Grow ext4 over the whole USRDATA on first boot (root is /dev/root here).
	R=/newroot/etc/local.d/resize-emmc-root.start
	if [ -e "$R" ]; then
		cat > "$R" <<-'EOF'
		#!/bin/sh
		grep -q root=PARTNAME=USRDATA /proc/cmdline || exit 0
		if resize2fs "$(readlink -f /dev/root)" >/var/log/resize-emmc-root.log 2>&1; then
			mv /etc/local.d/resize-emmc-root.start /etc/local.d/resize-emmc-root.done
		fi
		EOF
		$BB chmod 755 "$R"
	fi
	echo "installed from $SD md5 $RAW_MD5 at uptime $($BB cut -d' ' -f1 /proc/uptime)" \
		> /newroot/b8k-installed
	$BB sync
	$BB umount /newroot
	echo "=== INSTALL: done, booting the installed system ==="
}

if [ -n "$ROOTPART" ] && [ -b "$ROOTDEV" ]; then
	$BB mkdir -p /newroot
	INSTALLED=
	$BB mount -t ext4 -o ro "$ROOTDEV" /newroot 2>/dev/null &&
		[ -e "$MARK" ] && INSTALLED=1
	$BB umount /newroot 2>/dev/null
	[ -n "$INSTALLED" ] || auto_install
fi
if [ -b "$ROOTDEV" ]; then
	$BB ln -sf "${ROOTDEV#/dev/}" /dev/root
	$BB mkdir -p /newroot
	# Check ext4 before mounting it rw: run the root's own e2fsck chrooted
	# into the read-only mounted root (allowed for a ro-mounted "/").
	if $BB mount -t ext4 -o ro "$ROOTDEV" /newroot 2>/dev/null; then
		if [ -x /newroot/sbin/e2fsck ] && { [ -z "$MARK" ] || [ -e "$MARK" ]; }; then
			$BB mount --bind /dev /newroot/dev
			$BB mount --bind /proc /newroot/proc
			echo "Checking $ROOTDEV"
			$BB chroot /newroot /sbin/e2fsck -p "$ROOTDEV" > /tmp/fsck.log 2>&1
			rc=$?
			if [ $rc -ge 4 ]; then
				echo "e2fsck -p rc=$rc, repairing with -fy" >> /tmp/fsck.log
				$BB chroot /newroot /sbin/e2fsck -fy "$ROOTDEV" >> /tmp/fsck.log 2>&1
				rc=$?
			fi
			echo "e2fsck rc=$rc" >> /tmp/fsck.log
			# Screen and kernel log (readable over the USB console later).
			while read -r l; do
				echo "$l"
				echo "b8k-fsck: $l" > /dev/kmsg
			done < /tmp/fsck.log
			$BB umount /newroot/proc /newroot/dev
		fi
		$BB umount /newroot
	fi
	if $BB mount -t ext4 -o rw,noatime "$ROOTDEV" /newroot &&
	   [ -x /newroot/sbin/init ] && { [ -z "$MARK" ] || [ -e "$MARK" ]; }; then
		echo "Switching to root filesystem on $ROOTDEV"
		for m in /dev /proc /sys; do
			$BB mkdir -p "/newroot$m"
			$BB mount --move "$m" "/newroot$m"
		done
		exec $BB switch_root /newroot /sbin/init
	fi
	echo "Root filesystem on $ROOTDEV is not usable, staying in initramfs"
	$BB umount /newroot 2>/dev/null
else
	echo "No root device $ROOTDEV found, staying in initramfs"
fi

(
	while [ ! -e /dev/ttyGS0 ]; do
		$BB sleep 1
	done
	# Raw tty, no echo; a pipe makes ash non-interactive, so it never sends
	# terminal queries (ESC[6n) and just executes each received line.
	# Every line is also shown on the screen.
	$BB stty -F /dev/ttyGS0 raw -echo
	echo "B8000-H Linux serial shell ready" > /dev/ttyGS0
	while true; do
		$BB cat /dev/ttyGS0 | $BB tee /dev/console | $BB sh >/dev/ttyGS0 2>&1
		echo "shell exited, restarting" > /dev/console
		$BB sleep 1
	done
) &

# One full diagnostic report once the host had time to open the port.
(
	while [ ! -e /dev/ttyGS0 ]; do
		$BB sleep 1
	done
	$BB sleep 15
	{
		echo "=== REPORT uptime $($BB cut -d' ' -f1 /proc/uptime) ==="
		echo "=== TTY ==="
		$BB stty -a -F /dev/ttyGS0
		echo "=== PROCS ==="
		for p in /proc/[0-9]*; do
			echo "${p#/proc/} $($BB cat $p/wchan 2>/dev/null) $($BB tr '\0' ' ' < $p/cmdline 2>/dev/null)"
		done
		echo "=== INTERRUPTS ==="
		$BB cat /proc/interrupts
		echo "=== DMESG ==="
		$BB dmesg
		echo "=== END REPORT ==="
	} > /dev/ttyGS0
) &

echo "Init is alive. Waiting for USB serial access."
while true; do
	$BB sleep 10
	echo "--- diag $($BB cut -d' ' -f1 /proc/uptime)s udc=$($BB cat /sys/class/udc/*/state 2>/dev/null) $($BB grep musb /proc/interrupts | $BB tr -s ' ')"
	$BB dmesg | $BB grep -E 'B8000H-DBG[23]' | $BB tail -n 14
done
