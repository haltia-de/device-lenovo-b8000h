#!/bin/busybox sh

BB=/bin/busybox

$BB mkdir -p /dev /proc /sys /run /tmp
$BB mount -t devtmpfs devtmpfs /dev
exec >/dev/console 2>&1

$BB mount -t proc proc /proc
$BB mount -t sysfs sysfs /sys
$BB mkdir -p /dev/pts /sys/kernel/config /sys/kernel/debug /sys/fs/pstore
$BB mount -t devpts devpts /dev/pts
$BB mount -t configfs configfs /sys/kernel/config
$BB mount -t debugfs debugfs /sys/kernel/debug
$BB mount -t pstore pstore /sys/fs/pstore

echo
echo "B8000-H safe Linux bring-up initramfs"
echo "No internal Android partition is mounted by this initramfs."
echo "Kernel: $($BB uname -a)"
echo "Command line: $($BB cat /proc/cmdline)"
echo "Pstore:"
$BB ls -la /sys/fs/pstore

G=/sys/kernel/config/usb_gadget/b8000h
if [ -d /sys/kernel/config/usb_gadget ]; then
	$BB mkdir -p "$G/strings/0x409" "$G/configs/c.1/strings/0x409"
	echo 0x1d6b > "$G/idVendor"
	echo 0x0104 > "$G/idProduct"
	echo B8000H-LINUX > "$G/strings/0x409/serialnumber"
	echo "B8000-H" > "$G/strings/0x409/manufacturer"
	echo "Safe Linux serial console" > "$G/strings/0x409/product"
	echo "ACM console" > "$G/configs/c.1/strings/0x409/configuration"
	$BB mkdir -p "$G/functions/acm.usb0"
	$BB ln -s "$G/functions/acm.usb0" "$G/configs/c.1/acm.usb0"
	UDC=$($BB ls /sys/class/udc | $BB head -n 1)
	if [ -n "$UDC" ]; then
		echo "$UDC" > "$G/UDC"
		echo "USB ACM gadget bound to $UDC"
	else
		echo "No USB device controller appeared"
	fi
else
	echo "USB gadget configfs is unavailable"
fi

(
	while [ ! -e /dev/ttyGS0 ]; do
		$BB sleep 1
	done
	echo "B8000-H Linux serial shell ready" > /dev/ttyGS0
	# -v echoes every received input line to stderr = the screen, so the
	# screen proves USB OUT (host->tablet) works; command output goes to USB IN.
	$BB setsid $BB sh -c 'exec /bin/busybox sh -v </dev/ttyGS0 >/dev/ttyGS0 2>/dev/console'
) &

# USB IN (tablet->host) works, USB OUT (host->tablet) wedges musb in PIO mode.
# So push diagnostics to the host without ever needing input.
(
	i=0
	while true; do
		i=$((i + 1))
		if [ -e /dev/ttyGS0 ]; then
			{
				echo "=== REPORT $i uptime $($BB cut -d' ' -f1 /proc/uptime) ==="
				echo "=== PSTORE ==="
				for f in /sys/fs/pstore/*; do
					[ -f "$f" ] && echo "--- $f" && $BB cat "$f"
				done
				echo "=== INTERRUPTS ==="
				$BB cat /proc/interrupts
				echo "=== DMESG ==="
				$BB dmesg
				echo "=== END REPORT $i ==="
			} > /dev/ttyGS0
		fi
		$BB sleep 20
	done
) &

echo "Init is alive. Waiting for USB serial access."
while true; do
	$BB sleep 10
	echo "--- diag $($BB cut -d' ' -f1 /proc/uptime)s udc=$($BB cat /sys/class/udc/*/state 2>/dev/null)"
	$BB grep -i -E 'musb|usb' /proc/interrupts
done
