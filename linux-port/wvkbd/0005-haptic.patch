+/*
+ * B8000-H: a buzz on every key press. The vibration motor is the
+ * "regulator-haptic" input device (MT6320 VIBR LDO). The device and one
+ * FF_RUMBLE effect are set up on the first press; each press then only
+ * starts the effect, so typing is not delayed. 70 ms: a shorter pulse is
+ * not felt, the motor needs time to spin up.
+ */
+#define HAPTIC_MS 70
+
+static void
+haptic_tick(void)
+{
+    static int fd = -2;
+    static short effect_id = -1;
+    struct input_event play;
+
+    if (fd == -2) {
+        DIR *dir = opendir("/sys/class/input");
+        struct dirent *de;
+
+        fd = -1;
+        while (dir && (de = readdir(dir))) {
+            char path[300], name[64] = "";
+            FILE *f;
+
+            if (strncmp(de->d_name, "event", 5))
+                continue;
+            snprintf(path, sizeof(path), "/sys/class/input/%s/device/name",
+                     de->d_name);
+            f = fopen(path, "r");
+            if (!f)
+                continue;
+            if (fgets(name, sizeof(name), f))
+                name[strcspn(name, "\n")] = '\0';
+            fclose(f);
+            if (!strcmp(name, "regulator-haptic")) {
+                snprintf(path, sizeof(path), "/dev/input/%s", de->d_name);
+                fd = open(path, O_RDWR | O_CLOEXEC);
+                break;
+            }
+        }
+        if (dir)
+            closedir(dir);
+        if (fd >= 0) {
+            struct ff_effect effect;
+
+            memset(&effect, 0, sizeof(effect));
+            effect.type = FF_RUMBLE;
+            effect.id = -1;
+            effect.u.rumble.strong_magnitude = 0xffff;
+            effect.replay.length = HAPTIC_MS;
+            if (ioctl(fd, EVIOCSFF, &effect) == 0) {
+                effect_id = effect.id;
+            } else {
+                close(fd);
+                fd = -1;
+            }
+        }
+    }
+    if (fd < 0)
+        return;
+    memset(&play, 0, sizeof(play));
+    play.type = EV_FF;
+    play.code = (unsigned short)effect_id;
+    play.value = 1;
+    if (write(fd, &play, sizeof(play)) < 0) {
+        /* The device went away; look for it again on the next press. */
+        close(fd);
+        fd = -2;
+    }
+}
+
