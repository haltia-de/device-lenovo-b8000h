diff --git a/keyboard.c b/keyboard.c
index ea3be7e..593f5ab 100644
--- a/keyboard.c
+++ b/keyboard.c
@@ -498,13 +498,10 @@ kbd_press_key(struct kbd *kb, struct key *k, uint32_t time)
     case Layout:
         // switch to the layout determined by the key
         kbd_switch_layout(kb, k->layout, kbd_get_layer_index(kb, k->layout));
-        // reset previous layout to default/first so we don't get any weird
-        // cycles
-        kb->last_abc_index = 0;
-        if (kb->landscape) {
-            kb->last_abc_layout = &kb->layouts[kb->landscape_layers[0]];
-        } else {
-            kb->last_abc_layout = &kb->layouts[kb->layers[0]];
+        // Remember an alphabet so the numbers layer can return to it.
+        if (k->layout && k->layout->abc) {
+            kb->last_abc_layout = k->layout;
+            kb->last_abc_index = kbd_get_layer_index(kb, k->layout);
         }
         break;
     case Compose:
@@ -529,13 +526,9 @@ kbd_press_key(struct kbd *kb, struct key *k, uint32_t time)
         if (kb->last_abc_layout) {
             kb->compose = 0;
             kbd_switch_layout(kb, kb->last_abc_layout, kb->last_abc_index);
-            // reset previous layout to default/first so we don't get any weird
-            // cycles
-            kb->last_abc_index = 0;
-            if (kb->landscape) {
-                kb->last_abc_layout = &kb->layouts[kb->landscape_layers[0]];
-            } else {
-                kb->last_abc_layout = &kb->layouts[kb->layers[0]];
+            if (kb->layout && kb->layout->abc) {
+                kb->last_abc_layout = kb->layout;
+                kb->last_abc_index = kb->layer_index;
             }
         }
         break;
@@ -559,6 +552,10 @@ kbd_press_key(struct kbd *kb, struct key *k, uint32_t time)
         if (kb->print || kb->print_intersect)
             kbd_print_key_stdout(kb, k);
         break;
+    case Hide:
+        if (kb->on_hide)
+            kb->on_hide();
+        break;
     default:
         break;
     }
