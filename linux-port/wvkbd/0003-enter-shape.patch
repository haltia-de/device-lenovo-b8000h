+/* The bottom bar of an enter key uses the pads reserved on the next row,
+ * so it starts where the letters end. */
+static void
+kbd_place_feet(struct layout *l)
+{
+    struct key *k = l->keys;
+    while (k->type != Last) {
+        k->lfoot_px = 0;
+        if (k->lrows > 1 && k->lfoot > 0 && k->w > 0) {
+            uint32_t next_y = k->y + l->keyheight;
+            uint32_t left = k->x;
+            struct key *p = l->keys;
+            while (p->type != Last) {
+                if (p->type == Pad && p->y == next_y && p->w > 0 &&
+                    p->x < k->x + k->w && p->x + p->w >= k->x && p->x < left)
+                    left = p->x;
+                p++;
+            }
+            if (left < k->x)
+                k->lfoot_px = k->x - left;
+            if (k->lfoot_px == 0)
+                k->lfoot_px = (uint32_t)(k->lfoot * ((double)k->w / k->width));
+            if (k->lfoot_px > k->x)
+                k->lfoot_px = k->x;
+        }
+        k++;
+    }
+}
