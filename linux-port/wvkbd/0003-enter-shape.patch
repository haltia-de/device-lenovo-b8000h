+
+/* Stem on the right, two rows tall. Foot is the bottom bar to its left. */
+static void
+draw_l_key(struct kbd *kb, struct key *k, enum key_draw_type type)
+{
+    struct clr_scheme *scheme = &kb->schemes[k->scheme];
+    Color face = scheme->fg;
+    Color text = scheme->text;
+    bool over = false;
+    uint32_t row_h = k->h / k->lrows;
+
+    if (type == Press && kb->show_highlight) {
+        face = scheme->high;
+        text = scheme->text_press;
+    } else if (type == Swipe) {
+        face = scheme->swipe;
+        text = scheme->text_swipe;
+        over = true;
+    }
+    if (k->lfoot_px > 0)
+        draw_key_face(kb->surf, k->x - k->lfoot_px, k->y + row_h,
+                      k->lfoot_px + k->w, row_h, face, scheme->rounding, over);
+    draw_key_face(kb->surf, k->x, k->y, k->w, k->h, face, scheme->rounding,
+                  over);
+    drw_draw_text(kb->surf, text, k->x, k->y, k->w, k->h, KBD_KEY_BORDER,
+                  k->label, scheme->font_description);
+}
+
+static void
+draw_split_line(struct drwsurf *ds, uint32_t x, uint32_t y, uint32_t h)
+{
+    drwsurf_flip(ds);
+    struct drwbuf *d = ds->back_buffer;
+    drwsurf_damage(ds, x - 1, y, 3, h);
+    cairo_save(d->cairo);
+    cairo_set_source_rgba(d->cairo, 0.09, 0.10, 0.12, 1);
+    cairo_set_line_width(d->cairo, 2);
+    cairo_move_to(d->cairo, x + 0.5, y);
+    cairo_line_to(d->cairo, x + 0.5, y + h);
+    cairo_stroke(d->cairo);
+    cairo_restore(d->cairo);
+}
+
+static void
+draw_split_key(struct kbd *kb, struct key *k, enum key_draw_type type)
+{
+    struct clr_scheme *scheme = &kb->schemes[k->scheme];
+    Color face = scheme->fg;
+    Color text = scheme->text;
+    bool over = false;
+    uint32_t mid, half, y0, lh;
+
+    if (type == Press && kb->show_highlight) {
+        face = scheme->high;
+        text = scheme->text_press;
+    } else if (type == Swipe) {
+        face = scheme->swipe;
+        text = scheme->text_swipe;
+        over = true;
+    }
+    draw_key_face(kb->surf, k->x, k->y, k->w, k->h, face, scheme->rounding,
+                  over);
+    mid = k->x + k->w / 2;
+    half = k->w / 2;
+    y0 = k->y + KBD_KEY_BORDER + 10;
+    lh = k->h - (KBD_KEY_BORDER + 10) * 2;
+    if (lh > 8)
+        draw_split_line(kb->surf, mid, y0, lh);
+    drw_draw_text(kb->surf, text, k->x, k->y, half, k->h, KBD_KEY_BORDER,
+                  k->label, scheme->font_description);
+    drw_draw_text(kb->surf, text, mid, k->y, k->w - half, k->h, KBD_KEY_BORDER,
+                  k->split_label, scheme->font_description);
+}
