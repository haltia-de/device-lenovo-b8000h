+static void
+draw_lock_bar(struct drwsurf *ds, uint32_t x, uint32_t y, uint32_t w,
+              uint32_t h)
+{
+    drwsurf_flip(ds);
+    struct drwbuf *d = ds->back_buffer;
+    drwsurf_damage(ds, x, y, w, h);
+    cairo_save(d->cairo);
+    cairo_set_operator(d->cairo, CAIRO_OPERATOR_SOURCE);
+    cairo_set_source_rgba(d->cairo, 1.0, 230.0 / 255.0, 40.0 / 255.0, 1.0);
+    cairo_rectangle(d->cairo, x, y, w, h);
+    cairo_fill(d->cairo);
+    cairo_restore(d->cairo);
+}
