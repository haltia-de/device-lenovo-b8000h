+/* One letter: ASCII, or a single Cyrillic character (two UTF-8 bytes). */
+static bool
+kbd_label_is_letter(const char *s)
+{
+    unsigned char c, c1;
+
+    if (!s || !s[0])
+        return false;
+    c = (unsigned char)s[0];
+    if ((c & 0x80) == 0)
+        return s[1] == '\0' && isalpha((int)c);
+    if ((c == 0xD0 || c == 0xD1) && s[1] && s[2] == '\0') {
+        c1 = (unsigned char)s[1];
+        return c1 >= 0x80 && c1 <= 0xBF;
+    }
+    return false;
+}
