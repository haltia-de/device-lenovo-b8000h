+/* The arrow stays white until shift or caps is on, then it turns yellow.
+ * Caps also draws a bar under the arrow so the lock is visible. */
+static void
+draw_shift_key(struct kbd *kb, struct key *k, enum key_draw_type type)
+{
+    struct clr_scheme *scheme = &kb->schemes[k->scheme];
+    bool on = (kb->mods & Shift) || (kb->mods & CapsLock);
+    bool locked = (kb->mods & CapsLock) != 0;
+    Color face = scheme->fg;
+    Color text = scheme->text;
+    Color lit;
+    bool over = false;
+    uint32_t bw, bh, bx, by;
+
+    if (type == Swipe) {
+        face = scheme->swipe;
+        text = scheme->text_swipe;
+        over = true;
+    } else if (on || (type == Press && kb->show_highlight)) {
+        face = scheme->high;
+    }
+    if (on) {
+        lit.bgra[0] = 40;
+        lit.bgra[1] = 230;
+        lit.bgra[2] = 255;
+        lit.bgra[3] = 255;
+        text = lit;
+    }
+    draw_key_face(kb->surf, k->x, k->y, k->w, k->h, face, scheme->rounding,
+                  over);
+    drw_draw_text(kb->surf, text, k->x, k->y, k->w, k->h, KBD_KEY_BORDER,
+                  k->label, scheme->font_description);
+    if (!locked || k->w < 12 || k->h < 24)
+        return;
+    bw = k->w / 3;
+    bh = 4;
+    bx = k->x + (k->w - bw) / 2;
+    by = k->y + k->h - KBD_KEY_BORDER - bh - 6;
+    draw_lock_bar(kb->surf, bx, by, bw, bh);
+}
