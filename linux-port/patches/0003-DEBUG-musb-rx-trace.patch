diff --git a/drivers/usb/musb/mediatek.c b/drivers/usb/musb/mediatek.c
index efc64d913..4993ff26c 100644
--- a/drivers/usb/musb/mediatek.c
+++ b/drivers/usb/musb/mediatek.c
@@ -206,6 +206,32 @@ static irqreturn_t generic_interrupt(int irq, void *__hci)
 		musb_writeb(musb->mregs, MUSB_FADDR, 0);
 	}
 
+	{
+		/* B8000H-DBG: trace the first data-endpoint interrupts. */
+		static int dbg_n;
+
+		if ((musb->int_rx || (musb->int_tx & ~1)) && dbg_n < 40) {
+			dbg_n++;
+			pr_info("B8000H-DBG irq#%d usb=%02x tx=%04x rx=%04x txe=%04x rxe=%04x l1s=%08x l1m=%08x\n",
+				dbg_n, musb->int_usb, musb->int_tx, musb->int_rx,
+				musb_readw(musb->mregs, MUSB_INTRTXE),
+				musb_readw(musb->mregs, MUSB_INTRRXE),
+				musb_readl(musb->mregs, USB_L1INTS),
+				musb_readl(musb->mregs, USB_L1INTM));
+		}
+	}
+
+	{
+		extern int b8k_rx_seen;
+		static int dbg3;
+
+		if (b8k_rx_seen && dbg3 < 20) {
+			dbg3++;
+			pr_info("B8000H-DBG3 after-rx irq#%d usb=%02x tx=%04x rx=%04x l1s=%08x\n",
+				dbg3, musb->int_usb, musb->int_tx, musb->int_rx,
+				musb_readl(musb->mregs, USB_L1INTS));
+		}
+	}
 	if (musb->int_usb || musb->int_tx || musb->int_rx)
 		retval = musb_interrupt(musb);
 
diff --git a/drivers/usb/musb/musb_gadget.c b/drivers/usb/musb/musb_gadget.c
index 016d3f3fc..2389c0001 100644
--- a/drivers/usb/musb/musb_gadget.c
+++ b/drivers/usb/musb/musb_gadget.c
@@ -516,6 +516,11 @@ void musb_g_tx(struct musb *musb, u8 epnum)
 /*
  * Context: controller locked, IRQs blocked, endpoint selected
  */
+int b8k_rx_seen;
+EXPORT_SYMBOL_GPL(b8k_rx_seen);
+static int b8k_dbg2;
+#define B8K(fmt, ...) do { if (b8k_dbg2 < 60) { b8k_dbg2++; pr_info("B8000H-DBG2 " fmt "\n", ##__VA_ARGS__); } } while (0)
+
 static void rxstate(struct musb *musb, struct musb_request *req)
 {
 	const u8		epnum = req->epnum;
@@ -764,9 +769,11 @@ static void rxstate(struct musb *musb, struct musb_request *req)
 			fifo_count = min_t(unsigned int,
 					request->length - request->actual,
 					(unsigned int)fifo_count);
+			B8K("rx ep%d pre-read cnt=%u len=%u csr=%04x", epnum, fifo_count, request->length, musb_readw(epio, MUSB_RXCSR));
 			musb_read_fifo(musb_ep->hw_ep, fifo_count, (u8 *)
 					(request->buf + request->actual));
 			request->actual += fifo_count;
+			B8K("rx ep%d read ok first=%02x csr=%04x", epnum, ((u8 *)request->buf)[0], musb_readw(epio, MUSB_RXCSR));
 
 			/* REVISIT if we left anything in the fifo, flush
 			 * it and report -EOVERFLOW
@@ -776,13 +783,22 @@ static void rxstate(struct musb *musb, struct musb_request *req)
 			csr |= MUSB_RXCSR_P_WZC_BITS;
 			csr &= ~MUSB_RXCSR_RXPKTRDY;
 			musb_writew(epio, MUSB_RXCSR, csr);
+			b8k_rx_seen = 1;
+			B8K("rx ep%d acked wrote=%04x now=%04x", epnum, csr, musb_readw(epio, MUSB_RXCSR));
+		} else {
+			B8K("rx ep%d pktrdy but actual=%u>=len=%u", epnum, request->actual, request->length);
 		}
+	} else {
+		B8K("rx ep%d no pktrdy csr=%04x", epnum, csr);
 	}
 
 	/* reach the end or short packet detected */
 	if (request->actual == request->length ||
-	    fifo_count < musb_ep->packet_sz)
+	    fifo_count < musb_ep->packet_sz) {
+		B8K("rx ep%d giveback actual=%u", epnum, request->actual);
 		musb_g_giveback(musb_ep, request, 0);
+		B8K("rx ep%d giveback done", epnum);
+	}
 }
 
 /*
@@ -807,6 +823,18 @@ void musb_g_rx(struct musb *musb, u8 epnum)
 	musb_ep_select(mbase, epnum);
 
 	req = next_request(musb_ep);
+	{
+		/* B8000H-DBG */
+		static int dbg_rx;
+
+		if (dbg_rx < 40) {
+			dbg_rx++;
+			pr_info("B8000H-DBG g_rx#%d ep%d req=%d rxcsr=%04x rxcount=%u\n",
+				dbg_rx, epnum, req ? 1 : 0,
+				musb_readw(epio, MUSB_RXCSR),
+				musb_readw(epio, MUSB_RXCOUNT));
+		}
+	}
 	if (!req)
 		return;
 
