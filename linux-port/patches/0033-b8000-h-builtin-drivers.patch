+
+    if(pvSetBuffer != NULL && u4SetBufferLen != 0) {
+        prScanRequest = (P_PARAM_SCAN_REQUEST_EXT_T)pvSetBuffer;
+        prSsid = &(prScanRequest->rSsid);
+        pucIe = prScanRequest->pucIE;
+        u4IeLength = prScanRequest->u4IELength;
