+                 &u4BufLen);
+    
+    if (rStatus != WLAN_STATUS_SUCCESS) {
+        DBGLOG(INIT, INFO, ("flush pmkid error:%lx\n", rStatus));
+    }
+    kalMemFree(prPmkid, VIR_MEM_TYPE, 8);
+
+    return 0;
+}
