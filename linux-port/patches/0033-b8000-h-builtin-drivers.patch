@@ -0,0 +1,839 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek MT6628 WMT/STP driver for the Lenovo B8000-H.
+ *
+ * The command stream, patch format and power timing are derived from the
+ * GPL-2.0 MediaTek 3.4 driver (stp_core.c, wmt_core.c, wmt_ic_6628.c and
+ * wmt_func.c). The tty line discipline and 6620_launcher are replaced by
+ * serdev and firmware_class.
+ */
+
+#include <linux/clk.h>
+#include <linux/completion.h>
+#include <linux/crc16.h>
+#include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/gpio/consumer.h>
+#include <linux/interrupt.h>
+#include <linux/mmc/host.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_irq.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/pm_wakeup.h>
+#include <linux/property.h>
+#include <linux/serdev.h>
+#include <linux/slab.h>
+
+#include "mt6628.h"
+
+#define MT6628_FW_PATCH_E1       "mt6628_patch_e1_hdr.bin"
+#define MT6628_FW_PATCH_E2_0     "mt6628_patch_e2_0_hdr.bin"
+#define MT6628_FW_PATCH_E2_1     "mt6628_patch_e2_1_hdr.bin"
+#define MT6628_FW_CONFIG         "WMT.cfg"
+
+#define MT6628_WMT_TYPE          4
+#define MT6628_PATCH_HEADER_SIZE 28
+#define MT6628_PATCH_FRAGMENT    1000
+#define MT6628_RX_MAX            2048
+#define MT6628_XFER_TIMEOUT      msecs_to_jiffies(3000)
+
+enum mt6628_stp_mode {
+	MT6628_STP_MANDATORY,
+	MT6628_STP_FULL,
+};
+
+struct mt6628_stp_parser {
+	u8 hdr[4];
+	u8 payload[MT6628_RX_MAX];
+	u8 crc[2];
+	u16 payload_len;
+	u16 pos;
+	u8 hdr_pos;
+	u8 crc_pos;
+};
+
+struct mt6628_wmt {
+	struct serdev_device *serdev;
+	struct gpio_desc *pmu;
+	struct gpio_desc *reset;
+	struct clk *clk32k;
+	struct mmc_host *mmc;
+	struct mutex lock;
+	spinlock_t rx_lock;
+	struct completion response;
+	struct mt6628_stp_parser parser;
+	u8 response_buf[MT6628_RX_MAX];
+	size_t response_len;
+	unsigned int users;
+	unsigned int operational_baud;
+	u32 off_stable_ms;
+	u32 rtc_stable_ms;
+	u32 reset_stable_ms;
+	u32 on_stable_ms;
+	u16 hw_ver;
+	u16 fw_ver;
+	u8 tx_seq;
+	u8 rx_ack;
+	enum mt6628_stp_mode stp_mode;
+	bool powered;
+	bool initialized;
+};
+
+static DEFINE_MUTEX(mt6628_global_lock);
+static struct mt6628_wmt *mt6628_global;
+
+static bool wmt_wifi_func_ctrl;
+module_param(wmt_wifi_func_ctrl, bool, 0644);
+MODULE_PARM_DESC(wmt_wifi_func_ctrl, "send WMT_FUNC_CTRL(Wi-Fi) (vendor does not)");
+
+static const u8 wmt_query_baud[] = { 0x01, 0x04, 0x01, 0x00, 0x02 };
+static const u8 wmt_query_stp[] = { 0x01, 0x04, 0x01, 0x00, 0x04 };
+static const u8 wmt_reset[] = { 0x01, 0x07, 0x01, 0x00, 0x04 };
+static const u8 wmt_reset_evt[] = { 0x02, 0x07, 0x01, 0x00, 0x00 };
+static const u8 wmt_patch_evt[] = { 0x02, 0x01, 0x01, 0x00, 0x00 };
+static const u8 wmt_set_stp[] = {
+	0x01, 0x04, 0x05, 0x00, 0x03, 0xdf, 0x0e, 0x68, 0x01
+};
+static const u8 wmt_set_stp_evt[] = { 0x02, 0x04, 0x02, 0x00, 0x00, 0x03 };
+static const u8 wmt_query_stp_full_evt[] = {
+	0x02, 0x04, 0x06, 0x00, 0x00, 0x04, 0xdf, 0x0e, 0x68, 0x01
+};
+/* byte 5 = coex_wmt_ant_mode (stock mt6628_ant_m1.cfg: 1) */
+static const u8 wmt_coex[] = { 0x01, 0x10, 0x02, 0x00, 0x01, 0x01 };
+static const u8 wmt_coex_evt[] = { 0x02, 0x10, 0x01, 0x00, 0x00 };
+static const u8 wmt_sdio_drive[] = {
+	0x01, 0x08, 0x10, 0x00, 0x01, 0x01, 0x00, 0x01,
+	/* 0x80050050 = sdio_driving_cfg 0x00077777 (stock mt6628_ant_m1.cfg) */
+	0x50, 0x00, 0x05, 0x80, 0x77, 0x77, 0x07, 0x00,
+	0x77, 0x77, 0x07, 0x00
+};
+static const u8 wmt_sdio_drive_evt[] = {
+	0x02, 0x08, 0x04, 0x00, 0x00, 0x00, 0x00, 0x01
+};
+static const u8 wmt_fm_strap[] = { 0x01, 0x05, 0x02, 0x00, 0x02, 0x02 };
+static const u8 wmt_fm_strap_evt[] = { 0x02, 0x05, 0x02, 0x00, 0x00, 0x02 };
+
+static void mt6628_read_delay(struct device *dev, const char *name,
+			      u32 *value, u32 fallback)
+{
+	if (device_property_read_u32(dev, name, value))
+		*value = fallback;
+}
+
+static void mt6628_parser_reset(struct mt6628_stp_parser *p)
+{
+	p->hdr_pos = 0;
+	p->payload_len = 0;
+	p->pos = 0;
+	p->crc_pos = 0;
+}
+
+static void mt6628_deliver_packet(struct mt6628_wmt *wmt,
+				  const u8 *payload, size_t len)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&wmt->rx_lock, flags);
+	if (!completion_done(&wmt->response)) {
+		wmt->response_len = min(len, sizeof(wmt->response_buf));
+		memcpy(wmt->response_buf, payload, wmt->response_len);
+		complete(&wmt->response);
+	}
+	spin_unlock_irqrestore(&wmt->rx_lock, flags);
+}
+
+static void mt6628_parse_byte(struct mt6628_wmt *wmt, u8 byte)
+{
+	struct mt6628_stp_parser *p = &wmt->parser;
+	u16 expected_crc, received_crc;
+	u8 type;
+
+	if (p->hdr_pos < sizeof(p->hdr)) {
+		if (!p->hdr_pos && !(byte & 0x80))
+			return;
+		p->hdr[p->hdr_pos++] = byte;
+		if (p->hdr_pos != sizeof(p->hdr))
+			return;
+		p->payload_len = ((p->hdr[1] & 0x0f) << 8) | p->hdr[2];
+		if (!p->payload_len || p->payload_len > sizeof(p->payload) ||
+		    (wmt->stp_mode == MT6628_STP_FULL &&
+		     p->hdr[3] != (u8)(p->hdr[0] + p->hdr[1] + p->hdr[2])))
+			mt6628_parser_reset(p);
+		return;
+	}
+
+	if (p->pos < p->payload_len) {
+		p->payload[p->pos++] = byte;
+		return;
+	}
+	p->crc[p->crc_pos++] = byte;
+	if (p->crc_pos != sizeof(p->crc))
+		return;
+
+	type = p->hdr[1] >> 4;
+	received_crc = p->crc[0] | (p->crc[1] << 8);
+	expected_crc = crc16(0, p->payload, p->payload_len);
+	if (wmt->stp_mode == MT6628_STP_FULL && received_crc != expected_crc) {
+		dev_warn_ratelimited(&wmt->serdev->dev,
+				     "STP CRC mismatch: got %#x expected %#x\n",
+				     received_crc, expected_crc);
+		goto out;
+	}
+	if (wmt->stp_mode == MT6628_STP_FULL)
+		wmt->rx_ack = (((p->hdr[0] >> 3) & 7) + 1) & 7;
+	if (type == MT6628_WMT_TYPE)
+		mt6628_deliver_packet(wmt, p->payload, p->payload_len);
+out:
+	mt6628_parser_reset(p);
+}
+
+static bool debug_io;
+module_param(debug_io, bool, 0644);
+MODULE_PARM_DESC(debug_io, "hex-dump UART3 traffic");
+
+static size_t mt6628_receive_buf(struct serdev_device *serdev,
+				 const unsigned char *data, size_t count)
+{
+	struct mt6628_wmt *wmt = serdev_device_get_drvdata(serdev);
+	size_t i;
+
+	if (debug_io)
+		dev_info(&serdev->dev, "rx %zu: %*ph\n", count,
+			 (int)min_t(size_t, count, 32), data);
+	for (i = 0; i < count; i++)
+		mt6628_parse_byte(wmt, data[i]);
+	return count;
+}
+
+static void mt6628_write_wakeup(struct serdev_device *serdev)
+{
+	serdev_device_write_wakeup(serdev);
+}
+
+static const struct serdev_device_ops mt6628_serdev_ops = {
+	.receive_buf = mt6628_receive_buf,
+	.write_wakeup = mt6628_write_wakeup,
+};
+
+static int mt6628_uart_write(struct mt6628_wmt *wmt, const u8 *buf, size_t len)
+{
+	ssize_t written;
+
+	if (debug_io)
+		dev_info(&wmt->serdev->dev, "tx %zu: %*ph\n", len,
+			 (int)min_t(size_t, len, 32), buf);
+	written = serdev_device_write(wmt->serdev, buf, len,
+				      MT6628_XFER_TIMEOUT);
+	if (written < 0)
+		return written;
+	if (written != len)
+		return -EIO;
+	serdev_device_wait_until_sent(wmt->serdev, MT6628_XFER_TIMEOUT);
+	return 0;
+}
+
+static int mt6628_stp_send(struct mt6628_wmt *wmt, const u8 *payload,
+			   size_t len)
+{
+	u8 *packet;
+	u16 crc;
+	int ret;
+
+	if (!len || len > 0xfff)
+		return -EINVAL;
+	packet = kmalloc(len + 6, GFP_KERNEL);
+	if (!packet)
+		return -ENOMEM;
+
+	packet[0] = wmt->stp_mode == MT6628_STP_FULL ?
+		0x80 | (wmt->tx_seq << 3) | wmt->rx_ack : 0x80;
+	packet[1] = (MT6628_WMT_TYPE << 4) | ((len >> 8) & 0x0f);
+	packet[2] = len & 0xff;
+	packet[3] = wmt->stp_mode == MT6628_STP_FULL ?
+		(u8)(packet[0] + packet[1] + packet[2]) : 0;
+	memcpy(packet + 4, payload, len);
+	crc = wmt->stp_mode == MT6628_STP_FULL ? crc16(0, payload, len) : 0;
+	packet[len + 4] = crc & 0xff;
+	packet[len + 5] = crc >> 8;
+
+	ret = mt6628_uart_write(wmt, packet, len + 6);
+	if (!ret && wmt->stp_mode == MT6628_STP_FULL)
+		wmt->tx_seq = (wmt->tx_seq + 1) & 7;
+	kfree(packet);
+	return ret;
+}
+
+static int mt6628_xfer(struct mt6628_wmt *wmt, const u8 *cmd, size_t cmd_len,
+			const u8 *expected, size_t expected_len)
+{
+	unsigned long flags;
+	int ret;
+
+	spin_lock_irqsave(&wmt->rx_lock, flags);
+	reinit_completion(&wmt->response);
+	wmt->response_len = 0;
+	spin_unlock_irqrestore(&wmt->rx_lock, flags);
+	ret = mt6628_stp_send(wmt, cmd, cmd_len);
+	if (ret)
+		return ret;
+	if (!wait_for_completion_timeout(&wmt->response, MT6628_XFER_TIMEOUT))
+		return -ETIMEDOUT;
+	if (wmt->response_len != expected_len)
+		return -EPROTO;
+	if (expected && memcmp(wmt->response_buf, expected, expected_len)) {
+		dev_err(&wmt->serdev->dev,
+			"unexpected WMT event for opcode %#x\n", cmd[1]);
+		return -EPROTO;
+	}
+	return 0;
+}
+
+static int mt6628_reg_read(struct mt6628_wmt *wmt, u32 address, u32 *value)
+{
+	u8 cmd[20] = {
+		0x01, 0x08, 0x10, 0x00, 0x02, 0x01, 0x00, 0x01,
+	};
+	u8 expected_prefix[8] = {
+		0x02, 0x08, 0x0c, 0x00, 0x00, 0x00, 0x00, 0x01,
+	};
+	int ret;
+
+	put_unaligned_le32(address, cmd + 8);
+	put_unaligned_le32(0, cmd + 12);
+	put_unaligned_le32(0xffffffff, cmd + 16);
+	ret = mt6628_xfer(wmt, cmd, sizeof(cmd), NULL, 16);
+	if (ret)
+		return ret;
+	if (memcmp(wmt->response_buf, expected_prefix, sizeof(expected_prefix)) ||
+	    get_unaligned_le32(wmt->response_buf + 8) != address)
+		return -EPROTO;
+	*value = get_unaligned_le32(wmt->response_buf + 12);
+	return 0;
+}
+
+static int mt6628_set_baud(struct mt6628_wmt *wmt)
+{
+	u8 cmd[] = { 0x01, 0x04, 0x05, 0x00, 0x01, 0, 0, 0, 0 };
+	const u8 evt[] = { 0x02, 0x04, 0x02, 0x00, 0x00, 0x01 };
+	unsigned int actual;
+	int ret;
+
+	put_unaligned_le32(wmt->operational_baud, cmd + 5);
+	cmd[8] = 0;
+	ret = mt6628_xfer(wmt, cmd, sizeof(cmd), evt, sizeof(evt));
+	if (ret)
+		return ret;
+	actual = serdev_device_set_baudrate(wmt->serdev,
+					    wmt->operational_baud);
+	if (actual != wmt->operational_baud)
+		return -EINVAL;
+	serdev_device_set_flow_control(wmt->serdev, false);
+	usleep_range(2000, 3000);
+	return 0;
+}
+
+static int mt6628_patch_address(struct mt6628_wmt *wmt, const u8 address[4])
+{
+	static const u8 part_cmd[] = {
+		0x01, 0x08, 0x10, 0x00, 0x01, 0x01, 0x00, 0x01,
+		0xd4, 0x01, 0x09, 0xf0, 0x00, 0x00, 0x00, 0x00,
+		0xff, 0xff, 0xff, 0xff
+	};
+	static const u8 part_evt[] = {
+		0x02, 0x08, 0x04, 0x00, 0x00, 0x00, 0x00, 0x01
+	};
+	u8 address_cmd[] = {
+		0x01, 0x08, 0x10, 0x00, 0x01, 0x01, 0x00, 0x01,
+		0x48, 0x03, 0x09, 0xf0, 0, 0, 0, 0,
+		0xff, 0xff, 0xff, 0xff
+	};
+	int ret;
+
+	ret = mt6628_xfer(wmt, part_cmd, sizeof(part_cmd),
+			  part_evt, sizeof(part_evt));
+	if (ret)
+		return ret;
+	memcpy(address_cmd + 12, address, 4);
+	return mt6628_xfer(wmt, address_cmd, sizeof(address_cmd),
+			   part_evt, sizeof(part_evt));
+}
+
+static int mt6628_download_patch(struct mt6628_wmt *wmt, const char *name,
+				 const u8 address[4])
+{
+	const struct firmware *fw;
+	u8 *cmd;
+	size_t offset, body_len, frag;
+	u8 hdr_address[4];
+	int ret;
+
+	ret = request_firmware(&fw, name, &wmt->serdev->dev);
+	if (ret)
+		return dev_err_probe(&wmt->serdev->dev, ret,
+				     "cannot load %s\n", name);
+	if (fw->size <= MT6628_PATCH_HEADER_SIZE) {
+		ret = -EINVAL;
+		goto out_release;
+	}
+	/*
+	 * Like 6620_launcher: header byte 24 = (parts << 4) | index, bytes
+	 * 25..27 = patch address; the first address byte is sent as 0.
+	 */
+	if (!address) {
+		hdr_address[0] = 0;
+		memcpy(hdr_address + 1, fw->data + 25, 3);
+		address = hdr_address;
+		dev_info(&wmt->serdev->dev, "%s: part %u/%u address %*ph\n",
+			 name, fw->data[24] & 0xf, fw->data[24] >> 4, 4, address);
+	}
+	ret = mt6628_patch_address(wmt, address);
+	if (ret)
+		goto out_release;
+	cmd = kmalloc(MT6628_PATCH_FRAGMENT + 5, GFP_KERNEL);
+	if (!cmd) {
+		ret = -ENOMEM;
+		goto out_release;
+	}
+
+	body_len = fw->size - MT6628_PATCH_HEADER_SIZE;
+	for (offset = 0; offset < body_len; offset += frag) {
+		frag = min_t(size_t, MT6628_PATCH_FRAGMENT, body_len - offset);
+		cmd[0] = 0x01;
+		cmd[1] = 0x01;
+		put_unaligned_le16(frag + 1, cmd + 2);
+		cmd[4] = offset == 0 ? 1 :
+			(offset + frag == body_len ? 3 : 2);
+		memcpy(cmd + 5, fw->data + MT6628_PATCH_HEADER_SIZE + offset,
+		       frag);
+		ret = mt6628_xfer(wmt, cmd, frag + 5,
+				  wmt_patch_evt, sizeof(wmt_patch_evt));
+		if (ret) {
+			dev_err(&wmt->serdev->dev,
+				"%s fragment %zu failed: %d\n",
+				name, offset / MT6628_PATCH_FRAGMENT, ret);
+			break;
+		}
+	}
+	if (!ret)
+		dev_info(&wmt->serdev->dev, "downloaded %s (%zu bytes)\n",
+			 name, body_len);
+	kfree(cmd);
+out_release:
+	release_firmware(fw);
+	return ret;
+}
+
+static int mt6628_do_reset(struct mt6628_wmt *wmt)
+{
+	return mt6628_xfer(wmt, wmt_reset, sizeof(wmt_reset),
+			   wmt_reset_evt, sizeof(wmt_reset_evt));
+}
+
+static int mt6628_download_selected_patches(struct mt6628_wmt *wmt)
+{
+	/* E1 single patch: address unverified (no E1 chip seen). */
+	static const u8 e1_address[4] = { 0x21, 0x00, 0x0e, 0xf0 };
+	int ret;
+
+	if ((wmt->hw_ver & 0xfff0) == 0x8a00) {
+		ret = mt6628_download_patch(wmt, MT6628_FW_PATCH_E1,
+					    e1_address);
+		if (ret)
+			return ret;
+		return mt6628_do_reset(wmt);
+	}
+	/* Parts in header index order: _0 is part 1/2, _1 is part 2/2. */
+	ret = mt6628_download_patch(wmt, MT6628_FW_PATCH_E2_0, NULL);
+	if (ret)
+		return ret;
+	ret = mt6628_do_reset(wmt);
+	if (ret)
+		return ret;
+	ret = mt6628_download_patch(wmt, MT6628_FW_PATCH_E2_1, NULL);
+	if (ret)
+		return ret;
+	ret = mt6628_do_reset(wmt);
+	if (ret)
+		return ret;
+	return mt6628_do_reset(wmt);
+}
+
+static int mt6628_power_on(struct mt6628_wmt *wmt)
+{
+	int ret;
+
+	if (wmt->powered)
+		return 0;
+	gpiod_set_value_cansleep(wmt->pmu, 0);
+	gpiod_set_value_cansleep(wmt->reset, 0);
+	msleep(wmt->off_stable_ms);
+	if (wmt->clk32k) {
+		ret = clk_prepare_enable(wmt->clk32k);
+		if (ret)
+			return ret;
+	}
+	msleep(wmt->rtc_stable_ms);
+	gpiod_set_value_cansleep(wmt->pmu, 1);
+	msleep(wmt->reset_stable_ms);
+	gpiod_set_value_cansleep(wmt->reset, 1);
+	msleep(wmt->on_stable_ms);
+	wmt->powered = true;
+	return 0;
+}
+
+static void mt6628_power_off(struct mt6628_wmt *wmt)
+{
+	if (!wmt->powered)
+		return;
+	gpiod_set_value_cansleep(wmt->reset, 0);
+	gpiod_set_value_cansleep(wmt->pmu, 0);
+	if (wmt->clk32k)
+		clk_disable_unprepare(wmt->clk32k);
+	wmt->powered = false;
+	wmt->initialized = false;
+}
+
+static int mt6628_chip_init(struct mt6628_wmt *wmt)
+{
+	const struct firmware *cfg;
+	u8 baud_evt[10] = { 0x02, 0x04, 0x06, 0x00, 0x00, 0x02 };
+	const u8 baud_115200_evt[] = {
+		0x02, 0x04, 0x06, 0x00, 0x00, 0x02, 0x00, 0xc2, 0x01, 0x00
+	};
+	const u8 stp_default_evt[] = {
+		0x02, 0x04, 0x06, 0x00, 0x00, 0x04, 0x11, 0x00, 0x00, 0x00
+	};
+	const u8 wake_evt[] = { 0x02, 0x03, 0x02, 0x00, 0x00, 0x03 };
+	const u8 wifi_on[] = { 0x01, 0x06, 0x02, 0x00, 0x03, 0x01 };
+	const u8 func_evt[] = { 0x02, 0x06, 0x01, 0x00, 0x00 };
+	u32 value;
+	int ret;
+
+	wmt->stp_mode = MT6628_STP_MANDATORY;
+	wmt->tx_seq = 0;
+	wmt->rx_ack = 0;
+	mt6628_parser_reset(&wmt->parser);
+	serdev_device_set_baudrate(wmt->serdev, 115200);
+	serdev_device_set_flow_control(wmt->serdev, false);
+
+	ret = mt6628_reg_read(wmt, 0x80000008, &value);
+	if (ret || (value & 0xffff) != 0x6628)
+		return ret ?: -ENODEV;
+	ret = mt6628_reg_read(wmt, 0x80000000, &value);
+	if (ret)
+		return ret;
+	wmt->hw_ver = value;
+	ret = mt6628_reg_read(wmt, 0x80000004, &value);
+	if (ret)
+		return ret;
+	wmt->fw_ver = value;
+	dev_info(&wmt->serdev->dev, "MT6628 hw=%#04x rom=%#04x\n",
+		 wmt->hw_ver, wmt->fw_ver);
+
+	ret = request_firmware(&cfg, MT6628_FW_CONFIG, &wmt->serdev->dev);
+	if (ret)
+		return dev_err_probe(&wmt->serdev->dev, ret,
+				     "cannot load %s\n", MT6628_FW_CONFIG);
+	release_firmware(cfg);
+	ret = mt6628_xfer(wmt, wmt_query_baud, sizeof(wmt_query_baud),
+			  baud_115200_evt, sizeof(baud_115200_evt));
+	if (ret)
+		return ret;
+	ret = mt6628_xfer(wmt, wmt_query_stp, sizeof(wmt_query_stp),
+			  stp_default_evt, sizeof(stp_default_evt));
+	if (ret)
+		return ret;
+	ret = mt6628_set_baud(wmt);
+	if (ret)
+		return ret;
+
+	reinit_completion(&wmt->response);
+	ret = mt6628_uart_write(wmt, (const u8[]){ 0xff }, 1);
+	if (ret)
+		return ret;
+	if (!wait_for_completion_timeout(&wmt->response, MT6628_XFER_TIMEOUT) ||
+	    wmt->response_len != sizeof(wake_evt) ||
+	    memcmp(wmt->response_buf, wake_evt, sizeof(wake_evt)))
+		return -EPROTO;
+	put_unaligned_le32(wmt->operational_baud, baud_evt + 6);
+	baud_evt[9] = 0;
+	ret = mt6628_xfer(wmt, wmt_query_baud, sizeof(wmt_query_baud),
+			  baud_evt, sizeof(baud_evt));
+	if (ret)
+		return ret;
+
+	ret = mt6628_download_selected_patches(wmt);
+	if (ret)
+		return ret;
+	ret = mt6628_xfer(wmt, wmt_coex, sizeof(wmt_coex),
+			  wmt_coex_evt, sizeof(wmt_coex_evt));
+	if (ret)
+		return ret;
+	ret = mt6628_xfer(wmt, wmt_sdio_drive, sizeof(wmt_sdio_drive),
+			  wmt_sdio_drive_evt, sizeof(wmt_sdio_drive_evt));
+	if (ret)
+		return ret;
+	ret = mt6628_xfer(wmt, wmt_set_stp, sizeof(wmt_set_stp),
+			  wmt_set_stp_evt, sizeof(wmt_set_stp_evt));
+	if (ret)
+		return ret;
+
+	wmt->stp_mode = MT6628_STP_FULL;
+	wmt->tx_seq = 0;
+	wmt->rx_ack = 0;
+	msleep(10);
+	ret = mt6628_xfer(wmt, wmt_query_stp, sizeof(wmt_query_stp),
+			  wmt_query_stp_full_evt, sizeof(wmt_query_stp_full_evt));
+	if (ret)
+		return ret;
+	ret = mt6628_xfer(wmt, wmt_query_baud, sizeof(wmt_query_baud),
+			  baud_evt, sizeof(baud_evt));
+	if (ret)
+		return ret;
+	ret = mt6628_xfer(wmt, wmt_fm_strap, sizeof(wmt_fm_strap),
+			  wmt_fm_strap_evt, sizeof(wmt_fm_strap_evt));
+	if (ret)
+		return ret;
+	/*
+	 * The vendor WMT never sends WMT_FUNC_CTRL for Wi-Fi (only BT, FM,
+	 * GPS): Wi-Fi on = SDIO slot on + WLAN driver FW download over SDIO.
+	 * Sending it seems to leave the Wi-Fi CPU not accepting the host FW.
+	 */
+	if (wmt_wifi_func_ctrl) {
+		ret = mt6628_xfer(wmt, wifi_on, sizeof(wifi_on),
+				  func_evt, sizeof(func_evt));
+		if (ret)
+			return ret;
+	}
+
+	wmt->initialized = true;
+	dev_info(&wmt->serdev->dev,
+		 "WMT patch loaded and Wi-Fi function enabled\n");
+	if (wmt->mmc) {
+		/*
+		 * MSDC3 is non-removable and its boot-time scan ran while the
+		 * chip was off; re-arm the one-shot rescan.
+		 */
+		wmt->mmc->rescan_entered = 0;
+		mmc_detect_change(wmt->mmc, msecs_to_jiffies(200));
+	}
+	return 0;
+}
+
+int mt6628_wmt_wifi_on(void)
+{
+	struct mt6628_wmt *wmt;
+	int ret;
+
+	mutex_lock(&mt6628_global_lock);
+	wmt = mt6628_global;
+	if (!wmt) {
+		ret = -EPROBE_DEFER;
+		goto out_global;
+	}
+	mutex_lock(&wmt->lock);
+	if (wmt->initialized) {
+		wmt->users++;
+		ret = 0;
+		goto out_wmt;
+	}
+	ret = mt6628_power_on(wmt);
+	if (!ret)
+		ret = mt6628_chip_init(wmt);
+	if (ret) {
+		dev_err(&wmt->serdev->dev, "WMT initialization failed: %d\n", ret);
+		mt6628_power_off(wmt);
+	} else {
+		wmt->users++;
+	}
+out_wmt:
+	mutex_unlock(&wmt->lock);
+out_global:
+	mutex_unlock(&mt6628_global_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6628_wmt_wifi_on);
+
+void mt6628_wmt_wifi_off(void)
+{
+	struct mt6628_wmt *wmt;
+
+	mutex_lock(&mt6628_global_lock);
+	wmt = mt6628_global;
+	if (!wmt)
+		goto out;
+	mutex_lock(&wmt->lock);
+	if (wmt->users)
+		wmt->users--;
+	mutex_unlock(&wmt->lock);
+out:
+	mutex_unlock(&mt6628_global_lock);
+}
+EXPORT_SYMBOL_GPL(mt6628_wmt_wifi_off);
+
+static irqreturn_t mt6628_bgf_irq_thread(int irq, void *data)
+{
+	struct mt6628_wmt *wmt = data;
+
+	pm_wakeup_event(&wmt->serdev->dev, 250);
+	return IRQ_HANDLED;
+}
+
+static int mt6628_get_mmc_host(struct mt6628_wmt *wmt)
+{
+	struct device_node *np;
+	struct platform_device *pdev;
+
+	np = of_parse_phandle(wmt->serdev->dev.of_node,
+			      "mediatek,mmc-host", 0);
+	if (!np)
+		return -EINVAL;
+	pdev = of_find_device_by_node(np);
+	of_node_put(np);
+	if (!pdev)
+		return -EPROBE_DEFER;
+	wmt->mmc = platform_get_drvdata(pdev);
+	put_device(&pdev->dev);
+	return wmt->mmc ? 0 : -EPROBE_DEFER;
+}
+
+static bool bgf_irq = true;
+module_param(bgf_irq, bool, 0644);
+MODULE_PARM_DESC(bgf_irq, "request the BGF EINT (level low)");
+
+static bool probe_only;
+module_param(probe_only, bool, 0644);
+MODULE_PARM_DESC(probe_only, "open UART3 only, do not power the chip");
+
+static int mt6628_wmt_probe(struct serdev_device *serdev)
+{
+	struct device *dev = &serdev->dev;
+	struct mt6628_wmt *wmt;
+	int irq, ret;
+
+	wmt = devm_kzalloc(dev, sizeof(*wmt), GFP_KERNEL);
+	if (!wmt)
+		return -ENOMEM;
+	wmt->serdev = serdev;
+	mutex_init(&wmt->lock);
+	spin_lock_init(&wmt->rx_lock);
+	init_completion(&wmt->response);
+	wmt->operational_baud = 2000000;
+	device_property_read_u32(dev, "mediatek,operational-speed",
+				 &wmt->operational_baud);
+	mt6628_read_delay(dev, "mediatek,rtc-stable-ms",
+			  &wmt->rtc_stable_ms, 100);
+	mt6628_read_delay(dev, "mediatek,off-stable-ms",
+			  &wmt->off_stable_ms, 10);
+	mt6628_read_delay(dev, "mediatek,reset-stable-ms",
+			  &wmt->reset_stable_ms, 30);
+	mt6628_read_delay(dev, "mediatek,on-stable-ms",
+			  &wmt->on_stable_ms, 100);
+
+	wmt->pmu = devm_gpiod_get(dev, "pmu-en", GPIOD_OUT_LOW);
+	if (IS_ERR(wmt->pmu))
+		return dev_err_probe(dev, PTR_ERR(wmt->pmu), "PMU GPIO\n");
+	wmt->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(wmt->reset))
+		return dev_err_probe(dev, PTR_ERR(wmt->reset), "reset GPIO\n");
+	wmt->clk32k = devm_clk_get_optional(dev, NULL);
+	if (IS_ERR(wmt->clk32k))
+		return dev_err_probe(dev, PTR_ERR(wmt->clk32k), "32 kHz clock\n");
+	ret = mt6628_get_mmc_host(wmt);
+	if (ret)
+		return dev_err_probe(dev, ret, "MSDC3 host\n");
+
+	serdev_device_set_drvdata(serdev, wmt);
+	serdev_device_set_client_ops(serdev, &mt6628_serdev_ops);
+	ret = serdev_device_open(serdev);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot open UART3\n");
+
+	dev_info(dev, "probe: UART3 open, bgf_irq=%d probe_only=%d\n", bgf_irq, probe_only);
+	irq = bgf_irq ? of_irq_get(dev->of_node, 0) : 0;
+	if (irq > 0) {
+		dev_info(dev, "probe: BGF irq %d\n", irq);
+		ret = devm_request_threaded_irq(dev, irq, NULL,
+					mt6628_bgf_irq_thread,
+					IRQF_ONESHOT | IRQF_TRIGGER_LOW,
+					dev_name(dev), wmt);
+		if (ret)
+			goto err_close;
+	} else if (irq == -EPROBE_DEFER) {
+		ret = irq;
+		goto err_close;
+	}
+
+	device_init_wakeup(dev, true);
+	mutex_lock(&mt6628_global_lock);
+	if (mt6628_global) {
+		mutex_unlock(&mt6628_global_lock);
+		ret = -EBUSY;
+		goto err_wakeup;
+	}
+	mt6628_global = wmt;
+	mutex_unlock(&mt6628_global_lock);
+
+	if (probe_only) {
+		dev_info(dev, "probe_only: chip left off\n");
+		return 0;
+	}
+	ret = mt6628_wmt_wifi_on();
+	if (ret)
+		goto err_global;
+	dev_info(dev, "MT6628 WMT ready at %u baud\n", wmt->operational_baud);
+	return 0;
+
+err_global:
+	mutex_lock(&mt6628_global_lock);
+	mt6628_global = NULL;
+	mutex_unlock(&mt6628_global_lock);
+err_wakeup:
+	device_init_wakeup(dev, false);
+err_close:
+	serdev_device_close(serdev);
+	return ret;
+}
+
+static void mt6628_wmt_remove(struct serdev_device *serdev)
+{
+	struct mt6628_wmt *wmt = serdev_device_get_drvdata(serdev);
+
+	mutex_lock(&mt6628_global_lock);
+	if (mt6628_global == wmt)
+		mt6628_global = NULL;
+	mutex_unlock(&mt6628_global_lock);
+	mutex_lock(&wmt->lock);
+	wmt->users = 0;
+	mt6628_power_off(wmt);
+	mutex_unlock(&wmt->lock);
+	device_init_wakeup(&serdev->dev, false);
+	serdev_device_close(serdev);
+}
+
+static const struct of_device_id mt6628_wmt_of_match[] = {
+	{ .compatible = "mediatek,mt6628-wmt" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6628_wmt_of_match);
+
+static struct serdev_device_driver mt6628_wmt_driver = {
+	.probe = mt6628_wmt_probe,
+	.remove = mt6628_wmt_remove,
+	.driver = {
+		.name = "mt6628-wmt",
+		.of_match_table = mt6628_wmt_of_match,
+	},
+};
+module_serdev_device_driver(mt6628_wmt_driver);
+
+MODULE_AUTHOR("Lenovo B8000-H Linux port contributors");
+MODULE_DESCRIPTION("MediaTek MT6628 WMT/STP serdev driver");
+MODULE_LICENSE("GPL");
+MODULE_FIRMWARE(MT6628_FW_PATCH_E1);
+MODULE_FIRMWARE(MT6628_FW_PATCH_E2_0);
+MODULE_FIRMWARE(MT6628_FW_PATCH_E2_1);
+MODULE_FIRMWARE(MT6628_FW_CONFIG);
diff --git a/drivers/power/supply/b8k-battery.c b/drivers/power/supply/b8k-battery.c
new file mode 100755
index 000000000..e78db069d
--- /dev/null
+++ b/drivers/power/supply/b8k-battery.c
@@ -0,0 +1,285 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Lenovo B8000-H battery: voltage from the MT6320 AUXADC (channel 0, BATSNS),
+ * charge from the vendor 25 C OCV table, status from the BQ24196 charger.
+ *
+ * B8000 has no fuel-gauge IC (vendor MTK_BQ27541_SUPPORT=no); the vendor
+ * "SW fuel gauge" (mt6320_fuel_gauge_bq24196.c) does the same: AUXADC code
+ * * 4 * 1200 / 1024 mV, OCV lookup in cust_fuel_gauge.h battery_profile_t2.
+ * The PMIC is reached through the pwrap regmap.
+ */
+
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/regmap.h>
+#include <linux/workqueue.h>
+
+#define AUXADC_ADC0	0x0512	/* ch0 out [9:0], ready [15] */
+#define AUXADC_CON0	0x0540	/* avg_num [6:4] */
+#define AUXADC_CON1	0x0542	/* chsel [10:7], start [0] */
+#define AUXADC_CON14	0x055c	/* ch0 source: norm_sel [2], lbat_sel [0] */
+
+#define POLL_MS		30000
+#define NSAMPLES	8
+
+/* vendor battery_profile_t2_bat1: {depth of discharge %, OCV mV} */
+static const u16 ocv_table[][2] = {
+	{0, 4190}, {1, 4171}, {3, 4155}, {4, 4141}, {5, 4127}, {7, 4114},
+	{8, 4101}, {9, 4089}, {11, 4077}, {12, 4066}, {14, 4053}, {15, 4041},
+	{16, 4029}, {18, 4018}, {19, 4007}, {20, 3997}, {22, 3987}, {23, 3978},
+	{24, 3969}, {26, 3961}, {27, 3952}, {28, 3944}, {30, 3935}, {31, 3927},
+	{33, 3919}, {34, 3912}, {35, 3904}, {37, 3896}, {38, 3887}, {39, 3876},
+	{41, 3863}, {42, 3851}, {43, 3842}, {45, 3834}, {46, 3827}, {47, 3821},
+	{49, 3816}, {50, 3811}, {52, 3807}, {53, 3803}, {54, 3799}, {56, 3795},
+	{57, 3792}, {58, 3789}, {60, 3786}, {61, 3784}, {62, 3781}, {64, 3779},
+	{65, 3778}, {66, 3776}, {68, 3774}, {69, 3772}, {71, 3769}, {72, 3764},
+	{73, 3759}, {75, 3754}, {76, 3749}, {77, 3744}, {79, 3740}, {80, 3736},
+	{81, 3731}, {83, 3725}, {84, 3718}, {85, 3711}, {87, 3704}, {88, 3695},
+	{89, 3685}, {91, 3681}, {92, 3677}, {94, 3672}, {95, 3662}, {96, 3629},
+	{98, 3570}, {99, 3490}, {100, 3370},
+};
+
+/* Terminal voltage rises under charge current; rough IR compensation. */
+static int charge_comp_mv = 60;
+module_param(charge_comp_mv, int, 0644);
+
+struct b8k_bat {
+	struct device *dev;
+	struct regmap *map;
+	struct power_supply *psy;
+	struct delayed_work work;
+	struct mutex lock;
+	int samples[NSAMPLES];
+	int nsamples, next;
+	int mv, capacity;
+};
+
+static struct platform_device *b8k_pdev;
+
+static int b8k_read_vbat_mv(struct b8k_bat *b)
+{
+	unsigned int v;
+	int i, ret;
+
+	regmap_update_bits(b->map, AUXADC_CON14, BIT(2) | BIT(0), BIT(2) | BIT(0));
+	regmap_update_bits(b->map, AUXADC_CON0, 0x7 << 4, 0x3 << 4);
+	regmap_update_bits(b->map, AUXADC_CON1, 0xf << 7, 0);
+	regmap_update_bits(b->map, AUXADC_CON1, BIT(0), 0);
+	regmap_update_bits(b->map, AUXADC_CON1, BIT(0), BIT(0));
+	usleep_range(500, 1000);
+	for (i = 0; i < 50; i++) {
+		ret = regmap_read(b->map, AUXADC_ADC0, &v);
+		if (ret)
+			return ret;
+		if (v & BIT(15))
+			return ((v & 0x3ff) * 4 * 1200) / 1024;
+		usleep_range(200, 400);
+	}
+	return -ETIMEDOUT;
+}
+
+static int b8k_ocv_to_capacity(int mv)
+{
+	int i, n = ARRAY_SIZE(ocv_table);
+
+	if (mv >= ocv_table[0][1])
+		return 100;
+	if (mv <= ocv_table[n - 1][1])
+		return 0;
+	for (i = 1; i < n; i++) {
+		int v0 = ocv_table[i - 1][1], v1 = ocv_table[i][1];
+		int d0 = ocv_table[i - 1][0], d1 = ocv_table[i][0];
+
+		if (mv >= v1) {
+			int dod = d0 + (d1 - d0) * (v0 - mv) / (v0 - v1);
+
+			return 100 - dod;
+		}
+	}
+	return 0;
+}
+
+static int b8k_charger_status(void)
+{
+	union power_supply_propval val = { .intval = POWER_SUPPLY_STATUS_UNKNOWN };
+	struct power_supply *chg = power_supply_get_by_name("bq24190-charger");
+
+	if (!chg)
+		return POWER_SUPPLY_STATUS_UNKNOWN;
+	power_supply_get_property(chg, POWER_SUPPLY_PROP_STATUS, &val);
+	power_supply_put(chg);
+	return val.intval;
+}
+
+static void b8k_update(struct b8k_bat *b)
+{
+	int mv = b8k_read_vbat_mv(b), sum = 0, i, cap, st;
+
+	if (mv <= 0) {
+		dev_warn(b->dev, "AUXADC read failed: %d\n", mv);
+		return;
+	}
+	st = b8k_charger_status();
+	if (st == POWER_SUPPLY_STATUS_CHARGING)
+		mv -= charge_comp_mv;
+
+	mutex_lock(&b->lock);
+	b->samples[b->next] = mv;
+	b->next = (b->next + 1) % NSAMPLES;
+	if (b->nsamples < NSAMPLES)
+		b->nsamples++;
+	for (i = 0; i < b->nsamples; i++)
+		sum += b->samples[i];
+	b->mv = sum / b->nsamples;
+	cap = b8k_ocv_to_capacity(b->mv);
+	/* while charging never report less, while discharging never more */
+	if (b->capacity >= 0) {
+		if (st == POWER_SUPPLY_STATUS_CHARGING && cap < b->capacity)
+			cap = b->capacity;
+		if (st == POWER_SUPPLY_STATUS_DISCHARGING && cap > b->capacity)
+			cap = b->capacity;
+	}
+	i = cap != b->capacity;
+	b->capacity = cap;
+	mutex_unlock(&b->lock);
+	if (i)
+		power_supply_changed(b->psy);
+}
+
+static void b8k_work(struct work_struct *w)
+{
+	struct b8k_bat *b = container_of(w, struct b8k_bat, work.work);
+
+	b8k_update(b);
+	schedule_delayed_work(&b->work, msecs_to_jiffies(POLL_MS));
+}
+
+static const enum power_supply_property b8k_props[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_TECHNOLOGY,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_SCOPE,
+};
+
+static int b8k_get_property(struct power_supply *psy,
+			    enum power_supply_property psp,
+			    union power_supply_propval *val)
+{
+	struct b8k_bat *b = power_supply_get_drvdata(psy);
+	int st;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_STATUS:
+		st = b8k_charger_status();
+		if (st == POWER_SUPPLY_STATUS_UNKNOWN)
+			st = POWER_SUPPLY_STATUS_DISCHARGING;
+		if (st == POWER_SUPPLY_STATUS_NOT_CHARGING && b->capacity >= 100)
+			st = POWER_SUPPLY_STATUS_FULL;
+		val->intval = st;
+		break;
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = 1;
+		break;
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		val->intval = b->mv * 1000;
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		val->intval = b->capacity < 0 ? 50 : b->capacity;
+		break;
+	case POWER_SUPPLY_PROP_SCOPE:
+		val->intval = POWER_SUPPLY_SCOPE_SYSTEM;
+		break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static const struct power_supply_desc b8k_desc = {
+	.name = "battery",
+	.type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = b8k_props,
+	.num_properties = ARRAY_SIZE(b8k_props),
+	.get_property = b8k_get_property,
+};
+
+static int b8k_probe(struct platform_device *pdev)
+{
+	struct power_supply_config cfg = {};
+	struct device *pwrap;
+	struct b8k_bat *b;
+
+	b = devm_kzalloc(&pdev->dev, sizeof(*b), GFP_KERNEL);
+	if (!b)
+		return -ENOMEM;
+	b->dev = &pdev->dev;
+	b->capacity = -1;
+	mutex_init(&b->lock);
+
+	pwrap = bus_find_device_by_name(&platform_bus_type, NULL, "1000f000.pwrap");
+	if (!pwrap)
+		return dev_err_probe(&pdev->dev, -EPROBE_DEFER, "no pwrap\n");
+	b->map = dev_get_regmap(pwrap, NULL);
+	put_device(pwrap);
+	if (!b->map)
+		return dev_err_probe(&pdev->dev, -EPROBE_DEFER, "no pwrap regmap\n");
+
+	cfg.drv_data = b;
+	b->psy = devm_power_supply_register(&pdev->dev, &b8k_desc, &cfg);
+	if (IS_ERR(b->psy))
+		return PTR_ERR(b->psy);
+	platform_set_drvdata(pdev, b);
+
+	INIT_DELAYED_WORK(&b->work, b8k_work);
+	b8k_update(b);
+	dev_info(&pdev->dev, "battery %d mV, %d %%\n", b->mv, b->capacity);
+	schedule_delayed_work(&b->work, msecs_to_jiffies(POLL_MS));
+	return 0;
+}
+
+static void b8k_remove(struct platform_device *pdev)
+{
+	struct b8k_bat *b = platform_get_drvdata(pdev);
+
+	cancel_delayed_work_sync(&b->work);
+}
+
+static struct platform_driver b8k_driver = {
+	.probe = b8k_probe,
+	.remove = b8k_remove,
+	.driver = { .name = "b8k-battery" },
+};
+
+static int __init b8k_init(void)
+{
+	int ret = platform_driver_register(&b8k_driver);
+
+	if (ret)
+		return ret;
+	b8k_pdev = platform_device_register_simple("b8k-battery", -1, NULL, 0);
+	if (IS_ERR(b8k_pdev)) {
+		platform_driver_unregister(&b8k_driver);
+		return PTR_ERR(b8k_pdev);
+	}
+	return 0;
+}
+module_init(b8k_init);
+
+static void __exit b8k_exit(void)
+{
+	platform_device_unregister(b8k_pdev);
+	platform_driver_unregister(&b8k_driver);
+}
+module_exit(b8k_exit);
+
+MODULE_DESCRIPTION("Lenovo B8000-H battery (MT6320 AUXADC + OCV table)");
+MODULE_LICENSE("GPL");
diff --git a/sound/arm/mt6589-b8000.c b/sound/arm/mt6589-b8000.c
new file mode 100755
index 000000000..11f61277f
--- /dev/null
+++ b/sound/arm/mt6589-b8000.c
@@ -0,0 +1,543 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Minimal playback driver for Lenovo B8000-H (MT6589 + MT6320 + SN2145B).
+ *
+ * The register programming is taken from Lenovo's MT6589 kernel headers and
+ * the stripped stock audio HAL (B8000_A442_001_020_140620_WW_3GDATA).  The
+ * first version deliberately supports only 48 kHz, stereo, S16_LE playback.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/gpio/machine.h>
+#include <linux/hrtimer.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/slab.h>
+
+#include <sound/control.h>
+#include <sound/core.h>
+#include <sound/initval.h>
+#include <sound/pcm.h>
+
+#define DRV_NAME		"b8000-mt6589-audio"
+#define AFE_PHYS		0x12070000
+#define AFE_SIZE		0x1000
+#define INFRACFG_PHYS		0x10001000
+#define INFRACFG_SIZE		0x1000
+#define INFRA_PDN_SET		0x0040
+#define INFRA_PDN_CLR		0x0044
+#define INFRA_PDN_STA		0x0048
+#define INFRA_AUDIO_BIT		BIT(5)
+
+#define AUDIO_AFE_TOP_CON0	0x0000
+#define AFE_DAC_CON0		0x0010
+#define AFE_DAC_CON1		0x0014
+#define AFE_CONN1		0x0024
+#define AFE_CONN2		0x0028
+#define AFE_I2S_CON1		0x0034
+#define AFE_DL1_BASE		0x0040
+#define AFE_DL1_CUR		0x0044
+#define AFE_DL1_END		0x0048
+
+/* MT6320 PMIC audio registers (16-bit, byte addressed through pwrap). */
+#define TOP_CKPDN_CLR		0x0106
+#define AFE_UL_DL_CON0		0x4000
+#define AFE_DL_SRC2_CON0_H	0x4002
+#define AFE_DL_SRC2_CON0_L	0x4004
+#define AFE_DL_SRC2_CON1_H	0x4006
+#define AFE_DL_SDM_CON1		0x400c
+#define AFE_PREDIS_CON0_H	0x4016
+#define AFE_PREDIS_CON0_L	0x4018
+#define AFE_PREDIS_CON1_H	0x401a
+#define AFE_PREDIS_CON1_L	0x401c
+#define ANA_AFE_I2S_CON1	0x401e
+#define AFE_I2S_FIFO_DL_CFG0	0x4022
+#define ANA_AFE_TOP_CON0	0x4024
+#define AFUNC_AUD_CON0		0x4034
+#define AFUNC_AUD_CON2		0x4038
+
+#define AUDDAC_CON0		0x0700
+#define AUDBUF_CFG0		0x0702
+#define AUDBUF_CFG1		0x0704
+#define AUDBUF_CFG2		0x0706
+#define IBIASDIST_CFG0		0x070c
+#define AUDCLKGEN_CFG0		0x0712
+#define AUDLDO_CFG0		0x0714
+#define AUDNVREGGLB_CFG0	0x0718
+#define AUD_NCP0		0x071a
+#define ZCD_CON0		0x0738
+#define ZCD_CON2		0x073c
+#define NCP_CLKDIV_CON0		0x0744
+#define NCP_CLKDIV_CON1		0x0746
+
+#define SPEAKER_EN_GPIO		73
+#define BUFFER_BYTES		16384
+#define RATE_HZ			48000
+
+struct b8k_audio {
+	struct device *dev;
+	struct snd_card *card;
+	struct snd_pcm *pcm;
+	struct snd_pcm_substream *substream;
+	void __iomem *afe;
+	void __iomem *infra;
+	struct regmap *pmic;
+	struct gpio_desc *speaker_enable;
+	struct hrtimer timer;
+	spinlock_t lock;
+	u32 last_period;
+	unsigned int volume;
+	bool running;
+	bool amp_on;
+	bool infra_was_off;
+};
+
+static struct platform_device *b8k_pdev;
+
+static struct gpiod_lookup_table b8k_gpio_table = {
+	.dev_id = DRV_NAME,
+	.table = {
+		GPIO_LOOKUP("pinctrl_paris", SPEAKER_EN_GPIO, "speaker-enable",
+			    GPIO_ACTIVE_HIGH),
+		{ }
+	},
+};
+
+static const struct snd_pcm_hardware b8k_pcm_hw = {
+	.info = SNDRV_PCM_INFO_INTERLEAVED | SNDRV_PCM_INFO_MMAP |
+		SNDRV_PCM_INFO_MMAP_VALID | SNDRV_PCM_INFO_BLOCK_TRANSFER,
+	.formats = SNDRV_PCM_FMTBIT_S16_LE,
+	.rates = SNDRV_PCM_RATE_48000,
+	.rate_min = RATE_HZ,
+	.rate_max = RATE_HZ,
+	.channels_min = 2,
+	.channels_max = 2,
+	.buffer_bytes_max = BUFFER_BYTES,
+	.period_bytes_min = 256,
+	.period_bytes_max = 4096,
+	.periods_min = 2,
+	.periods_max = 64,
+};
+
+static inline void afe_update(struct b8k_audio *a, u32 reg, u32 val, u32 mask)
+{
+	u32 old = readl(a->afe + reg);
+
+	writel((old & ~mask) | (val & mask), a->afe + reg);
+}
+
+static int ana_write(struct b8k_audio *a, unsigned int reg, unsigned int val)
+{
+	return regmap_write(a->pmic, reg, val);
+}
+
+static int ana_update(struct b8k_audio *a, unsigned int reg,
+		      unsigned int val, unsigned int mask)
+{
+	return regmap_update_bits(a->pmic, reg, mask, val);
+}
+
+/*
+ * HP output muxes in AUDBUF_CFG0: right [12:9], left [8:5]; 4'b0100 selects
+ * the audio DAC (stock HAL AudioMachineDevice::AnalogSetMux, MUX_AUDIO).
+ * Without it the DAC runs but the HP buffers, which feed the SN2145B, stay
+ * disconnected.
+ */
+#define HP_MUX_MASK		0x1fe0
+static unsigned int hp_mux = 0x0880;
+module_param(hp_mux, uint, 0644);
+MODULE_PARM_DESC(hp_mux, "AUDBUF_CFG0 HP mux bits (0x0880 = audio DAC)");
+
+/* Values used by the stock HAL for the headset DAC path used by speaker. */
+static const u16 hp_gain_table[] = {
+	0x0f9f, 0x0e0e, 0x0d0d, 0x0c0c, 0x0909, 0x0606, 0x0303, 0x0000,
+};
+
+static int b8k_analog_on(struct b8k_audio *a)
+{
+	int ret;
+
+	/* Digital PMIC downlink, exact 48 kHz stock-HAL sequence. */
+	ret = ana_write(a, TOP_CKPDN_CLR, 0x0003);
+	if (ret)
+		return ret;
+	ana_write(a, AFUNC_AUD_CON2, 0x0006);
+	ana_write(a, AFUNC_AUD_CON0, 0xc3a1);
+	ana_write(a, AFUNC_AUD_CON2, 0x0003);
+	ana_write(a, AFUNC_AUD_CON2, 0x000b);
+	ana_write(a, AFE_DL_SDM_CON1, 0x001e);
+	ana_write(a, AFE_DL_SRC2_CON0_H, 0x8300);
+	ana_write(a, AFE_UL_DL_CON0, 0x007f);
+	ana_write(a, AFE_DL_SRC2_CON0_L, 0x1801);
+	ana_write(a, AFE_DL_SRC2_CON1_H, 0x0000);
+	ana_write(a, ANA_AFE_I2S_CON1, 0x00e1);
+	ana_write(a, ANA_AFE_TOP_CON0, 0x0000);
+	ana_write(a, AFE_I2S_FIFO_DL_CFG0, 0x004f);
+
+	/* Cap-less HP/line path; keep gain at the quietest table entry. */
+	ana_update(a, AFUNC_AUD_CON2, 0x0080, 0x0080);
+	ana_write(a, AUDLDO_CFG0, 0x0d92);
+	ana_write(a, AUDNVREGGLB_CFG0, 0x000c);
+	ana_write(a, AUD_NCP0, 0xe000);
+	ana_write(a, NCP_CLKDIV_CON0, 0x102b);
+	ana_write(a, NCP_CLKDIV_CON1, 0x0000);
+	usleep_range(1000, 1500);
+	ana_write(a, AUDBUF_CFG0, 0x0008);
+	ana_write(a, ZCD_CON0, 0x0101);
+	ana_write(a, IBIASDIST_CFG0, 0x0552);
+	ana_write(a, AUDBUF_CFG1, 0x0900);
+	ana_write(a, AUDBUF_CFG2, 0x0082);
+	ana_write(a, AUDBUF_CFG0, 0x0009);
+	usleep_range(1000, 1500);
+	ana_write(a, AUDBUF_CFG1, 0x0940);
+	ana_write(a, AUDBUF_CFG0, 0x000f);
+	usleep_range(1000, 1500);
+	ana_write(a, AUDBUF_CFG1, 0x0100);
+	ana_write(a, AUDBUF_CFG2, 0x0082);
+	ana_write(a, ZCD_CON2, hp_gain_table[a->volume]);
+	ana_write(a, AUDCLKGEN_CFG0, 0x0001);
+	ana_write(a, AUDDAC_CON0, 0x000f);
+	usleep_range(1000, 1500);
+	ana_update(a, AUDBUF_CFG0, 0x0006, 0x0007);
+	ana_update(a, AUDBUF_CFG0, hp_mux & HP_MUX_MASK, HP_MUX_MASK);
+	ana_update(a, AFUNC_AUD_CON2, 0x0000, 0x0080);
+
+	gpiod_set_value(a->speaker_enable, 1);
+	msleep(40);
+	a->amp_on = true;
+	return 0;
+}
+
+static void b8k_analog_off(struct b8k_audio *a)
+{
+	if (a->amp_on) {
+		gpiod_set_value(a->speaker_enable, 0);
+		a->amp_on = false;
+	}
+	ana_write(a, AUDDAC_CON0, 0x0000);
+	ana_write(a, AUDCLKGEN_CFG0, 0x0000);
+	ana_write(a, AUDBUF_CFG0, 0x0000);
+	ana_write(a, AUD_NCP0, 0x8000);
+	ana_write(a, AUDNVREGGLB_CFG0, 0x0006);
+	ana_write(a, AUDLDO_CFG0, 0x0192);
+	ana_write(a, AFE_UL_DL_CON0, 0x0000);
+}
+
+static int b8k_hw_start(struct b8k_audio *a, struct snd_pcm_runtime *rt)
+{
+	int ret;
+
+	a->infra_was_off = !!(readl(a->infra + INFRA_PDN_STA) & INFRA_AUDIO_BIT);
+	writel(INFRA_AUDIO_BIT, a->infra + INFRA_PDN_CLR);
+
+	/* Vendor clock manager clears bit 2 (AFE gate); bit 14 stays set. */
+	afe_update(a, AUDIO_AFE_TOP_CON0, BIT(14), BIT(14) | BIT(2));
+	writel(lower_32_bits(rt->dma_addr), a->afe + AFE_DL1_BASE);
+	writel(lower_32_bits(rt->dma_addr + snd_pcm_lib_buffer_bytes(a->substream) - 1),
+	       a->afe + AFE_DL1_END);
+	/* DL1 L/R (I05/I06) to PMIC DAC L/R (O03/O04). */
+	afe_update(a, AFE_CONN1, BIT(21), BIT(21));
+	afe_update(a, AFE_CONN2, BIT(6), BIT(6));
+	afe_update(a, AFE_DAC_CON1, 10, 0xf); /* 48 kHz */
+	afe_update(a, AFE_I2S_CON1, (10 << 8) | 1, 0xf01);
+
+	ret = b8k_analog_on(a);
+	if (ret) {
+		if (a->infra_was_off)
+			writel(INFRA_AUDIO_BIT, a->infra + INFRA_PDN_SET);
+		return ret;
+	}
+	afe_update(a, AFE_DAC_CON0, BIT(0) | BIT(1), BIT(0) | BIT(1));
+	return 0;
+}
+
+static void b8k_hw_stop(struct b8k_audio *a)
+{
+	afe_update(a, AFE_DAC_CON0, 0, BIT(0) | BIT(1));
+	b8k_analog_off(a);
+	afe_update(a, AFE_CONN1, 0, BIT(21));
+	afe_update(a, AFE_CONN2, 0, BIT(6));
+	if (a->infra_was_off)
+		writel(INFRA_AUDIO_BIT, a->infra + INFRA_PDN_SET);
+}
+
+static enum hrtimer_restart b8k_timer(struct hrtimer *timer)
+{
+	struct b8k_audio *a = container_of(timer, struct b8k_audio, timer);
+	struct snd_pcm_substream *s;
+	unsigned long flags;
+	u32 cur, base, off, period;
+	bool elapsed = false;
+
+	spin_lock_irqsave(&a->lock, flags);
+	s = a->substream;
+	if (!a->running || !s) {
+		spin_unlock_irqrestore(&a->lock, flags);
+		return HRTIMER_NORESTART;
+	}
+	base = lower_32_bits(s->runtime->dma_addr);
+	cur = readl(a->afe + AFE_DL1_CUR);
+	off = (cur >= base && cur < base + snd_pcm_lib_buffer_bytes(s)) ?
+		cur - base : 0;
+	period = off / snd_pcm_lib_period_bytes(s);
+	if (period != a->last_period) {
+		a->last_period = period;
+		elapsed = true;
+	}
+	hrtimer_forward_now(timer, ms_to_ktime(2));
+	spin_unlock_irqrestore(&a->lock, flags);
+	if (elapsed)
+		snd_pcm_period_elapsed(s);
+	return HRTIMER_RESTART;
+}
+
+static int b8k_pcm_open(struct snd_pcm_substream *substream)
+{
+	struct b8k_audio *a = snd_pcm_substream_chip(substream);
+
+	substream->runtime->hw = b8k_pcm_hw;
+	a->substream = substream;
+	return 0;
+}
+
+static int b8k_pcm_close(struct snd_pcm_substream *substream)
+{
+	struct b8k_audio *a = snd_pcm_substream_chip(substream);
+
+	a->substream = NULL;
+	return 0;
+}
+
+static int b8k_pcm_hw_params(struct snd_pcm_substream *substream,
+			     struct snd_pcm_hw_params *params)
+{
+	return snd_pcm_lib_malloc_pages(substream, params_buffer_bytes(params));
+}
+
+static int b8k_pcm_hw_free(struct snd_pcm_substream *substream)
+{
+	return snd_pcm_lib_free_pages(substream);
+}
+
+static int b8k_pcm_prepare(struct snd_pcm_substream *substream)
+{
+	struct b8k_audio *a = snd_pcm_substream_chip(substream);
+
+	memset(substream->runtime->dma_area, 0, substream->runtime->dma_bytes);
+	a->last_period = 0;
+	return 0;
+}
+
+static int b8k_pcm_trigger(struct snd_pcm_substream *substream, int cmd)
+{
+	struct b8k_audio *a = snd_pcm_substream_chip(substream);
+	unsigned long flags;
+	int ret = 0;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+		ret = b8k_hw_start(a, substream->runtime);
+		if (ret)
+			return ret;
+		spin_lock_irqsave(&a->lock, flags);
+		a->running = true;
+		spin_unlock_irqrestore(&a->lock, flags);
+		hrtimer_start(&a->timer, ms_to_ktime(2), HRTIMER_MODE_REL);
+		break;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+		spin_lock_irqsave(&a->lock, flags);
+		a->running = false;
+		spin_unlock_irqrestore(&a->lock, flags);
+		hrtimer_cancel(&a->timer);
+		b8k_hw_stop(a);
+		break;
+	default:
+		ret = -EINVAL;
+	}
+	return ret;
+}
+
+static snd_pcm_uframes_t b8k_pcm_pointer(struct snd_pcm_substream *substream)
+{
+	struct b8k_audio *a = snd_pcm_substream_chip(substream);
+	u32 base = lower_32_bits(substream->runtime->dma_addr);
+	u32 cur = readl(a->afe + AFE_DL1_CUR);
+
+	if (cur < base || cur >= base + snd_pcm_lib_buffer_bytes(substream))
+		return 0;
+	return bytes_to_frames(substream->runtime, cur - base);
+}
+
+static const struct snd_pcm_ops b8k_pcm_ops = {
+	.open = b8k_pcm_open,
+	.close = b8k_pcm_close,
+	.ioctl = snd_pcm_lib_ioctl,
+	.hw_params = b8k_pcm_hw_params,
+	.hw_free = b8k_pcm_hw_free,
+	.prepare = b8k_pcm_prepare,
+	.trigger = b8k_pcm_trigger,
+	.pointer = b8k_pcm_pointer,
+	.mmap = snd_pcm_lib_default_mmap,
+};
+
+static int b8k_volume_info(struct snd_kcontrol *kcontrol,
+			   struct snd_ctl_elem_info *uinfo)
+{
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	uinfo->count = 1;
+	uinfo->value.integer.min = 0;
+	uinfo->value.integer.max = ARRAY_SIZE(hp_gain_table) - 1;
+	return 0;
+}
+
+static int b8k_volume_get(struct snd_kcontrol *kcontrol,
+			  struct snd_ctl_elem_value *ucontrol)
+{
+	struct b8k_audio *a = snd_kcontrol_chip(kcontrol);
+
+	ucontrol->value.integer.value[0] = a->volume;
+	return 0;
+}
+
+static int b8k_volume_put(struct snd_kcontrol *kcontrol,
+			  struct snd_ctl_elem_value *ucontrol)
+{
+	struct b8k_audio *a = snd_kcontrol_chip(kcontrol);
+	unsigned int v = clamp_val(ucontrol->value.integer.value[0], 0,
+				   ARRAY_SIZE(hp_gain_table) - 1);
+	int changed = v != a->volume;
+
+	a->volume = v;
+	if (a->running)
+		ana_write(a, ZCD_CON2, hp_gain_table[v]);
+	return changed;
+}
+
+static const struct snd_kcontrol_new b8k_volume_control = {
+	.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+	.name = "Speaker Playback Volume",
+	.info = b8k_volume_info,
+	.get = b8k_volume_get,
+	.put = b8k_volume_put,
+};
+
+static int b8k_audio_probe(struct platform_device *pdev)
+{
+	struct b8k_audio *a;
+	struct device *pwrap;
+	int ret;
+
+	a = devm_kzalloc(&pdev->dev, sizeof(*a), GFP_KERNEL);
+	if (!a)
+		return -ENOMEM;
+	a->dev = &pdev->dev;
+	/* Full analog gain; PipeWire/PulseAudio scales in software. */
+	a->volume = ARRAY_SIZE(hp_gain_table) - 1;
+	spin_lock_init(&a->lock);
+	hrtimer_setup(&a->timer, b8k_timer, CLOCK_MONOTONIC, HRTIMER_MODE_REL);
+
+	a->afe = devm_ioremap(&pdev->dev, AFE_PHYS, AFE_SIZE);
+	if (!a->afe)
+		return -ENOMEM;
+	a->infra = devm_ioremap(&pdev->dev, INFRACFG_PHYS, INFRACFG_SIZE);
+	if (!a->infra)
+		return -ENOMEM;
+	pwrap = bus_find_device_by_name(&platform_bus_type, NULL, "1000f000.pwrap");
+	if (!pwrap)
+		return dev_err_probe(&pdev->dev, -EPROBE_DEFER,
+				     "cannot find pwrap device\n");
+	a->pmic = dev_get_regmap(pwrap, NULL);
+	put_device(pwrap);
+	if (!a->pmic)
+		return dev_err_probe(&pdev->dev, -EPROBE_DEFER,
+				     "cannot get pwrap regmap\n");
+	a->speaker_enable = devm_gpiod_get(&pdev->dev, "speaker-enable",
+					  GPIOD_OUT_LOW);
+	if (IS_ERR(a->speaker_enable))
+		return dev_err_probe(&pdev->dev, PTR_ERR(a->speaker_enable),
+				     "cannot request speaker enable GPIO\n");
+
+	ret = snd_card_new(&pdev->dev, -1, "B8000", THIS_MODULE, 0, &a->card);
+	if (ret)
+		return ret;
+	strscpy(a->card->driver, "mt6589-audio", sizeof(a->card->driver));
+	strscpy(a->card->shortname, "Lenovo B8000-H", sizeof(a->card->shortname));
+	strscpy(a->card->longname, "MT6589 AFE + MT6320 + SN2145B",
+		sizeof(a->card->longname));
+	ret = snd_pcm_new(a->card, "MT6589 DL1", 0, 1, 0, &a->pcm);
+	if (ret)
+		goto err_card;
+	a->pcm->private_data = a;
+	strscpy(a->pcm->name, "MT6589 DL1", sizeof(a->pcm->name));
+	snd_pcm_set_ops(a->pcm, SNDRV_PCM_STREAM_PLAYBACK, &b8k_pcm_ops);
+	snd_pcm_set_managed_buffer_all(a->pcm, SNDRV_DMA_TYPE_DEV,
+				       &pdev->dev, BUFFER_BYTES, BUFFER_BYTES);
+	ret = snd_ctl_add(a->card, snd_ctl_new1(&b8k_volume_control, a));
+	if (ret)
+		goto err_card;
+	ret = snd_card_register(a->card);
+	if (ret)
+		goto err_card;
+	platform_set_drvdata(pdev, a);
+	dev_info(&pdev->dev, "ALSA playback card registered; amplifier remains off\n");
+	return 0;
+
+err_card:
+	snd_card_free(a->card);
+	return ret;
+}
+
+static void b8k_audio_remove(struct platform_device *pdev)
+{
+	struct b8k_audio *a = platform_get_drvdata(pdev);
+
+	hrtimer_cancel(&a->timer);
+	if (a->running)
+		b8k_hw_stop(a);
+	snd_card_free(a->card);
+}
+
+static struct platform_driver b8k_audio_driver = {
+	.probe = b8k_audio_probe,
+	.remove = b8k_audio_remove,
+	.driver = { .name = DRV_NAME },
+};
+
+static int __init b8k_audio_init(void)
+{
+	int ret;
+
+	gpiod_add_lookup_table(&b8k_gpio_table);
+	ret = platform_driver_register(&b8k_audio_driver);
+	if (ret) {
+		gpiod_remove_lookup_table(&b8k_gpio_table);
+		return ret;
+	}
+	b8k_pdev = platform_device_register_simple(DRV_NAME, -1, NULL, 0);
+	if (IS_ERR(b8k_pdev)) {
+		ret = PTR_ERR(b8k_pdev);
+		platform_driver_unregister(&b8k_audio_driver);
+		gpiod_remove_lookup_table(&b8k_gpio_table);
+		return ret;
+	}
+	return 0;
+}
+
+static void __exit b8k_audio_exit(void)
+{
+	platform_device_unregister(b8k_pdev);
+	platform_driver_unregister(&b8k_audio_driver);
+	gpiod_remove_lookup_table(&b8k_gpio_table);
+}
+
+module_init(b8k_audio_init);
+module_exit(b8k_audio_exit);
+
+MODULE_DESCRIPTION("Lenovo B8000-H MT6589/MT6320 minimal ALSA playback");
+MODULE_AUTHOR("kz-creator");
+MODULE_LICENSE("GPL");
