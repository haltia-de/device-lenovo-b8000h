+VOID
+p2pSetMode (
+    IN BOOLEAN fgIsAPMOde
+    ) 
+{
+    if (fgIsAPMOde) {
+        mode = RUNNING_AP_MODE;
+        ifname = AP_MODE_INF_NAME;
+    }
+    else {
+        mode = RUNNING_P2P_MODE;
+        ifname = P2P_MODE_INF_NAME;
+    }
+
+    return;
+} /* p2pSetMode */
