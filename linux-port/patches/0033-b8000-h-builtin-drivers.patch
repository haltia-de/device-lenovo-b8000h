+wlanGetTargetBssDescByNetwork (
+    IN P_ADAPTER_T prAdapter,
+    IN ENUM_NETWORK_TYPE_INDEX_T eNetTypeIndex
+    )
+{
+    ASSERT(prAdapter);
+    ASSERT(eNetTypeIndex <= NETWORK_TYPE_INDEX_NUM);
