+#if CFG_SUPPORT_WPS
+BOOLEAN wextSrchDesiredWPSIE(const UINT_8 *ie, INT_32 len, UINT_8 id,
+			     PUINT_8 *desired)
+{
+	while (len >= 2) {
+		INT_32 ie_len = ie[1] + 2;
+
+		if (ie_len > len)
+			break;
+		if (ie[0] == id && (id != 0xdd ||
+		    (ie[1] >= 4 && !memcmp(ie + 2, "\x00\x50\xf2\x04", 4)))) {
+			*desired = (PUINT_8)ie;
+			return TRUE;
+		}
+		ie += ie_len;
+		len -= ie_len;
+	}
+	return FALSE;
+}
+#endif
