+#if CFG_PRINT_RTP_PROFILE
+/*
+    in:
+        data   RTP packet pointer
+        size   RTP size    
+    return 
+        0:audio 1: video, -1:none
+*/
+UINT8 checkRtpAV(PUINT_8 data, UINT_32 size)
+{
+    PUINT_8 buf = data+12;
+    while (buf+188 <= data+size) {
+        int pid = ((buf[1] << 8 ) & 0x1F00) | (buf[2] & 0xFF);
+        if (pid == 0 || pid == 0x100 || pid == 0x1000) {
+            buf += 188;
+        } 
+        else if (pid == 0x1100){
+            return 0;
+        }
+        else if (pid == 0x1011){
+            return 1;
+        }
+    }
+    return -1;
+}
