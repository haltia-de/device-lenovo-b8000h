+#if LINUX_VERSION_CODE >= KERNEL_VERSION(3, 2, 0)
+    .ndo_set_rx_mode = wlanSetMulticastList,
+#else
+	.ndo_set_multicast_list	= wlanSetMulticastList,
+#endif
+	.ndo_get_stats		= wlanGetStats,
+	.ndo_start_xmit		= wlanHardStartXmit,
