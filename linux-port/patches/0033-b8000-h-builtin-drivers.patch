+*
+* \param[in]
+*           prGlueInfo
+*
+* \return
+*/
+/*----------------------------------------------------------------------------*/
+BOOLEAN
+kalP2PMaxClients (
+    IN P_GLUE_INFO_T    prGlueInfo,
+    IN UINT_32 u4NumClient
+    )
+{
+    ASSERT(prGlueInfo);
+    ASSERT(prGlueInfo->prP2PInfo);
+
+    if(prGlueInfo->prP2PInfo->ucMaxClients) {
+        if((UINT_8)u4NumClient > prGlueInfo->prP2PInfo->ucMaxClients)
+            return TRUE;
+        else
+            return FALSE;
+    }
+
+    return FALSE;
+}
