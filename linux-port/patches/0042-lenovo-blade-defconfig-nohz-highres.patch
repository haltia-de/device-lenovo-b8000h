--- a/arch/arm/configs/lenovo-blade_defconfig
+++ b/arch/arm/configs/lenovo-blade_defconfig
@@ -273,2 +273,6 @@
 CONFIG_INPUT_FF_MEMLESS=y
 CONFIG_INPUT_REGULATOR_HAPTIC=y
+# The MT6589 timer assist (upstream 7.1) keeps the arch timer counter
# 64-bit, so each CPU has its own tick: no periodic tick on
+# idle CPUs, and timers finer than the 1 ms tick.
+CONFIG_NO_HZ_IDLE=y
+CONFIG_HIGH_RES_TIMERS=y
