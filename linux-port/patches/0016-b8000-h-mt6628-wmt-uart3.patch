diff --git a/arch/arm/boot/dts/mediatek/mt6589-lenovo-b8000-h.dts b/arch/arm/boot/dts/mediatek/mt6589-lenovo-b8000-h.dts
--- a/arch/arm/boot/dts/mediatek/mt6589-lenovo-b8000-h.dts
+++ b/arch/arm/boot/dts/mediatek/mt6589-lenovo-b8000-h.dts
@@ -197,40 +197,55 @@
 &gpu {
 	power-domains = <&spm MT6589_POWER_DOMAIN_MFG>;
 };
 
 /*
  * MT6628 Wi-Fi/BT/GPS/FM combo (vendor lenovo89_tb_x10_jb2 DCT/board.c):
- * Wi-Fi on SDIO MSDC3, PMU_EN = GPIO14, RST = GPIO225, WIFI EINT9 = GPIO128.
- * Vendor order: PMU_EN high, wait, RST high, wait. PMU_EN is modelled as the
- * SDIO slot supply, RST as the pwrseq reset. Never use vemc (eMMC rails) here.
+ * WMT/STP uses UART3; WMT owns PMU_EN and RST and enables the Wi-Fi function
+ * before asking MSDC3 to rescan. Never give these GPIOs to an MMC regulator or
+ * pwrseq: MMC power-off would reset the whole combo chip after WMT setup.
  */
-/ {
-	mt6628_pmu_en: regulator-mt6628-pmu {
-		compatible = "regulator-fixed";
-		regulator-name = "mt6628-pmu-en";
-		regulator-min-microvolt = <3300000>;
-		regulator-max-microvolt = <3300000>;
-		gpio = <&pio 14 GPIO_ACTIVE_HIGH>;
-		enable-active-high;
-		startup-delay-us = <100000>;
+&pio {
+	mt6628_uart3_pins: mt6628-uart3-pins {
+		pins-rx {
+			pinmux = <MT6589_GPIO219__FUNC_URXD3>;
+			input-enable;
+			bias-pull-up;
+		};
+
+		pins-tx {
+			pinmux = <MT6589_GPIO220__FUNC_UTXD3>;
+		};
 	};
+};
 
-	mt6628_pwrseq: pwrseq-mt6628 {
-		compatible = "mmc-pwrseq-simple";
-		reset-gpios = <&pio 225 GPIO_ACTIVE_LOW>;
-		post-power-on-delay-ms = <100>;
-		power-off-delay-us = <10000>;
+&uart3 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&mt6628_uart3_pins>;
+
+	mt6628 {
+		compatible = "mediatek,mt6628-wmt";
+		pmu-en-gpios = <&pio 14 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&pio 225 GPIO_ACTIVE_HIGH>;
+		interrupt-parent = <&pio>;
+		interrupts = <8 IRQ_TYPE_LEVEL_LOW>;
+		mediatek,mmc-host = <&mmc3>;
+		mediatek,operational-speed = <2000000>;
+		mediatek,rtc-stable-ms = <100>;
+		mediatek,off-stable-ms = <10>;
+		mediatek,reset-stable-ms = <30>;
+		mediatek,on-stable-ms = <100>;
 	};
 };
 
 &mmc3 {
 	status = "okay";
 	/delete-property/ vqmmc-supply;
 	/delete-property/ sd-uhs-sdr104;
 	/delete-property/ sd-uhs-sdr50;
 	/delete-property/ sd-uhs-ddr50;
-	vmmc-supply = <&mt6628_pmu_en>;
-	mmc-pwrseq = <&mt6628_pwrseq>;
+	/delete-property/ vmmc-supply;
+	/delete-property/ mmc-pwrseq;
 	max-frequency = <25000000>;
 	keep-power-in-suspend;
 };
