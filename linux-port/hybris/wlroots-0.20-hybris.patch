+static bool hybris_texture_write(struct wlr_gles2_texture *texture,
+		const void *data, size_t stride, const pixman_region32_t *damage) {
+	struct wlr_egl *egl = texture->renderer->egl;
+	int width = texture->wlr_texture.width;
+	int height = texture->wlr_texture.height;
+
+	pixman_box32_t full = { 0, 0, width, height };
+	const pixman_box32_t *rects = &full;
+	int rects_len = 1;
+	if (damage != NULL) {
+		rects = pixman_region32_rectangles(damage, &rects_len);
+	}
+	if (rects_len == 0) {
+		return true;
+	}
+	const pixman_box32_t *ext = damage != NULL ?
+		pixman_region32_extents(damage) : &full;
