+	void *vaddr;
+	if (!egl->hybris_nb.lock(texture->hybris_nb, HYBRIS_USAGE_SW_WRITE_OFTEN,
+			ext->x1, ext->y1, ext->x2 - ext->x1, ext->y2 - ext->y1, &vaddr)) {
+		wlr_log(WLR_ERROR, "eglHybrisLockNativeBuffer failed");
+		return false;
+	}
+	for (int i = 0; i < rects_len; i++) {
+		const pixman_box32_t *r = &rects[i];
+		size_t row = (size_t)(r->x2 - r->x1) * 4;
+		for (int y = r->y1; y < r->y2; y++) {
+			memcpy((char *)vaddr + y * texture->hybris_stride + r->x1 * 4,
+				(const char *)data + y * stride + r->x1 * 4, row);
+		}
+	}
+	egl->hybris_nb.unlock(texture->hybris_nb);
+	return true;
