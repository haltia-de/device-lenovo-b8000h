+/**
+ * Allocator for the libhybris EGL (Android EGL/GLES through libhybris):
+ * buffers are Android gralloc buffers from EGL_HYBRIS_native_buffer. The
+ * EGL renders into them through EGL_NATIVE_BUFFER_ANDROID images; KMS
+ * scans them out through the DMA-BUF fd of the gralloc handle.
+ */
+struct wlr_allocator *wlr_hybris_allocator_create(void);
+
+/**
+ * Get the Android native buffer (ANativeWindowBuffer) behind a buffer
+ * allocated by the hybris allocator. Returns false for other buffers.
+ */
+bool wlr_hybris_buffer_get_native(struct wlr_buffer *buffer,
+	EGLClientBuffer *native);
+
+#endif
