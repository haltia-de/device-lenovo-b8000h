 #include "render/pixel_format.h"
@@ -108,6 +109,23 @@ GLuint gles2_buffer_get_fbo(struct wlr_gles2_buffer *buffer) {
 	glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
 		GL_RENDERBUFFER, buffer->rbo);
 	GLenum fb_status = glCheckFramebufferStatus(GL_FRAMEBUFFER);
+
+	// Some drivers only render into EGLImages bound as textures
+	if (fb_status != GL_FRAMEBUFFER_COMPLETE &&
+			buffer->renderer->procs.glEGLImageTargetTexture2DOES != NULL) {
+		if (!buffer->tex) {
+			glGenTextures(1, &buffer->tex);
