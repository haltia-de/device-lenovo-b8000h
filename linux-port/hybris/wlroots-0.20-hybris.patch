diff --git a/render/allocator/hybris.c b/render/allocator/hybris.c
new file mode 100644
index 0000000..9d7c5dc
--- /dev/null
+++ b/render/allocator/hybris.c
@@ -0,0 +1,234 @@
+#include <assert.h>
+#include <drm_fourcc.h>
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <wlr/interfaces/wlr_buffer.h>
+#include <wlr/render/allocator.h>
+#include <wlr/render/drm_format_set.h>
+#include <wlr/util/log.h>
+#include "render/allocator/hybris.h"
+#include "render/drm_format_set.h"
+
+// EGL_HYBRIS_native_buffer, see libhybris hybris_nativebufferext.h
+typedef EGLBoolean (EGLAPIENTRYP PFNEGLHYBRISCREATENATIVEBUFFERPROC)(
+	EGLint width, EGLint height, EGLint usage, EGLint format,
+	EGLint *stride, EGLClientBuffer *buffer);
+typedef EGLBoolean (EGLAPIENTRYP PFNEGLHYBRISRELEASENATIVEBUFFERPROC)(
+	EGLClientBuffer buffer);
+// Both return void in libhybris
+typedef void (EGLAPIENTRYP PFNEGLHYBRISGETNATIVEBUFFERINFOPROC)(
+	EGLClientBuffer buffer, int *num_ints, int *num_fds);
+typedef void (EGLAPIENTRYP PFNEGLHYBRISSERIALIZENATIVEBUFFERPROC)(
+	EGLClientBuffer buffer, int *ints, int *fds);
+
+// Android HAL values (system/graphics.h, hardware/gralloc.h)
+#define HAL_PIXEL_FORMAT_BGRA_8888 5
+#define GRALLOC_USAGE_HW_TEXTURE 0x00000100
+#define GRALLOC_USAGE_HW_RENDER 0x00000200
+#define GRALLOC_USAGE_HW_COMPOSER 0x00000800
+
+#define HYBRIS_MAX_FDS 8
+#define HYBRIS_MAX_INTS 256
+
+struct wlr_hybris_buffer {
+	struct wlr_buffer base;
+	EGLClientBuffer native;
+	PFNEGLHYBRISRELEASENATIVEBUFFERPROC release;
+	struct wlr_dmabuf_attributes dmabuf;
+};
+
+struct wlr_hybris_allocator {
+	struct wlr_allocator base;
+	PFNEGLHYBRISCREATENATIVEBUFFERPROC create;
+	PFNEGLHYBRISRELEASENATIVEBUFFERPROC release;
+	PFNEGLHYBRISGETNATIVEBUFFERINFOPROC get_info;
+	PFNEGLHYBRISSERIALIZENATIVEBUFFERPROC serialize;
+};
+
+static const struct wlr_buffer_impl buffer_impl;
+
+static struct wlr_hybris_buffer *get_hybris_buffer_from_buffer(
+		struct wlr_buffer *wlr_buffer) {
+	assert(wlr_buffer->impl == &buffer_impl);
+	struct wlr_hybris_buffer *buffer = wl_container_of(wlr_buffer, buffer, base);
+	return buffer;
+}
+
+bool wlr_hybris_buffer_get_native(struct wlr_buffer *wlr_buffer,
+		EGLClientBuffer *native) {
+	if (wlr_buffer->impl != &buffer_impl) {
+		return false;
+	}
+	struct wlr_hybris_buffer *buffer = get_hybris_buffer_from_buffer(wlr_buffer);
+	*native = buffer->native;
+	return true;
+}
+
+static void buffer_destroy(struct wlr_buffer *wlr_buffer) {
+	struct wlr_hybris_buffer *buffer = get_hybris_buffer_from_buffer(wlr_buffer);
+	// The fds belong to the gralloc handle: released with it
+	buffer->release(buffer->native);
+	free(buffer);
+}
+
+static bool buffer_get_dmabuf(struct wlr_buffer *wlr_buffer,
+		struct wlr_dmabuf_attributes *attribs) {
+	struct wlr_hybris_buffer *buffer = get_hybris_buffer_from_buffer(wlr_buffer);
+	*attribs = buffer->dmabuf;
+	return true;
+}
+
+static const struct wlr_buffer_impl buffer_impl = {
+	.destroy = buffer_destroy,
+	.get_dmabuf = buffer_get_dmabuf,
+};
+
+static const struct wlr_allocator_interface allocator_impl;
+
+static struct wlr_hybris_allocator *get_hybris_alloc_from_alloc(
+		struct wlr_allocator *wlr_alloc) {
+	assert(wlr_alloc->impl == &allocator_impl);
+	struct wlr_hybris_allocator *alloc = wl_container_of(wlr_alloc, alloc, base);
+	return alloc;
+}
+
+static bool fd_is_dmabuf(int fd) {
+	char path[64], target[64];
+	snprintf(path, sizeof(path), "/proc/self/fd/%d", fd);
+	ssize_t n = readlink(path, target, sizeof(target) - 1);
+	if (n < 0) {
+		return false;
+	}
+	target[n] = '\0';
+	return strstr(target, "dmabuf") != NULL;
+}
+
+static struct wlr_buffer *allocator_create_buffer(
+		struct wlr_allocator *wlr_alloc, int width, int height,
+		const struct wlr_drm_format *format) {
+	struct wlr_hybris_allocator *alloc = get_hybris_alloc_from_alloc(wlr_alloc);
+
+	// BGRA_8888 is ARGB8888 in DRM terms; XRGB8888 scans out the same
+	// memory with alpha ignored
+	if (format->format != DRM_FORMAT_ARGB8888 &&
+			format->format != DRM_FORMAT_XRGB8888) {
+		wlr_log(WLR_ERROR, "hybris allocator: unsupported format 0x%08"PRIX32,
+			format->format);
+		return NULL;
+	}
+
+	// Plain ADDFB2 (implicit modifier) is what the display is known to take
+	uint64_t modifier;
+	if (wlr_drm_format_has(format, DRM_FORMAT_MOD_INVALID)) {
+		modifier = DRM_FORMAT_MOD_INVALID;
+	} else if (wlr_drm_format_has(format, DRM_FORMAT_MOD_LINEAR)) {
+		modifier = DRM_FORMAT_MOD_LINEAR;
+	} else {
+		wlr_log(WLR_ERROR, "hybris allocator: no linear or implicit modifier");
+		return NULL;
+	}
+
+	struct wlr_hybris_buffer *buffer = calloc(1, sizeof(*buffer));
+	if (buffer == NULL) {
+		return NULL;
+	}
+	buffer->release = alloc->release;
+
+	const EGLint usage = GRALLOC_USAGE_HW_TEXTURE | GRALLOC_USAGE_HW_RENDER |
+		GRALLOC_USAGE_HW_COMPOSER;
+	EGLint stride = 0;
+	if (!alloc->create(width, height, usage, HAL_PIXEL_FORMAT_BGRA_8888,
+			&stride, &buffer->native)) {
+		wlr_log(WLR_ERROR, "eglHybrisCreateNativeBuffer %dx%d failed",
+			width, height);
+		free(buffer);
+		return NULL;
+	}
+
+	int num_ints = 0, num_fds = 0;
+	alloc->get_info(buffer->native, &num_ints, &num_fds);
+	if (num_fds < 1 || num_fds > HYBRIS_MAX_FDS ||
+			num_ints < 0 || num_ints > HYBRIS_MAX_INTS) {
+		wlr_log(WLR_ERROR, "Unexpected gralloc handle (%d fds, %d ints)",
+			num_fds, num_ints);
+		goto error_native;
+	}
+	int fds[HYBRIS_MAX_FDS];
+	int ints[HYBRIS_MAX_INTS];
+	alloc->serialize(buffer->native, ints, fds);
+
+	// The IMG handle carries the ION (DMA-BUF) fd among its fds
+	int fd = -1;
+	for (int i = 0; i < num_fds; i++) {
+		if (fd_is_dmabuf(fds[i])) {
+			fd = fds[i];
+			break;
+		}
+	}
+	if (fd < 0) {
+		wlr_log(WLR_ERROR, "gralloc handle has no DMA-BUF fd");
+		goto error_native;
+	}
+
+	buffer->dmabuf = (struct wlr_dmabuf_attributes){
+		.width = width,
+		.height = height,
+		.format = format->format,
+		.modifier = modifier,
+		.n_planes = 1,
+		.offset[0] = 0,
+		.stride[0] = stride * 4,
+		.fd[0] = fd,
+	};
+
+	wlr_buffer_init(&buffer->base, &buffer_impl, width, height);
+
+	wlr_log(WLR_DEBUG, "Allocated %dx%d gralloc buffer (stride %d px, "
+		"DMA-BUF fd %d)", width, height, (int)stride, fd);
+	return &buffer->base;
+
+error_native:
+	alloc->release(buffer->native);
+	free(buffer);
+	return NULL;
+}
+
+static void allocator_destroy(struct wlr_allocator *wlr_alloc) {
+	free(get_hybris_alloc_from_alloc(wlr_alloc));
+}
+
+static const struct wlr_allocator_interface allocator_impl = {
+	.destroy = allocator_destroy,
+	.create_buffer = allocator_create_buffer,
+};
+
+struct wlr_allocator *wlr_hybris_allocator_create(void) {
+	struct wlr_hybris_allocator *alloc = calloc(1, sizeof(*alloc));
+	if (alloc == NULL) {
+		return NULL;
+	}
+
+	alloc->create = (PFNEGLHYBRISCREATENATIVEBUFFERPROC)
+		eglGetProcAddress("eglHybrisCreateNativeBuffer");
+	alloc->release = (PFNEGLHYBRISRELEASENATIVEBUFFERPROC)
+		eglGetProcAddress("eglHybrisReleaseNativeBuffer");
+	alloc->get_info = (PFNEGLHYBRISGETNATIVEBUFFERINFOPROC)
+		eglGetProcAddress("eglHybrisGetNativeBufferInfo");
+	alloc->serialize = (PFNEGLHYBRISSERIALIZENATIVEBUFFERPROC)
+		eglGetProcAddress("eglHybrisSerializeNativeBuffer");
+	if (!alloc->create || !alloc->release || !alloc->get_info ||
+			!alloc->serialize) {
+		wlr_log(WLR_ERROR, "EGL_HYBRIS_native_buffer entry points missing");
+		free(alloc);
+		return NULL;
+	}
+
+	wlr_allocator_init(&alloc->base, &allocator_impl, WLR_BUFFER_CAP_DMABUF);
+	wlr_log(WLR_DEBUG, "Created hybris (gralloc) allocator");
+	return &alloc->base;
+}
diff --git a/render/egl.c b/render/egl.c
index 8673aca..7a05a1c 100644
--- a/render/egl.c
+++ b/render/egl.c
@@ -555,10 +555,128 @@ static int open_render_node(int drm_fd) {
 	return render_fd;
 }
 
+/*
+ * libhybris: the stock Android EGL 1.4 has no client extensions (so no
+ * platform displays) and no DMA-BUF import, but offers Android native
+ * buffers.  Use the default display with a real config, and advertise
+ * render formats for the gralloc buffers of the hybris allocator.
+ */
+static struct wlr_egl *egl_create_hybris(void) {
+	if (eglQueryString(EGL_NO_DISPLAY, EGL_EXTENSIONS) != NULL) {
+		return NULL;
+	}
+	if (eglBindAPI(EGL_OPENGL_ES_API) == EGL_FALSE) {
+		return NULL;
+	}
+	EGLDisplay display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+	if (display == EGL_NO_DISPLAY) {
+		return NULL;
+	}
+	EGLint major, minor;
+	if (eglInitialize(display, &major, &minor) == EGL_FALSE) {
+		return NULL;
+	}
+	if (eglGetProcAddress("eglHybrisCreateNativeBuffer") == NULL) {
+		wlr_log(WLR_DEBUG, "No EGL client extensions and no "
+			"EGL_HYBRIS_native_buffer: not libhybris");
+		return NULL;
+	}
+
+	const char *exts = eglQueryString(display, EGL_EXTENSIONS);
+	if (exts == NULL || !check_egl_ext(exts, "EGL_KHR_image_base") ||
+			!check_egl_ext(exts, "EGL_ANDROID_image_native_buffer")) {
+		wlr_log(WLR_ERROR, "libhybris EGL lacks EGL_KHR_image_base or "
+			"EGL_ANDROID_image_native_buffer");
+		return NULL;
+	}
+
+	struct wlr_egl *egl = calloc(1, sizeof(*egl));
+	if (egl == NULL) {
+		wlr_log_errno(WLR_ERROR, "Allocation failed");
+		return NULL;
+	}
+	egl->hybris = true;
+	egl->display = display;
+	egl->exts.KHR_image_base = true;
+	load_egl_proc(&egl->procs.eglCreateImageKHR, "eglCreateImageKHR");
+	load_egl_proc(&egl->procs.eglDestroyImageKHR, "eglDestroyImageKHR");
+	egl->exts.IMG_context_priority =
+		check_egl_ext(exts, "EGL_IMG_context_priority");
+	load_egl_proc(&egl->hybris_nb.create, "eglHybrisCreateNativeBuffer");
+	load_egl_proc(&egl->hybris_nb.lock, "eglHybrisLockNativeBuffer");
+	load_egl_proc(&egl->hybris_nb.unlock, "eglHybrisUnlockNativeBuffer");
+	load_egl_proc(&egl->hybris_nb.release, "eglHybrisReleaseNativeBuffer");
+
+	static const EGLint config_attribs[] = {
+		EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
+		EGL_RED_SIZE, 8,
+		EGL_GREEN_SIZE, 8,
+		EGL_BLUE_SIZE, 8,
+		EGL_ALPHA_SIZE, 8,
+		EGL_NONE,
+	};
+	EGLConfig config;
+	EGLint n = 0;
+	if (!eglChooseConfig(display, config_attribs, &config, 1, &n) || n < 1) {
+		wlr_log(WLR_ERROR, "No RGBA8888 GLES2 EGL config");
+		goto error;
+	}
+
+	size_t atti = 0;
+	EGLint attribs[5];
+	attribs[atti++] = EGL_CONTEXT_CLIENT_VERSION;
+	attribs[atti++] = 2;
+	if (egl->exts.IMG_context_priority) {
+		attribs[atti++] = EGL_CONTEXT_PRIORITY_LEVEL_IMG;
+		attribs[atti++] = EGL_CONTEXT_PRIORITY_HIGH_IMG;
+	}
+	attribs[atti++] = EGL_NONE;
+	assert(atti <= sizeof(attribs) / sizeof(attribs[0]));
+
+	egl->context = eglCreateContext(display, config, EGL_NO_CONTEXT, attribs);
+	if (egl->context == EGL_NO_CONTEXT) {
+		wlr_log(WLR_ERROR, "Failed to create EGL context");
+		goto error;
+	}
+
+	// Surfaceless contexts work (GL_OES_surfaceless_context) although
+	// EGL_KHR_surfaceless_context is not announced
+	if (!eglMakeCurrent(display, EGL_NO_SURFACE, EGL_NO_SURFACE,
+			egl->context)) {
+		wlr_log(WLR_ERROR, "Surfaceless eglMakeCurrent failed");
+		eglDestroyContext(display, egl->context);
+		goto error;
+	}
+	eglMakeCurrent(display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+
+	static const uint32_t formats[] = { DRM_FORMAT_XRGB8888, DRM_FORMAT_ARGB8888 };
+	for (size_t i = 0; i < sizeof(formats) / sizeof(formats[0]); i++) {
+		wlr_drm_format_set_add(&egl->dmabuf_render_formats, formats[i],
+			DRM_FORMAT_MOD_INVALID);
+		wlr_drm_format_set_add(&egl->dmabuf_render_formats, formats[i],
+			DRM_FORMAT_MOD_LINEAR);
+	}
+
+	wlr_log(WLR_INFO, "Using libhybris EGL %d.%d (Android gralloc buffers)",
+		(int)major, (int)minor);
+	wlr_log(WLR_INFO, "Supported EGL display extensions: %s", exts);
+	wlr_log(WLR_INFO, "EGL vendor: %s", eglQueryString(display, EGL_VENDOR));
+	return egl;
+
+error:
+	free(egl);
+	return NULL;
+}
+
