+/*
+ * libinput cancels a touch (a palm: MT_TOOL_PALM) instead of lifting it.
+ * Forget the point like a lift, so its id can go down again, and tell the
+ * client the sequence is cancelled rather than ended: wl_touch.cancel, which
+ * the protocol applies to all of that client's touch points.
+ */
+void
+phoc_cursor_handle_touch_cancel (PhocCursor                    *self,
+                                 struct wlr_touch_cancel_event *event)
+{
+  struct wlr_touch_point *point = wlr_seat_touch_get_point (self->seat->seat, event->touch_id);
+  PhocTouchPoint *touch_point;
+  PhocCursorPrivate *priv = phoc_cursor_get_instance_private (self);
+  struct wlr_surface *surface = point ? point->surface : NULL;
+
+  g_assert (PHOC_IS_CURSOR (self));
+
+  touch_point = phoc_cursor_get_touch_point (self, event->touch_id);
+  if (!touch_point)
+    return;
+
+  handle_gestures_for_event_at (self, touch_point->lx, touch_point->ly,
+                                PHOC_EVENT_TOUCH_CANCEL, event, sizeof (*event));
+  phoc_cursor_remove_touch_point (self, event->touch_id);
+
+  if (self->seat->touch_id == event->touch_id)
+    self->seat->touch_id = -1;
+
+  if (!surface)
+    return;
+
+  if (priv->mode != PHOC_CURSOR_PASSTHROUGH) {
+    if (priv->view_state.view)
+      phoc_cursor_submit_pending_view_state_change (self);
+
+    priv->mode = PHOC_CURSOR_PASSTHROUGH;
+    phoc_cursor_update_focus (self);
+  }
+
+  send_touch_cancel (self->seat, surface);
+}
+
